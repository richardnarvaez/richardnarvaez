---
// Visor de imagen a pantalla completa. La miniatura pulsada "vuela" hasta
// el centro (el script mide su rectángulo y anima desde ahí) mientras el
// fondo se desenfoca y oscurece solo con filtro, nunca con opacidad. Cierra
// con el botón, con Escape o pulsando fuera, volviendo a la miniatura.
---

<div class="lightbox" data-lightbox role="dialog" aria-modal="true" aria-label="Image" hidden>
  <div class="lightbox__scrim" data-lightbox-close></div>
  <figure class="lightbox__figure">
    <img class="lightbox__img" data-lightbox-img alt="" decoding="async" />
    <figcaption class="lightbox__caption" data-lightbox-caption>
      <span class="lightbox__name" data-lightbox-name></span>
      <span class="lightbox__desc" data-lightbox-desc></span>
    </figcaption>
  </figure>
  <button type="button" class="lightbox__close" data-lightbox-close aria-label="Close">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
  </button>
</div>

<style>
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 70;
  }

  .lightbox__scrim {
    position: absolute;
    inset: 0;
    backdrop-filter: blur(0px) brightness(1);
    -webkit-backdrop-filter: blur(0px) brightness(1);
    transition:
      backdrop-filter 460ms cubic-bezier(0.2, 0.8, 0.2, 1),
      -webkit-backdrop-filter 460ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .lightbox.is-open .lightbox__scrim {
    backdrop-filter: blur(18px) brightness(0.45);
    -webkit-backdrop-filter: blur(18px) brightness(0.45);
  }

  .lightbox__figure {
    margin: 0;
    pointer-events: none;
  }

  /* El script fija left/top/width/height (px) y los anima entre origen y destino. */
  .lightbox__img {
    position: fixed;
    display: block;
    object-fit: cover;
    border-radius: 0.85rem;
    box-shadow: 0 40px 90px -30px rgba(0, 0, 0, 0.9);
    transition:
      left 460ms cubic-bezier(0.2, 0.8, 0.2, 1),
      top 460ms cubic-bezier(0.2, 0.8, 0.2, 1),
      width 460ms cubic-bezier(0.2, 0.8, 0.2, 1),
      height 460ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-radius 460ms ease;
  }

  .lightbox__caption {
    position: fixed;
    left: 50%;
    bottom: max(1.5rem, env(safe-area-inset-bottom));
    display: grid;
    gap: 0.2rem;
    width: min(90vw, 40rem);
    translate: -50% 0;
    text-align: center;
    color: #fff;
    /* Aparece cuando la imagen ha llegado; se esconde antes de que vuelva. */
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .lightbox.is-settled .lightbox__caption {
    opacity: 1;
  }

  .lightbox__name {
    font-size: 0.95rem;
    font-weight: 700;
  }

  .lightbox__desc {
    font-size: 0.82rem;
    line-height: 1.5;
    color: rgb(var(--text-rgb) / 0.7);
  }

  .lightbox__desc:empty {
    display: none;
  }

  .lightbox__close {
    position: fixed;
    top: max(1rem, env(safe-area-inset-top));
    right: 1rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    cursor: pointer;
    opacity: 0;
    transition:
      opacity 220ms ease,
      background 160ms ease;
  }

  .lightbox.is-settled .lightbox__close {
    opacity: 1;
  }

  .lightbox__close:hover {
    background: rgba(255, 255, 255, 0.16);
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox__scrim,
    .lightbox__img,
    .lightbox__caption,
    .lightbox__close {
      transition: none;
    }
  }
</style>
