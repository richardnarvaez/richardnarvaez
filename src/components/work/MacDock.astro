---
// Dock de macOS dentro de la pantalla. Barra de cristal con filo de luz,
// iconos con la forma y el sombreado de los de macOS (cada uno con su color
// de fondo), etiqueta flotante y punto de "abierto" bajo el activo.
// Magnificación al acercar el puntero: el script mide la distancia de cada
// icono al cursor y escribe --s; los vecinos crecen menos, como en el Dock.
// Semántica de pestañas: role=tablist / tab con aria-selected.
export interface DockItem {
  id: string
  label: string
  /** Marcado interno del SVG (viewBox 0 0 24 24, trazo currentColor). */
  icon: string
  /** Fondo del icono: dos tonos (arriba, abajo), como los iconos del sistema. */
  tint: [string, string]
}

interface Props {
  items: DockItem[]
  active: string
}

const { items, active } = Astro.props
---

<div class="dock" role="tablist" aria-label="Work" data-dock>
  {
    items.map((item) => (
      <button
        type="button"
        class="dock__item"
        role="tab"
        id={`dock-${item.id}`}
        aria-selected={item.id === active}
        aria-controls={`layer-${item.id}`}
        tabindex={item.id === active ? 0 : -1}
        data-dock-item={item.id}
        style={`--tint-a: ${item.tint[0]}; --tint-b: ${item.tint[1]};`}
      >
        <span class="dock__label">{item.label}</span>
        <span class="dock__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={item.icon} />
        </span>
        <span class="dock__dot" aria-hidden="true"></span>
      </button>
    ))
  }
</div>

<style>
  .dock {
    --dock-size: 3.4rem;
    --dock-pad: 0.5rem;

    position: absolute;
    bottom: 0.7rem;
    left: 50%;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    gap: 0.5rem;
    /* Alto fijo: la barra no crece con la magnificación; los iconos la desbordan hacia arriba. */
    height: calc(var(--dock-size) + var(--dock-pad) * 2);
    padding: var(--dock-pad) 0.65rem;
    translate: -50% 0;
    border-radius: 1.25rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(22px) saturate(1.4);
    -webkit-backdrop-filter: blur(22px) saturate(1.4);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      inset 0 -1px 0 rgba(0, 0, 0, 0.25),
      0 18px 40px -16px rgba(0, 0, 0, 0.75);
  }

  /*
    --s la escribe el script (1 en reposo, hasta ~1.6 bajo el puntero). El
    icono crece EN EL LAYOUT (ancho y alto), no con transform: así aparta a
    los vecinos y la barra se ensancha, como en macOS, en vez de montarse
    unos sobre otros. Anclados abajo, crecen hacia arriba. Mientras el
    puntero se mueve la respuesta es casi inmediata; al salir vuelve suave.
  */
  .dock__item {
    --s: 1;

    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: calc(var(--dock-size) * var(--s));
    height: calc(var(--dock-size) * var(--s));
    padding: 0;
    border: 0;
    background: none;
    color: #fff;
    cursor: pointer;
    transition:
      width 80ms linear,
      height 80ms linear;
  }

  .dock.is-idle .dock__item {
    transition:
      width 320ms cubic-bezier(0.2, 0.8, 0.2, 1),
      height 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /*
    Icono al estilo del sistema: squircle con dos tonos (claro arriba, denso
    abajo), brillo en el borde superior y canto oscuro abajo. El glifo va en
    blanco con una sombra mínima, como los símbolos de los iconos de Apple.
  */
  .dock__icon {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 24%;
    background: linear-gradient(180deg, var(--tint-a) 0%, var(--tint-b) 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.45),
      inset 0 -1px 0 rgba(0, 0, 0, 0.25),
      0 1px 2px rgba(0, 0, 0, 0.35),
      0 8px 14px -8px rgba(0, 0, 0, 0.7);
  }

  .dock__icon svg {
    width: 54%;
    height: 54%;
    filter: drop-shadow(0 1px 1px rgba(0, 0, 0, 0.3));
  }

  /* Punto de "app abierta" bajo el icono activo. */
  .dock__dot {
    position: absolute;
    bottom: -0.38rem;
    left: 50%;
    width: 4px;
    height: 4px;
    translate: -50% 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.8);
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .dock__item[aria-selected="true"] .dock__dot {
    opacity: 1;
  }

  /* Etiqueta flotante sobre el icono, como el tooltip del Dock. */
  .dock__label {
    position: absolute;
    bottom: calc(100% + 0.8rem);
    left: 50%;
    padding: 0.3rem 0.65rem;
    translate: -50% 4px;
    border-radius: 0.45rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(20, 19, 34, 0.94);
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
    color: #fff;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 140ms ease,
      translate 140ms ease;
  }

  .dock__item:hover .dock__label,
  .dock__item:focus-visible .dock__label {
    opacity: 1;
    translate: -50% 0;
  }

  @media (max-width: 640px) {
    .dock {
      --dock-size: 3rem;
      bottom: 0.6rem;
    }
  }
</style>
