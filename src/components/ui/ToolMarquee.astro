---
// Infinite marquee of tool logos, replacing the tilted PNG in the bento.
// 
// Seamless loop without JavaScript: each row repeats its set REPEATS times and
// the animation travels exactly one set. The gap rides as each tile's margin,
// not the row's `gap`, so the set width includes it and the wrap lines up.
// Only `translate` animates, so it composites on the GPU.
import { toolLogoById } from "../../data/tool-logos"

interface Props {
  /* Rows: lists of `toolLogos` ids. */
  rows: string[][]
  class?: string
}

const { rows, class: className } = Astro.props
const REPEATS = 3
// Different durations per row so they do not read as one piece.
const DURATIONS_S = [46, 58, 52, 64]

const resolved = rows.map((ids) =>
  ids.map((id) => {
    const logo = toolLogoById.get(id)
    if (!logo) throw new Error(`ToolMarquee: logo desconocido "${id}"`)
    return logo
  }),
)
---

<div class:list={["tool-marquee", className]} aria-hidden="true">
  {
    resolved.map((logos, r) => (
      <div
        class:list={["tool-marquee__row", { "tool-marquee__row--reverse": r % 2 === 1 }]}
        style={`--duration: ${DURATIONS_S[r % DURATIONS_S.length]}s`}
      >
        {Array.from({ length: REPEATS }, () =>
          logos.map((logo) => (
            <span class:list={["tool-marquee__tile", { "tool-marquee__tile--wide": logo.wide }]}>
              <svg viewBox={logo.viewBox} fill={logo.fill} set:html={logo.body} />
            </span>
          )),
        )}
      </div>
    ))
  }
</div>

<style>
  /*
    The box takes the width it is given; rows overflow and are clipped by the
    container, which is what makes the loop read as endless.
  */
  .tool-marquee {
    --tile: 3.75rem;
    --gap: 0.5rem;

    display: grid;
    justify-items: start;
    gap: var(--gap);
    width: 100%;
    pointer-events: none;
    user-select: none;
  }

  .tool-marquee__row {
    display: flex;
    width: max-content;
    animation: toolMarquee var(--duration) linear infinite;
    will-change: translate;
  }

  .tool-marquee__row--reverse {
    animation-direction: reverse;
  }

  /* One set = 1/3 of the row width (see REPEATS). */
  @keyframes toolMarquee {
    to {
      translate: calc(-100% / 3) 0;
    }
  }

  /* Flat white tile, corners at 22% like an app icon. */
  .tool-marquee__tile {
    display: grid;
    place-items: center;
    flex: none;
    width: var(--tile);
    height: var(--tile);
    margin-inline-end: var(--gap);
    border-radius: 22%;
    background: #fff;
  }

  /* Wide wordmarks (AWS, Stripe, Next.js) take two slots. */
  .tool-marquee__tile--wide {
    width: calc(var(--tile) * 2 + var(--gap));
    border-radius: 0.85rem;
  }

  .tool-marquee__tile svg {
    width: 52%;
    height: 52%;
  }

  .tool-marquee__tile--wide svg {
    width: 64%;
    height: 46%;
  }

  @media (prefers-reduced-motion: reduce) {
    .tool-marquee__row {
      animation: none;
    }
  }
</style>
