---
import BlueprintSection from "./layout/BlueprintSection.astro"
import { socialLinks } from "../site.config"
import GradualBlur from "./ui/GradualBlur.astro"
import ToolMarquee from "./ui/ToolMarquee.astro"

const resumeHref =
  "https://drive.google.com/file/d/1-6_qXA48htfG1dpM7xDRBNnVHXKSGRi_mw3PMFu7Szc/view"
const figmaHref = "https://www.figma.com/community/file/1270173776891030529"
const humaHref = "https://huma.darkpixl.com"

// Cinta de herramientas del bento: tres filas, en sentidos alternos.
// Herramientas que destacan hoy, más que lenguajes. Los wordmarks (aws,
// stripe, next) ocupan dos huecos.
const toolRows = [
  ["claude-code", "stripe", "docker", "vercel", "next", "railway"],
  ["aws", "codex", "figma", "github", "cursor", "strapi"],
  ["openai", "framer", "figma", "claude-code", "stripe", "docker"],
  ["next", "github", "codex", "vercel", "aws", "cursor"],
  ["strapi", "claude-code", "openai", "docker", "figma", "railway"],
]

---

{/* El nombre y el rol viven en la sección de perfil, justo encima. */}
<BlueprintSection id="shortcuts" class="section-bento" label="02 — shortcuts" ariaLabel="Shortcuts">
  <div class="py-14">

  <div class="grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
    <!-- Resume -->
    <a
      target="_blank"
      rel="noreferrer noopener"
      href={resumeHref}
      class="bento-card group relative h-96 w-full cursor-pointer overflow-hidden rounded-3xl border-4 border-white"
    >
      <img
        alt=""
        class="absolute inset-0 size-full object-cover transition-transform duration-500 ease-out group-hover:scale-110 group-hover:blur-sm"
        src="/images/bento/resume.webp"
        width="700"
        height="900"
      />
      <div
        class="absolute inset-0 z-10 flex size-full flex-col justify-between bg-black/20 transition-all group-hover:bg-black/30"
      >
        <div class="w-fit rounded-br-xl bg-white px-4 py-2">
          <p class="text-xs font-bold text-gray-500">NOW AVAILABLE</p>
        </div>
        <div class="relative">
          <GradualBlur
            position="bottom"
            height="10rem"
            strength={1}
            divCount={5}
            curve="bezier"
            exponential
          />
          <div class="relative z-10 bg-gradient-to-t from-black/50 to-transparent p-4 font-bold">
            <p class="text-md text-gray-300">RESUME</p>
            <p class="text-3xl">View or Download Resume in PDF</p>
            <p class="text-sm">It's free, so take a look.</p>
          </div>
        </div>
      </div>
    </a>

    <!-- Huma Legends -->
    <div
      class="bento-card group relative z-10 flex w-full flex-col items-center justify-center overflow-hidden rounded-3xl bg-(--surface-2) p-4 font-bold lg:col-span-2"
    >
      <img
        alt="Background Huma Legends"
        src="/images/blog/huma/huma-bg.jpg"
        width="960"
        height="540"
        class="absolute top-0 size-full scale-105 object-cover transition-all duration-500 ease-out group-hover:scale-110 group-hover:blur-sm"
      />
      {/* Como en la tarjeta del CV: la foto nítida arriba, desenfoque progresivo bajo el contenido y desenfoque total al hacer hover. */}
      <GradualBlur position="bottom" height="78%" strength={1} divCount={5} curve="bezier" exponential />
      
      <div
        class="z-10 m-4 mx-auto flex size-24 items-center justify-center overflow-hidden rounded-3xl border-4 border-white bg-white"
      >
        <img
          alt="Huma Legends App Icon"
          src="/images/blog/huma/huma-app-icon.jpg"
          width="100"
          height="100"
          class="size-full object-cover"
        />
      </div>
      <div class="z-10 flex-col items-center justify-center text-center">
        <p class="text-3xl text-white">HUMA LEGENDS</p>
        <p class="mb-4 mt-2">DOWNLOAD IN APPSTORE</p>
        <div class="flex flex-wrap justify-center gap-4">
          <a
            href={humaHref}
            target="_blank"
            rel="noreferrer noopener"
            class="rounded-3xl border border-white/50 bg-black/20 px-4 py-2 text-sm transition-colors hover:bg-black/40"
          >
            Visit Website
          </a>
          <span
            class="cursor-default rounded-3xl border border-white/30 bg-black/10 px-4 py-2 text-sm text-white/50"
          >
            Story — coming soon
          </span>
        </div>
      </div>
      <div class="absolute inset-0 bg-black/30 transition-colors duration-500 group-hover:bg-black/40"></div>
    </div>

    <!-- Tools & Frameworks (no internal /#stack route: non-linking) -->
    <div
      class="bento-card group relative h-[500px] w-full overflow-hidden rounded-3xl bg-(--surface-2) md:h-full lg:h-auto"
    >
      <div
        class="absolute z-20 w-full p-4 font-bold"
        style="background: linear-gradient(180deg, var(--surface-2), transparent);"
      >
        <p class="text-md text-white/75">TECHNOLOGIES</p>
        <p class="text-3xl">Tools and Frameworks</p>
      </div>
      {/*
        Cinta infinita de logos en vez del PNG: inclinada como estaba la
        imagen, recortada por la tarjeta, y escala un poco al hacer hover.
      */}
      <div
        class="tools-belt absolute -rotate-12 transition-transform duration-500 ease-out group-hover:scale-110"
        aria-hidden="true"
      >
        <ToolMarquee rows={toolRows} />
      </div>
    </div>

    <!-- Column: Photography + Gallery -->
    <div
      class="grid w-full grid-cols-1 gap-4 lg:col-span-2 lg:grid-cols-2"
    >
      <!-- auto + 1fr: la fila del botón mide lo que el botón; Gallery absorbe el resto. -->
      <div class="grid grid-cols-1 grid-rows-[auto_1fr] gap-4">
        {/* Tarjeta estática: lo de "About me" ya vive en la sección de perfil. */}
        <div
          class="bento-card group relative flex h-40 w-full items-center justify-center overflow-hidden rounded-3xl bg-(--surface-2) text-center"
        >
          {/* Cámara a líneas, grande, algo girada y recortada, en el mismo gris tenue que el logo de Figma de al lado. */}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="absolute -right-6 -top-14 size-64 -rotate-12 text-black/10 transition-colors duration-500 group-hover:text-black/20"
            aria-hidden="true"
          >
            <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"></path>
            <circle cx="12" cy="13" r="3"></circle>
          </svg>
          <p class="relative text-2xl font-bold">Photography</p>
        </div>

        <span
          class="bento-card relative flex h-full cursor-default items-center overflow-hidden rounded-3xl border-2 border-dashed border-(--line-tint) p-6 font-bold text-white/70"
        >
          <span>
            <span class="block text-3xl">Visit Gallery</span>
            <span class="text-md mt-3 block font-normal text-gray-200/50">
              Coming soon
            </span>
          </span>
        </span>
      </div>

      <!-- 1fr + auto: Figma absorbe el resto; la fila de iconos mide lo que los iconos. -->
      <div class="grid grid-cols-1 grid-rows-[1fr_auto] gap-4">
        <!-- Figma template -->
        <a
          target="_blank"
          rel="noreferrer noopener"
          href={figmaHref}
          class="bento-card group relative flex items-center overflow-hidden rounded-3xl border-2 border-dashed border-[#FF512F]/50 p-6 font-bold"
        >
          <div>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 26 26"
              fill="none"
              class="absolute right-8 top-0 size-96 text-gray-200/5 transition-all duration-[420ms] ease-[cubic-bezier(0.15,0.7,0.3,1)] group-hover:top-8 group-hover:size-20 group-hover:text-gray-200/20"
            >
              <title>Figma</title>
              <path
                d="M13 1.625H9.20829C7.11421 1.625 5.41663 3.32259 5.41663 5.41667C5.41663 7.51075 7.11421 9.20833 9.20829 9.20833M13 1.625V9.20833M13 1.625H16.7916C18.8857 1.625 20.5833 3.32259 20.5833 5.41667C20.5833 7.51075 18.8857 9.20833 16.7916 9.20833M13 9.20833H9.20829M13 9.20833V16.7917M13 9.20833H16.7916M9.20829 9.20833C7.11421 9.20833 5.41663 10.9059 5.41663 13C5.41663 15.0941 7.11421 16.7917 9.20829 16.7917M13 16.7917H9.20829M13 16.7917V20.5833C13 22.6774 11.3024 24.375 9.20829 24.375C7.11421 24.375 5.41663 22.6774 5.41663 20.5833C5.41663 18.4893 7.11421 16.7917 9.20829 16.7917M16.7916 9.20833C18.8857 9.20833 20.5833 10.9059 20.5833 13C20.5833 15.0941 18.8857 16.7917 16.7916 16.7917C14.6975 16.7917 13 15.0941 13 13C13 10.9059 14.6975 9.20833 16.7916 9.20833Z"
                stroke="currentColor"
                stroke-width="1.6"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
            <p class="mb-2 flex items-center gap-2 text-xl text-[#FF512F]">
              FIGMA
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M15 3h6v6"></path>
                <path d="M10 14 21 3"></path>
                <path
                  d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"
                ></path>
              </svg>
            </p>
            <p class="mt-[100px] text-3xl">Visit this Portfolio Template</p>
            <div class="text-md mt-3 font-normal text-gray-200/50">
              +1k Users | +40 Likes
            </div>
          </div>
        </a>

        <!-- GitHub + LinkedIn -->
        <div class="flex w-full items-center gap-4 rounded-3xl shadow-lg">
          <a
            title="Github"
            href={socialLinks.github}
            target="_blank"
            rel="noreferrer noopener"
            class="flex w-full justify-center rounded-2xl bg-white p-6 text-black/50 transition-colors hover:text-black/70"
          >
            <svg
              width="32px"
              height="32px"
              version="1.1"
              viewBox="0 0 512 512"
              fill="currentColor"
            >
              <title>Github</title>
              <path
                clip-rule="evenodd"
                fill-rule="evenodd"
                d="M296.133,354.174c49.885-5.891,102.942-24.029,102.942-110.192   c0-24.49-8.624-44.448-22.67-59.869c2.266-5.89,9.515-28.114-2.734-58.947c0,0-18.139-5.898-60.759,22.669   c-18.139-4.983-38.09-8.163-56.682-8.163c-19.053,0-39.011,3.18-56.697,8.163c-43.082-28.567-61.22-22.669-61.22-22.669   c-12.241,30.833-4.983,53.057-2.718,58.947c-14.061,15.42-22.677,35.379-22.677,59.869c0,86.163,53.057,104.301,102.942,110.192   c-6.344,5.452-12.241,15.873-14.507,30.387c-12.702,5.438-45.808,15.873-65.758-18.592c0,0-11.795-21.31-34.012-22.669   c0,0-22.224-0.453-1.813,13.592c0,0,14.96,6.812,24.943,32.653c0,0,13.6,43.089,76.179,29.48v38.543   c0,5.906-4.53,12.702-15.865,10.89C96.139,438.977,32.2,354.626,32.2,255.77c0-123.807,100.216-224.022,224.03-224.022   c123.347,0,224.023,100.216,223.57,224.022c0,98.856-63.946,182.754-152.828,212.688c-11.342,2.266-15.873-4.53-15.873-10.89   V395.45C311.1,374.577,304.288,360.985,296.133,354.174L296.133,354.174z M512,256.23C512,114.73,397.263,0,256.23,0   C114.73,0,0,114.73,0,256.23C0,397.263,114.73,512,256.23,512C397.263,512,512,397.263,512,256.23L512,256.23z"
              ></path>
            </svg>
          </a>
          <a
            title="Linkedin"
            href={socialLinks.linkedin}
            target="_blank"
            rel="noreferrer noopener"
            class="flex w-full justify-center rounded-2xl bg-white p-6 text-black/50 transition-colors hover:text-black/70"
          >
            <svg
              width="32"
              height="32"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <title>LinkedIn</title>
              <path
                d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
  </div>
</BlueprintSection>

<style>
  /*
    Cinta de herramientas: nace bajo el título y desborda la tarjeta por los
    tres lados restantes; el `overflow-hidden` de la tarjeta la recorta.
  */
  .tools-belt {
    top: 30%;
    left: -30%;
    width: 160%;
    /* Pivote en el centro de la tarjeta: la caja mide 160% y está centrada. */
    transform-origin: center;
  }
</style>
