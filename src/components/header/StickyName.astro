---
// Sticky Apple-style bar: when the big profile name scrolls out of view,
// "richard.vinueza" appears here over a gradient of the page colour, and the
// chevron opens a floating menu of circles orbiting the handle.
import { siteName, socialLinks } from "../../site.config"
import { toolLogoById } from "../../data/tool-logos"
import GradualBlur from "../ui/GradualBlur.astro"

const handle = siteName.toLowerCase().trim().split(/\s+/).join(".")

type Size = "s" | "l" | "xl"
type Item = {
  id: string
  label: string
  href: string
  external?: boolean
  icon: string
  viewBox?: string
  /** Filled logo (Simple Icons) instead of a stroke. */
  filled?: boolean
  size: Size
}
const logo = (id: string) => toolLogoById.get(id)!
const brand = (id: string) => ({ icon: logo(id).body, viewBox: logo(id).viewBox, filled: true })

// Diameters in design px, matching --d in the CSS.
const DIAMETER: Record<Size, number> = { s: 40, l: 52, xl: 60 }
const GAP = 16
// The handle is a wide pill, so the rings are ellipses (KX stretches x).
const KX = 1.5

// Two rows: sections on an arc, socials on a straight line below.
const sections: Item[] = [
  { id: "shortcuts", label: "Shortcuts", href: "#shortcuts", size: "l", icon: `<rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="5" rx="2"/><rect x="13" y="10" width="8" height="11" rx="2"/><rect x="3" y="13" width="8" height="8" rx="2"/>` },
  { id: "work", label: "Work", href: "#work", size: "xl", icon: `<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M2 20h20"/>` },
  { id: "profile", label: "Profile", href: "#profile", size: "xl", icon: `<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>` },
  { id: "code", label: "Open Source", href: "#open-source", size: "l", icon: `<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>` },
]
const socials: Item[] = [
  { id: "github", label: "GitHub", href: socialLinks.github, external: true, size: "s", ...brand("github") },
  { id: "linkedin", label: "LinkedIn", href: socialLinks.linkedin, external: true, size: "s", ...brand("linkedin") },
  { id: "instagram", label: "Instagram", href: socialLinks.instagram, external: true, size: "s", ...brand("instagram") },
]

type Placed = Item & { x: number; y: number }
const point = (deg: number, r: number) => {
  const a = (deg * Math.PI) / 180
  return { x: Math.cos(a) * r * KX, y: Math.sin(a) * r }
}

// Walks the ellipse in fine steps so each circle's edge keeps GAP from the
// next, then recentres on 90° over several passes.
const ring = (list: Item[], r: number): Placed[] => {
  const walk = (start: number) => {
    const angles = [start]
    for (let i = 1; i < list.length; i++) {
      const need = DIAMETER[list[i - 1].size] / 2 + DIAMETER[list[i].size] / 2 + GAP
      const prev = point(angles[i - 1], r)
      let deg = angles[i - 1]
      while (deg > -180) {
        deg -= 0.05
        const cur = point(deg, r)
        if (Math.hypot(cur.x - prev.x, cur.y - prev.y) >= need) break
      }
      angles.push(deg)
    }
    return angles
  }
  let start = 180
  let angles = walk(start)
  for (let pass = 0; pass < 4; pass++) {
    const span = angles[0] - angles[angles.length - 1]
    start = 90 + span / 2
    angles = walk(start)
  }
  return list.map((item, i) => {
    const p = point(angles[i], r)
    return { ...item, x: Math.round(p.x), y: Math.round(p.y) }
  })
}

// Second row: socials on a straight line, each centred in the gap above.
const row = (list: Item[], above: Placed[]): Placed[] => {
  // Extra air: on narrow screens positions shrink with --u but the circles do
  // not, and the row used to stick together.
  const y = Math.max(...above.map((p) => p.y + DIAMETER[p.size] / 2)) + GAP + 6 + DIAMETER[list[0].size] / 2
  return list.map((item, i) => {
    const a = above[i]
    const b = above[i + 1]
    const x = (a.x + DIAMETER[a.size] / 2 + (b.x - DIAMETER[b.size] / 2)) / 2
    const n = NUDGE[i] ?? { x: 0, y: 0 }
    return { ...item, x: Math.round(x + n.x), y: Math.round(y + n.y) }
  })
}
// By eye: the ends of the second row lift and open, following the first.
const NUDGE = [
  { x: -24, y: -26 },
  { x: 0, y: 0 },
  { x: 24, y: -26 },
]

const inner = ring(sections, 86)
const items: Placed[] = [...inner, ...row(socials, inner)]

// Concentric rings and gradient arcs, turning slowly behind the cluster.
const rings = [285, 395, 505, 625]
const arcs = [
  { d: "M244.5 730.5C226 660 231.5 630.338 272.353 625.726C313.206 621.113 338.5 624 344 581C349.501 538.001 373 490 383.001 475.501", x1: 308, y1: 553, x2: 255.414, y2: 714.876 },
  { d: "M865.677 312.15C923.684 356.815 937.421 383.742 907.43 412.424C877.44 441.106 855.357 454.303 877.256 491.823C899.155 529.344 909.658 581.859 910.5 599.5", x1: 923.309, y1: 492.016, x2: 866.452, y2: 331.251 },
  { d: "M1069 867.999C1036.5 928.295 1011.43 946.924 980.663 928.294C949.9 909.664 927.324 887.958 894 915.5C860.677 943.041 826.238 970.579 809.501 975.5", x1: 906.513, y1: 960.753, x2: 1053.49, y2: 874.153 },
  { d: "M475.949 142.65C541.625 123.198 572.513 127.85 580.985 162.803C589.457 197.756 585.975 225.279 629 229.5C672.025 233.721 721.712 238.597 737.001 247", x1: 656.279, y1: 192.517, x2: 491.251, y2: 149.317 },
]
---

<div class="sticky-name" data-sticky-name>
  <div class="sticky-name__tint"></div>
  <button type="button" class="sticky-name__toggle" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
    <span class="sticky-name__title">{handle}</span>
    <svg class="sticky-name__chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </button>
</div>

<div class="site-menu" id="site-menu" role="dialog" aria-modal="true" aria-label="Menu" tabindex="-1" data-site-menu hidden>
  {/*
    Background: the page blurs top to bottom. The unblurred band under the bar
    keeps the handle readable.
  */}
  <div class="site-menu__blur">
    <GradualBlur position="top" height="140dvh" strength={1.3} divCount={8} curve="ease-out" exponential zIndex={0} />
  </div>
  <div class="site-menu__scrim" data-menu-close></div>

  {/*
    Everything centres on the bar handle: the rings turn around it and the
    bubbles spread from it.
  */}
  <div class="site-menu__stage">
    <div class="site-menu__orbit" aria-hidden="true">
        <svg class="site-menu__rings" viewBox="0 0 1251 1251" fill="none">
          {rings.map((r, i) => <circle cx="625.5" cy="625.5" r={r} stroke="white" stroke-opacity={0.07 - i * 0.01} />)}
          {
            arcs.map((arc, i) => (
              <>
                <path d={arc.d} stroke={`url(#menu-arc-${i})`} stroke-opacity="0.35" />
                <defs>
                  <linearGradient id={`menu-arc-${i}`} x1={arc.x1} y1={arc.y1} x2={arc.x2} y2={arc.y2} gradientUnits="userSpaceOnUse">
                    <stop stop-color="white" stop-opacity="0" />
                    <stop offset="0.5" stop-color="white" stop-opacity="1" />
                    <stop offset="1" stop-color="white" stop-opacity="0" />
                  </linearGradient>
                </defs>
              </>
            ))
          }
        </svg>
    </div>

    <div class="site-menu__cluster">
      <ul class="site-menu__list">
        {
          items.map((item, i) => (
            <li class="site-menu__slot" style={`--x: ${item.x}; --y: ${item.y}; --i: ${i};`}>
              <a
                class:list={["site-menu__item", `site-menu__item--${item.size}`]}
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noreferrer noopener" : undefined}
                aria-label={item.label}
                data-menu-link
              >
                <svg
                  viewBox={item.viewBox ?? "0 0 24 24"}
                  fill={item.filled ? "currentColor" : "none"}
                  stroke={item.filled ? "none" : "currentColor"}
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={item.icon}
                />
                {
                  item.external && (
                    <span class="site-menu__ext" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M7 17 17 7" />
                        <path d="M8 7h9v9" />
                      </svg>
                    </span>
                  )
                }
                <span class="site-menu__label">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>("[data-sticky-name]")
  const toggle = bar?.querySelector<HTMLButtonElement>("[data-menu-toggle]")
  const menu = document.querySelector<HTMLElement>("[data-site-menu]")

  if (bar && toggle && menu) {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches
    let open = false

    // Blur ramp: Safari rejects calc() inside blur(), so the resolved value is
    // written out instead of animating a variable.
    const BLUR_MS = 520
    const layers = [...menu.querySelectorAll<HTMLElement>(".gradual-blur__layer")].map((el) => {
      const rem = parseFloat(/blur\(([\d.]+)rem\)/.exec(el.style.backdropFilter ?? "")?.[1] ?? "0")
      return { el, rem }
    })
    const paintBlur = (k: number) => {
      for (const { el, rem } of layers) {
        const value = `blur(${(rem * k).toFixed(3)}rem)`
        el.style.backdropFilter = value
        el.style.setProperty("-webkit-backdrop-filter", value)
      }
    }
    let blurFrame = 0
    let blurK = 0
    const rampBlur = (to: number) => {
      cancelAnimationFrame(blurFrame)
      if (reduced) {
        blurK = to
        paintBlur(to)
        return
      }
      const from = blurK
      const start = performance.now()
      const tick = (now: number) => {
        const p = Math.min(1, (now - start) / BLUR_MS)
        const eased = 1 - Math.pow(1 - p, 3)
        blurK = from + (to - from) * eased
        paintBlur(blurK)
        if (p < 1) blurFrame = requestAnimationFrame(tick)
      }
      blurFrame = requestAnimationFrame(tick)
    }
    paintBlur(0)

    /*
      Hiding is deferred so the close animation shows, but it must be
      cancellable: closing and reopening within BLUR_MS used to leave `hidden`
      on an open menu, with scroll locked and nothing visible to click.
    */
    let hideTimer = 0

    const setOpen = (next: boolean) => {
      if (next === open) return
      open = next
      clearTimeout(hideTimer)
      toggle.setAttribute("aria-expanded", String(open))
      bar.classList.toggle("is-open", open)
      if (open) {
        menu.hidden = false
        void menu.offsetHeight
        menu.classList.add("is-open")
        rampBlur(1)
        document.documentElement.style.overflow = "hidden"
        // Focus goes to the dialog, not the first link: no ring or label
        // appears with a mouse, and Tab still enters the first circle.
        menu.focus({ preventScroll: true })
      } else {
        menu.classList.remove("is-open")
        rampBlur(0)
        document.documentElement.style.overflow = ""
        const done = () => (menu.hidden = true)
        if (reduced) done()
        else hideTimer = window.setTimeout(done, BLUR_MS)
        toggle.focus({ preventScroll: true })
      }
    }

    toggle.addEventListener("click", () => setOpen(!open))
    for (const el of menu.querySelectorAll("[data-menu-close]")) el.addEventListener("click", () => setOpen(false))

    // An internal link closes the menu and lets the anchor do the scrolling.
    for (const link of menu.querySelectorAll<HTMLAnchorElement>("[data-menu-link]")) {
      link.addEventListener("click", () => setOpen(false))
    }

    document.addEventListener("keydown", (event) => {
      if (!open) return
      if (event.key === "Escape") {
        event.preventDefault()
        setOpen(false)
        return
      }
      if (event.key === "Tab") {
        const nodes = [...menu.querySelectorAll<HTMLElement>("[data-menu-link]")]
        const first = nodes[0]
        const last = nodes[nodes.length - 1]
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault()
          toggle.focus()
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault()
          toggle.focus()
        } else if ((document.activeElement === toggle || document.activeElement === menu) && !event.shiftKey) {
          event.preventDefault()
          first.focus()
        } else if (document.activeElement === menu && event.shiftKey) {
          event.preventDefault()
          last.focus()
        }
      }
    })
  }
</script>

<style>
  /* ── Bar ─────────────────────────────────────────────────────────────── */
  .sticky-name {
    position: fixed;
    inset: 0 0 auto 0;
    /* Above the menu (39) so the chevron stays reachable to close it. */
    z-index: 41;
    height: 5.5rem;
    pointer-events: none;
    animation: stickyNameIn linear both;
    animation-timeline: --profile-name;
    /*
      Entra con medio paso de retraso respecto a la salida del nombre grande
      (que se apaga entre exit -5.5rem y -0.75rem): así apenas coinciden en
      pantalla y se lee como un relevo, no como dos nombres.
    */
    animation-range: exit -3.25rem exit 0.75rem;
  }

  .sticky-name__tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      var(--page-accent-surface) 0%,
      rgb(var(--surface-rgb) / 0.75) 40%,
      transparent 100%
    );
    transition: opacity 320ms ease;
  }

  /*
    With the menu open the scrim carries the contrast, and bubbles near the
    handle fall inside this band, so it goes.
  */
  .sticky-name.is-open .sticky-name__tint {
    opacity: 0;
  }

  /* The handle only takes events while the bar is lit, see the keyframes. */
  .sticky-name__toggle {
    position: absolute;
    top: 0.65rem;
    left: 50%;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.7rem 0.32rem 0.85rem;
    translate: -50% 0;
    border: 1px solid transparent;
    border-radius: 999px;
    background: none;
    color: #fff;
    cursor: pointer;
    pointer-events: auto;
    transition:
      border-color 180ms ease,
      background 180ms ease;
  }

  .sticky-name__toggle:hover,
  .sticky-name.is-open .sticky-name__toggle {
    border-color: rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.06);
  }

  .sticky-name__title {
    font-family: var(--font-bellota);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  .sticky-name__chevron {
    opacity: 0.7;
    transition:
      rotate 260ms var(--ease-out),
      opacity 180ms ease;
  }

  .sticky-name__toggle:hover .sticky-name__chevron,
  .sticky-name.is-open .sticky-name__chevron {
    opacity: 1;
  }

  .sticky-name.is-open .sticky-name__chevron {
    rotate: 180deg;
  }

  /* `visibility` rides along: with the bar off the button exists for neither pointer nor keyboard. */
  @keyframes stickyNameIn {
    from {
      opacity: 0;
      visibility: hidden;
      translate: 0 -0.6rem;
    }
    to {
      opacity: 1;
      visibility: visible;
      translate: 0 0;
    }
  }

  /* Without scroll-driven animations the bar would stay lit, so hide it. */
  @supports not (animation-timeline: view()) {
    .sticky-name {
      display: none;
    }
  }

  /* ── Floating menu ───────────────────────────────────────────────────── */
  .site-menu {
    position: fixed;
    inset: 0;
    z-index: 39;
    outline: none;
  }

  .site-menu__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    backdrop-filter: brightness(1);
    -webkit-backdrop-filter: brightness(1);
    transition:
      backdrop-filter 480ms cubic-bezier(0.2, 0.8, 0.2, 1),
      -webkit-backdrop-filter 480ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /*
    Filter only, no tint. Plain brightness halved the page's violet and read as
    black, so it dims less and gets its saturation back.
  */
  .site-menu.is-open .site-menu__scrim {
    backdrop-filter: brightness(0.62) saturate(1.35);
    -webkit-backdrop-filter: brightness(0.62) saturate(1.35);
  }

  .site-menu__blur {
    position: absolute;
    inset: 0;
  }

  /* Everything anchors to the centre of the bar button (--anchor). */
  .site-menu__stage {
    --anchor: 1.5rem;

    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  /*
    Cluster: a 0×0 point at the handle's centre. Circles place themselves from
    there with --x/--y; --u scales the whole set on narrow screens.
  */
  .site-menu__cluster {
    --u: 1;
    /* Staggered entrance: the last circle starts at 172ms. */
    --enter-base: 40ms;
    --enter-step: 22ms;

    position: absolute;
    left: 50%;
    top: var(--anchor);
    width: 0;
    height: 0;
    /* Shrinks positions and circles together so the gaps stay in proportion. */
    scale: var(--u);
    pointer-events: auto;
  }

  /* Rings turning slowly around the handle; they enter spinning and growing. */
  .site-menu__orbit {
    position: absolute;
    left: 50%;
    top: var(--anchor);
    width: min(140vw, 68rem);
    aspect-ratio: 1;
    translate: -50% -50%;
    rotate: -45deg;
    scale: 0.6;
    opacity: 0;
    pointer-events: none;
    transition:
      rotate 950ms cubic-bezier(0.22, 0.61, 0.2, 1),
      scale 950ms cubic-bezier(0.22, 0.61, 0.2, 1),
      opacity 500ms ease;
  }

  .site-menu.is-open .site-menu__orbit {
    rotate: 0deg;
    scale: 1;
    opacity: 1;
  }

  .site-menu__rings {
    width: 100%;
    height: 100%;
    animation: menuSpin 90s linear infinite;
  }

  .site-menu__list {
    position: absolute;
    left: 0;
    top: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-menu__slot {
    position: absolute;
    left: 0;
    top: 0;
    translate: calc(var(--x) * 1px) calc(var(--y) * 1px);
    transition:
      translate 620ms cubic-bezier(0.22, 1.2, 0.36, 1)
        calc(var(--enter-base) + var(--i) * var(--enter-step)),
      opacity 220ms ease;
  }

  /* The active circle comes forward and the rest dim a little. */
  .site-menu__slot:hover,
  .site-menu__slot:focus-within {
    z-index: 2;
  }

  .site-menu__list:has(.site-menu__item:hover, .site-menu__item:focus-visible) .site-menu__slot:not(:hover, :focus-within) {
    opacity: 0.5;
  }

  /* Closed: gathered on the name, shrunk. */
  .site-menu:not(.is-open) .site-menu__slot {
    translate: 0 0;
    transition-delay: calc(var(--i) * 15ms);
    transition-duration: 260ms;
    transition-timing-function: cubic-bezier(0.4, 0, 1, 1);
  }

  .site-menu__item {
    --d: 2.5rem;

    position: relative;
    display: grid;
    place-items: center;
    width: var(--d);
    height: var(--d);
    translate: -50% -50%;
    border-radius: 50%;
    background: #fff;
    color: #172033;
    text-decoration: none;
    box-shadow: 0 14px 30px -12px rgba(0, 0, 0, 0.7);
    scale: 1;
    opacity: 1;
    filter: blur(0);
    transition:
      scale 520ms cubic-bezier(0.22, 1.4, 0.36, 1)
        calc(var(--enter-base) + var(--i) * var(--enter-step)),
      opacity 420ms cubic-bezier(0.22, 1, 0.36, 1)
        calc(var(--enter-base) + var(--i) * var(--enter-step)),
      filter 460ms cubic-bezier(0.22, 1, 0.36, 1)
        calc(var(--enter-base) + var(--i) * var(--enter-step)),
      box-shadow 200ms ease;
  }

  /*
    Closed: gathered on the handle, shrunk and blurred. Each circle focuses in
    as it grows, so the entrance resolves rather than popping.
  */
  .site-menu:not(.is-open) .site-menu__item {
    scale: 0.35;
    opacity: 0;
    filter: blur(7px);
    transition-delay: 0ms;
    transition-duration: 240ms;
  }

  .site-menu__item--l {
    --d: 3.25rem;
  }

  /* None goes over 60px. */
  .site-menu__item--xl {
    --d: 3.75rem;
  }

  .site-menu__item svg {
    width: 42%;
    height: 42%;
  }

  .site-menu__item--s svg {
    width: 48%;
    height: 48%;
  }

  .site-menu__item:hover,
  .site-menu__item:focus-visible {
    /* Scales the circle, not the slot, so neighbours stay put. */
    scale: 1.1;
    box-shadow: 0 18px 36px -12px rgba(0, 0, 0, 0.8);
    transition-delay: 0ms;
    transition-duration: 220ms;
  }

  /* External links get a small satellite with the new-tab arrow. */
  .site-menu__ext {
    position: absolute;
    right: -0.2rem;
    top: -0.2rem;
    display: grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    border: 1.5px solid rgba(23, 32, 51, 0.12);
    background: #fff;
    color: #172033;
    box-shadow: 0 3px 8px rgba(0, 0, 0, 0.45);
  }

  .site-menu__ext svg {
    width: 62%;
    height: 62%;
  }

  /* Label above the circle, only on hover or focus. */
  .site-menu__label {
    position: absolute;
    bottom: calc(100% + 0.55rem);
    left: 50%;
    padding: 0.3rem 0.6rem;
    translate: -50% 0.25rem;
    border-radius: 999px;
    background: #fff;
    color: #172033;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 160ms ease,
      translate 160ms var(--ease-out);
  }

  .site-menu__item:hover .site-menu__label,
  .site-menu__item:focus-visible .site-menu__label {
    opacity: 1;
    translate: -50% 0;
  }

  @media (max-width: 560px) {
    .site-menu__cluster {
      --u: 0.86;
    }
  }

