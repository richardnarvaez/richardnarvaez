---
// Barra fija tipo Apple: cuando el nombre grande del perfil sale por arriba,
// aparece aquí en pequeño como "richard.vinueza", sobre un degradado del
// color de la página que se disuelve hacia abajo para que el texto contraste
// con lo que pase por debajo.
//
// Sin JS para aparecer: la barra escucha la posición del <h2> del perfil vía
// una view-timeline con nombre (--profile-name) cuyo alcance abre `body` con
// `timeline-scope` en global.css. Mientras el h2 sale del viewport, el h2
// se encoge y esta barra se enciende: leído en conjunto, el nombre se
// transforma en el handle.
//
// El handle es un botón con chevrón: abre un menú flotante que bloquea el
// scroll, desenfoca la página de arriba abajo (GradualBlur) y muestra el
// nombre en el centro con las secciones y redes orbitando alrededor, en un
// giro lento. Cada círculo contragira para no volcarse; al pasar el puntero
// la órbita se detiene para poder pulsar.
import { siteName, socialLinks } from "../../site.config"
import { toolLogoById } from "../../data/tool-logos"
import GradualBlur from "../ui/GradualBlur.astro"

const handle = siteName.toLowerCase().trim().split(/\s+/).join(".")

type Size = "s" | "l" | "xl"
type Item = {
  id: string
  label: string
  href: string
  external?: boolean
  icon: string
  viewBox?: string
  /** Logo relleno (Simple Icons) en vez de trazo. */
  filled?: boolean
  /** Ángulo desde el centro del handle: 0° a la derecha, 90° hacia abajo. */
  angle: number
  /** Distancia al handle en px de diseño (se escala con --u). */
  r: number
  size: Size
}
const logo = (id: string) => toolLogoById.get(id)!
const brand = (id: string) => ({ icon: logo(id).body, viewBox: logo(id).viewBox, filled: true })

// Todo se mide desde el nombre: cada burbuja tiene un ángulo y una distancia
// al centro del handle, y se reparten por el medio anillo inferior. El
// handle es una píldora ancha, así que el anillo es elíptico (KX) para que
// las de los lados no se le monten. Distancias mezcladas, como el racimo del
// perfil antiguo.
const KX = 1.35
const items: Item[] = [
  { id: "code", label: "Open Source", href: "#open-source", angle: 78, r: 74, size: "l", icon: `<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>` },
  { id: "github", label: "GitHub", href: socialLinks.github, external: true, angle: 118, r: 84, size: "s", ...brand("github") },
  { id: "shortcuts", label: "Shortcuts", href: "#shortcuts", angle: 140, r: 108, size: "l", icon: `<rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="5" rx="2"/><rect x="13" y="10" width="8" height="11" rx="2"/><rect x="3" y="13" width="8" height="8" rx="2"/>` },
  { id: "profile", label: "Profile", href: "#profile", angle: 45, r: 112, size: "xl", icon: `<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>` },
  { id: "linkedin", label: "LinkedIn", href: socialLinks.linkedin, external: true, angle: 126, r: 160, size: "s", ...brand("linkedin") },
  { id: "work", label: "Work", href: "#work", angle: 90, r: 145, size: "xl", icon: `<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M2 20h20"/>` },
  { id: "instagram", label: "Instagram", href: socialLinks.instagram, external: true, angle: 62, r: 155, size: "s", ...brand("instagram") },
]
const place = (item: Item) => {
  const a = (item.angle * Math.PI) / 180
  return { x: Math.round(Math.cos(a) * item.r * KX), y: Math.round(Math.sin(a) * item.r) }
}

// Anillos concéntricos y arcos con degradado: el gráfico de órbita del hero
// anterior, ahora girando despacio detrás del racimo.
const rings = [285, 395, 505, 625]
const arcs = [
  { d: "M244.5 730.5C226 660 231.5 630.338 272.353 625.726C313.206 621.113 338.5 624 344 581C349.501 538.001 373 490 383.001 475.501", x1: 308, y1: 553, x2: 255.414, y2: 714.876 },
  { d: "M865.677 312.15C923.684 356.815 937.421 383.742 907.43 412.424C877.44 441.106 855.357 454.303 877.256 491.823C899.155 529.344 909.658 581.859 910.5 599.5", x1: 923.309, y1: 492.016, x2: 866.452, y2: 331.251 },
  { d: "M1069 867.999C1036.5 928.295 1011.43 946.924 980.663 928.294C949.9 909.664 927.324 887.958 894 915.5C860.677 943.041 826.238 970.579 809.501 975.5", x1: 906.513, y1: 960.753, x2: 1053.49, y2: 874.153 },
  { d: "M475.949 142.65C541.625 123.198 572.513 127.85 580.985 162.803C589.457 197.756 585.975 225.279 629 229.5C672.025 233.721 721.712 238.597 737.001 247", x1: 656.279, y1: 192.517, x2: 491.251, y2: 149.317 },
]
---

<div class="sticky-name" data-sticky-name>
  <div class="sticky-name__tint"></div>
  <button type="button" class="sticky-name__toggle" aria-expanded="false" aria-controls="site-menu" data-menu-toggle>
    <span class="sticky-name__title">{handle}</span>
    <svg class="sticky-name__chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </button>
</div>

<div class="site-menu" id="site-menu" role="dialog" aria-modal="true" aria-label="Menu" data-site-menu hidden>
  {/* Fondo: la página se desenfoca de arriba abajo. La franja sin desenfoque
      del GradualBlur queda fuera de pantalla (alto 140dvh), así todo el
      viewport recibe algo y la barra recibe lo máximo. Al abrir, el script
      sube el radio de cada capa de 0 a su valor (y lo baja al cerrar): solo
      filtro, nunca opacidad, y sin bordes que se muevan. (Nada de clip-path
      ni mask en el contenedor: formarían un backdrop root y las capas
      dejarían de ver la página.) */}
  <div class="site-menu__blur">
    <GradualBlur position="top" height="140dvh" strength={1.3} divCount={8} curve="ease-out" exponential zIndex={0} />
  </div>
  <div class="site-menu__scrim" data-menu-close></div>

  {/* El centro de todo es el handle de la barra: los anillos giran en torno
      a él y las burbujas se reparten a su alrededor, medidas desde él. */}
  <div class="site-menu__stage">
    <div class="site-menu__orbit" aria-hidden="true">
        <svg class="site-menu__rings" viewBox="0 0 1251 1251" fill="none">
          {rings.map((r, i) => <circle cx="625.5" cy="625.5" r={r} stroke="white" stroke-opacity={0.07 - i * 0.01} />)}
          {
            arcs.map((arc, i) => (
              <>
                <path d={arc.d} stroke={`url(#menu-arc-${i})`} stroke-opacity="0.35" />
                <defs>
                  <linearGradient id={`menu-arc-${i}`} x1={arc.x1} y1={arc.y1} x2={arc.x2} y2={arc.y2} gradientUnits="userSpaceOnUse">
                    <stop stop-color="white" stop-opacity="0" />
                    <stop offset="0.5" stop-color="white" stop-opacity="1" />
                    <stop offset="1" stop-color="white" stop-opacity="0" />
                  </linearGradient>
                </defs>
              </>
            ))
          }
        </svg>
    </div>

    <div class="site-menu__cluster">
      <ul class="site-menu__list">
        {
          items.map((item, i) => (
            <li class="site-menu__slot" style={`--x: ${place(item).x}; --y: ${place(item).y}; --i: ${i};`}>
              <a
                class:list={["site-menu__item", `site-menu__item--${item.size}`]}
                href={item.href}
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noreferrer noopener" : undefined}
                aria-label={item.label}
                data-menu-link
              >
                <svg
                  viewBox={item.viewBox ?? "0 0 24 24"}
                  fill={item.filled ? "currentColor" : "none"}
                  stroke={item.filled ? "none" : "currentColor"}
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={item.icon}
                />
                <span class="site-menu__label">{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</div>

<script>
  const bar = document.querySelector<HTMLElement>("[data-sticky-name]")
  const toggle = bar?.querySelector<HTMLButtonElement>("[data-menu-toggle]")
  const menu = document.querySelector<HTMLElement>("[data-site-menu]")

  if (bar && toggle && menu) {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches
    let open = false

    // Rampa del desenfoque: cada capa del GradualBlur guarda su radio final y
    // el script lo escala de 0 a 1. Safari no acepta calc() dentro de blur(),
    // por eso se escribe el valor ya resuelto en vez de animar una variable.
    const BLUR_MS = 520
    const layers = [...menu.querySelectorAll<HTMLElement>(".gradual-blur__layer")].map((el) => {
      const rem = parseFloat(/blur\(([\d.]+)rem\)/.exec(el.style.backdropFilter ?? "")?.[1] ?? "0")
      return { el, rem }
    })
    const paintBlur = (k: number) => {
      for (const { el, rem } of layers) {
        const value = `blur(${(rem * k).toFixed(3)}rem)`
        el.style.backdropFilter = value
        el.style.setProperty("-webkit-backdrop-filter", value)
      }
    }
    let blurFrame = 0
    let blurK = 0
    const rampBlur = (to: number) => {
      cancelAnimationFrame(blurFrame)
      if (reduced) {
        blurK = to
        paintBlur(to)
        return
      }
      const from = blurK
      const start = performance.now()
      const tick = (now: number) => {
        const p = Math.min(1, (now - start) / BLUR_MS)
        const eased = 1 - Math.pow(1 - p, 3)
        blurK = from + (to - from) * eased
        paintBlur(blurK)
        if (p < 1) blurFrame = requestAnimationFrame(tick)
      }
      blurFrame = requestAnimationFrame(tick)
    }
    paintBlur(0)

    const setOpen = (next: boolean) => {
      if (next === open) return
      open = next
      toggle.setAttribute("aria-expanded", String(open))
      bar.classList.toggle("is-open", open)
      if (open) {
        menu.hidden = false
        void menu.offsetHeight
        menu.classList.add("is-open")
        rampBlur(1)
        document.documentElement.style.overflow = "hidden"
        menu.querySelector<HTMLElement>("[data-menu-link]")?.focus({ preventScroll: true })
      } else {
        menu.classList.remove("is-open")
        rampBlur(0)
        document.documentElement.style.overflow = ""
        const done = () => (menu.hidden = true)
        if (reduced) done()
        else setTimeout(done, BLUR_MS)
        toggle.focus({ preventScroll: true })
      }
    }

    toggle.addEventListener("click", () => setOpen(!open))
    for (const el of menu.querySelectorAll("[data-menu-close]")) el.addEventListener("click", () => setOpen(false))

    // Un enlace interno cierra el menú y deja que el ancla haga el scroll.
    for (const link of menu.querySelectorAll<HTMLAnchorElement>("[data-menu-link]")) {
      link.addEventListener("click", () => setOpen(false))
    }

    document.addEventListener("keydown", (event) => {
      if (!open) return
      if (event.key === "Escape") {
        event.preventDefault()
        setOpen(false)
        return
      }
      if (event.key === "Tab") {
        const nodes = [...menu.querySelectorAll<HTMLElement>("[data-menu-link]")]
        const first = nodes[0]
        const last = nodes[nodes.length - 1]
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault()
          toggle.focus()
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault()
          toggle.focus()
        } else if (document.activeElement === toggle && !event.shiftKey) {
          event.preventDefault()
          first.focus()
        }
      }
    })
  }
</script>

<style>
  /* ── Barra ───────────────────────────────────────────────────────────── */
  .sticky-name {
    position: fixed;
    inset: 0 0 auto 0;
    /* Por encima del menú (que va a 39): el chevrón sigue accesible para cerrarlo. */
    z-index: 41;
    height: 5.5rem;
    pointer-events: none;
    animation: stickyNameIn linear both;
    animation-timeline: --profile-name;
    /*
      Entra con medio paso de retraso respecto a la salida del nombre grande
      (que se apaga entre exit -5.5rem y -0.75rem): así apenas coinciden en
      pantalla y se lee como un relevo, no como dos nombres.
    */
    animation-range: exit -3.25rem exit 0.75rem;
  }

  /* Color de página que se disuelve hacia abajo. */
  .sticky-name__tint {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      var(--page-accent-surface) 0%,
      rgb(var(--surface-rgb) / 0.75) 40%,
      transparent 100%
    );
    transition: opacity 320ms ease;
  }

  /* Con el menú abierto el contraste lo da el scrim, y las burbujas cercanas al handle caen dentro de esta franja: fuera. */
  .sticky-name.is-open .sticky-name__tint {
    opacity: 0;
  }

  /* El handle es un botón: solo recibe eventos cuando la barra está encendida (ver keyframes). */
  .sticky-name__toggle {
    position: absolute;
    top: 0.65rem;
    left: 50%;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.7rem 0.32rem 0.85rem;
    translate: -50% 0;
    border: 1px solid transparent;
    border-radius: 999px;
    background: none;
    color: #fff;
    cursor: pointer;
    pointer-events: auto;
    transition:
      border-color 180ms ease,
      background 180ms ease;
  }

  .sticky-name__toggle:hover,
  .sticky-name.is-open .sticky-name__toggle {
    border-color: rgba(255, 255, 255, 0.14);
    background: rgba(255, 255, 255, 0.06);
  }

  .sticky-name__title {
    font-family: var(--font-bellota);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  .sticky-name__chevron {
    opacity: 0.7;
    transition:
      rotate 260ms var(--ease-out),
      opacity 180ms ease;
  }

  .sticky-name__toggle:hover .sticky-name__chevron,
  .sticky-name.is-open .sticky-name__chevron {
    opacity: 1;
  }

  .sticky-name.is-open .sticky-name__chevron {
    rotate: 180deg;
  }

  /* `visibility` acompaña a la opacidad: con la barra apagada el botón no existe para el puntero ni el teclado. */
  @keyframes stickyNameIn {
    from {
      opacity: 0;
      visibility: hidden;
      translate: 0 -0.6rem;
    }
    to {
      opacity: 1;
      visibility: visible;
      translate: 0 0;
    }
  }

  /* Sin scroll-driven animations la barra quedaría fija encendida: se oculta. */
  @supports not (animation-timeline: view()) {
    .sticky-name {
      display: none;
    }
  }

  /* ── Menú flotante ───────────────────────────────────────────────────── */
  .site-menu {
    position: fixed;
    inset: 0;
    z-index: 39;
  }

  /* Solo filtro, nunca opacidad ni tinte: oscurece lo que hay detrás mientras el GradualBlur lo desenfoca. */
  .site-menu__scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    backdrop-filter: brightness(1);
    -webkit-backdrop-filter: brightness(1);
    transition:
      backdrop-filter 480ms cubic-bezier(0.2, 0.8, 0.2, 1),
      -webkit-backdrop-filter 480ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .site-menu.is-open .site-menu__scrim {
    backdrop-filter: brightness(0.5);
    -webkit-backdrop-filter: brightness(0.5);
  }

  .site-menu__blur {
    position: absolute;
    inset: 0;
  }

  /* Todo se ancla al centro del botón de la barra (--anchor). */
  .site-menu__stage {
    --anchor: 1.5rem;

    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }

  /*
    Racimo: un punto (0×0) en el centro del handle. Los círculos se colocan
    desde ahí con --x/--y en px de diseño multiplicados por --u, que encoge en
    pantallas estrechas. Al abrir salen del handle: parten reunidos en él,
    encogidos, y se abren escalonados.
  */
  .site-menu__cluster {
    --u: 1;

    position: absolute;
    left: 50%;
    top: var(--anchor);
    width: 0;
    height: 0;
    pointer-events: auto;
  }

  /* Anillos girando despacio en torno al handle; entran girando y creciendo como en el hero anterior. */
  .site-menu__orbit {
    position: absolute;
    left: 50%;
    top: var(--anchor);
    width: min(140vw, 68rem);
    aspect-ratio: 1;
    translate: -50% -50%;
    rotate: -45deg;
    scale: 0.6;
    opacity: 0;
    pointer-events: none;
    transition:
      rotate 950ms cubic-bezier(0.22, 0.61, 0.2, 1),
      scale 950ms cubic-bezier(0.22, 0.61, 0.2, 1),
      opacity 500ms ease;
  }

  .site-menu.is-open .site-menu__orbit {
    rotate: 0deg;
    scale: 1;
    opacity: 1;
  }

  .site-menu__rings {
    width: 100%;
    height: 100%;
    animation: menuSpin 90s linear infinite;
  }

  .site-menu__list {
    position: absolute;
    left: 0;
    top: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-menu__slot {
    position: absolute;
    left: 0;
    top: 0;
    translate: calc(var(--x) * var(--u) * 1px) calc(var(--y) * var(--u) * 1px);
    transition: translate 620ms cubic-bezier(0.22, 1.2, 0.36, 1) calc(120ms + var(--i) * 40ms);
  }

  /* Cerrado: todos reunidos en el nombre, encogidos. */
  .site-menu:not(.is-open) .site-menu__slot {
    translate: 0 0;
    transition-delay: calc(var(--i) * 15ms);
    transition-duration: 260ms;
    transition-timing-function: cubic-bezier(0.4, 0, 1, 1);
  }

  .site-menu__item {
    --d: 2.5rem;

    position: relative;
    display: grid;
    place-items: center;
    width: var(--d);
    height: var(--d);
    translate: -50% -50%;
    border-radius: 50%;
    background: #fff;
    color: #172033;
    text-decoration: none;
    box-shadow: 0 14px 30px -12px rgba(0, 0, 0, 0.7);
    scale: 1;
    opacity: 1;
    transition:
      scale 520ms cubic-bezier(0.22, 1.4, 0.36, 1) calc(120ms + var(--i) * 40ms),
      opacity 220ms ease calc(120ms + var(--i) * 40ms),
      box-shadow 200ms ease;
  }

  .site-menu:not(.is-open) .site-menu__item {
    scale: 0.35;
    opacity: 0;
    transition-delay: 0ms;
    transition-duration: 220ms;
  }

  .site-menu__item--l {
    --d: 3.25rem;
  }

  /* Ninguno pasa de 60px. */
  .site-menu__item--xl {
    --d: 3.75rem;
  }

  .site-menu__item svg {
    width: 42%;
    height: 42%;
  }

  .site-menu__item--s svg {
    width: 48%;
    height: 48%;
  }

  .site-menu__item:hover,
  .site-menu__item:focus-visible {
    /* Solo escala el círculo, no el hueco: la vecindad no se mueve. */
    scale: 1.1;
    box-shadow: 0 18px 36px -12px rgba(0, 0, 0, 0.8);
    transition-delay: 0ms;
    transition-duration: 220ms;
  }

  /* Etiqueta bajo el círculo, solo al pasar el puntero o enfocar. */
  .site-menu__label {
    position: absolute;
    top: calc(100% + 0.55rem);
    left: 50%;
    padding: 0.3rem 0.6rem;
    translate: -50% -0.25rem;
    border-radius: 999px;
    background: #fff;
    color: #172033;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 160ms ease,
      translate 160ms var(--ease-out);
  }

  .site-menu__item:hover .site-menu__label,
  .site-menu__item:focus-visible .site-menu__label {
    opacity: 1;
    translate: -50% 0;
  }

  @media (max-width: 560px) {
    .site-menu__cluster {
      --u: 0.86;
    }
  }

  @media (max-width: 400px) {
    .site-menu__cluster {
      --u: 0.74;
    }

    .site-menu__item {
      --d: 2.25rem;
    }

    .site-menu__item--l {
      --d: 2.75rem;
    }

    .site-menu__item--xl {
      --d: 3.25rem;
    }
  }

  @keyframes menuSpin {
    to {
      rotate: 360deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-menu__rings {
      animation: none;
    }

    .site-menu__orbit,
    .site-menu__slot,
    .site-menu__item,
    .site-menu__scrim,
    .site-menu__blur {
      transition: none;
    }
  }
</style>
