---
// Diagrama de flujo/arquitectura a partir de una lista de pasos. Cajas con
// etiqueta y nota, unidas por conectores discontinuos con punta de flecha,
// en el lenguaje de plano del sitio. Horizontal por defecto; en vertical
// para pilas (cliente → backend → servicios) y siempre en móvil.
interface Step {
  label: string
  note?: string
}

interface Props {
  steps: Step[]
  direction?: "horizontal" | "vertical"
  class?: string
}

const { steps, direction = "horizontal", class: className } = Astro.props
---

<figure class:list={["flow", `flow--${direction}`, className]}>
  <ol class="flow__list">
    {
      steps.map((step, i) => (
        <li class="flow__step">
          <div class="flow__node">
            <span class="flow__index font-jetbrains">{String(i + 1).padStart(2, "0")}</span>
            <span class="flow__label">{step.label}</span>
            {step.note && <span class="flow__note">{step.note}</span>}
          </div>
          {i < steps.length - 1 && <span class="flow__link" aria-hidden="true" />}
        </li>
      ))
    }
  </ol>
</figure>

<style>
  .flow {
    margin: 1.75rem 0;
  }

  .flow__list {
    display: flex;
    align-items: stretch;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .flow__step {
    display: flex;
    align-items: center;
    flex: 1 1 0;
    min-width: 0;
  }

  .flow__node {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
    padding: 0.9rem 1rem 1rem;
    border-radius: 0.9rem;
    border: 1px solid var(--line-tint);
    background: var(--surface-2);
  }

  .flow__index {
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    color: rgb(var(--text-rgb) / 0.45);
  }

  .flow__label {
    font-size: 0.95rem;
    font-weight: 700;
    color: #fff;
  }

  .flow__note {
    font-size: 0.8rem;
    line-height: 1.45;
    color: rgb(var(--text-rgb) / 0.62);
  }

  /* Conector: línea discontinua con punta, del mismo violeta que los rieles. */
  .flow__link {
    position: relative;
    flex: none;
    width: 2rem;
    height: 0;
    border-top: 1px dashed var(--line-tint);
  }

  .flow__link::after {
    content: "";
    position: absolute;
    right: -1px;
    top: -4px;
    border: 4px solid transparent;
    border-left: 6px solid rgba(139, 126, 210, 0.7);
    border-right: 0;
  }

  .flow--vertical .flow__list,
  .flow--vertical .flow__step {
    flex-direction: column;
  }

  .flow--vertical .flow__step {
    align-items: stretch;
  }

  .flow--vertical .flow__link {
    width: 0;
    height: 1.6rem;
    margin-inline: auto;
    border-top: 0;
    border-left: 1px dashed var(--line-tint);
  }

  .flow--vertical .flow__link::after {
    right: -4px;
    top: auto;
    bottom: -1px;
    border: 4px solid transparent;
    border-top: 6px solid rgba(139, 126, 210, 0.7);
    border-bottom: 0;
  }

  @media (max-width: 640px) {
    .flow__list,
    .flow__step {
      flex-direction: column;
    }

    .flow__step {
      align-items: stretch;
    }

    .flow__link {
      width: 0;
      height: 1.4rem;
      margin-inline: auto;
      border-top: 0;
      border-left: 1px dashed var(--line-tint);
    }

    .flow__link::after {
      right: -4px;
      top: auto;
      bottom: -1px;
      border: 4px solid transparent;
      border-top: 6px solid rgba(139, 126, 210, 0.7);
      border-bottom: 0;
    }
  }
</style>
