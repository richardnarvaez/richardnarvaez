---
// Image with a caption: screenshots, wireframes or exported diagrams. `frame`
// presents it as a screen instead of full bleed.
interface Props {
  src: string
  alt: string
  caption?: string
  width?: number
  height?: number
  frame?: boolean
  /* App icon: shown small (100px) with the caption beside it. */
  icon?: boolean
}

const { src, alt, caption, width, height, frame = false, icon = false } = Astro.props
---

<figure class:list={["figure", { "figure--frame": frame, "figure--icon": icon }]}>
  <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  {caption && <figcaption class="figure__caption">{caption}</figcaption>}
</figure>

<style>
  .figure {
    margin: 1.75rem 0;
  }

  .figure img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.9rem;
  }

  .figure--frame img {
    padding: 0.5rem;
    border: 1px solid var(--line-tint);
    background: var(--surface-2);
  }

  /* Square icons never exceed 100px, caption on the right. */
  .figure--icon {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .figure--icon img {
    width: 6.25rem;
    height: 6.25rem;
    flex: none;
    border-radius: 24%;
  }

  .figure--icon .figure__caption {
    margin-top: 0;
  }

  .figure__caption {
    margin-top: 0.6rem;
    font-size: 0.78rem;
    line-height: 1.5;
    color: rgb(var(--text-rgb) / 0.5);
  }
</style>
