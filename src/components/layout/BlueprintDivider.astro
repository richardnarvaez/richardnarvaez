---
// Horizontal blueprint divider, rail to rail, with a marker at each end. It goes
// inside a .bp-inner: negative margins cancel the gutter so the line touches the
// rails. The markers are the global ones, already hidden below 68rem.
---

<div class="bp-divider" role="presentation">
  <span class="bp-marker bp-marker--tl" aria-hidden="true"></span>
  <span class="bp-marker bp-marker--tr" aria-hidden="true"></span>
</div>

<style>
  .bp-divider {
    position: relative;
    height: 0;
    margin-inline: calc(-1 * var(--bp-gutter));
    border-top: 1px dashed var(--bp-line);
  }
</style>
