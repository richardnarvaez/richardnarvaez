---
// Sección dentro del marco de plano: rieles discontinuos a los lados,
// divisor horizontal propio y marcadores en las esquinas superiores.
//
// Las secciones a sangre (franja de imagen, footer) no usan este componente:
// así el riel se interrumpe donde el contenido deja de estar acotado.
interface Props {
  id?: string
  class?: string
  /** Divisor horizontal en el borde superior. */
  divider?: boolean
  /** Cierra el marco por abajo (usar en la última antes de una sección a sangre). */
  close?: boolean
  /** Marcadores cuadrados en las esquinas. */
  markers?: boolean
  /** Anotación en la esquina, estilo plano técnico. */
  label?: string
}

const {
  id,
  class: className,
  divider = true,
  close = false,
  markers = true,
  label,
} = Astro.props
---

<section
  id={id}
  class:list={["bp-section", className]}
  data-bp-divider={divider}
  data-bp-close={close}
>
  <div class="bp-inner">
    {
      markers && divider && (
        <>
          <span class="bp-marker bp-marker--tl" aria-hidden="true" />
          <span class="bp-marker bp-marker--tr" aria-hidden="true" />
        </>
      )
    }
    {
      markers && close && (
        <>
          <span class="bp-marker bp-marker--bl" aria-hidden="true" />
          <span class="bp-marker bp-marker--br" aria-hidden="true" />
        </>
      )
    }

    {
      label && (
        <p class="bp-label font-jetbrains" aria-hidden="true">
          {label}
        </p>
      )
    }

    <slot />
  </div>
</section>

<style>
  .bp-label {
    position: absolute;
    left: var(--bp-gutter);
    top: 0.9rem;
    margin: 0;
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(148, 163, 184, 0.4);
  }
</style>
