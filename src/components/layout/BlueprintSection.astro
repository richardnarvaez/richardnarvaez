---
// A section inside the blueprint frame: dashed rails at the sides, its own top
// divider and markers in the upper corners.
// 
// Full-bleed sections skip this component, so the rail stops where the content
// stops being bounded.
interface Props {
  id?: string
  class?: string
  /* Horizontal divider on the top edge. */
  divider?: boolean
  /* Closes the frame at the bottom; use on the last one before a full-bleed section. */
  close?: boolean
  /* Square corner markers. */
  markers?: boolean
  /*
    Vertical side rails. Turned off when the section follows a full-bleed one that
    already broke the frame: with no divider, two loose rails frame nothing. They
    go transparent, not to zero, so the usable width never changes.
  */
  rails?: boolean
  /* Corner annotation, blueprint style. */
  label?: string
  /* Accessible name: the id of the section heading… */
  ariaLabelledby?: string
  /* …or a string, when the section has no visible heading. */
  ariaLabel?: string
}

const {
  id,
  class: className,
  divider = true,
  close = false,
  markers = true,
  rails = true,
  label,
  ariaLabelledby,
  ariaLabel,
} = Astro.props
---

<section
  id={id}
  class:list={["bp-section", className]}
  data-bp-divider={divider}
  data-bp-close={close}
  aria-labelledby={ariaLabelledby}
  aria-label={ariaLabel}
>
  <div class:list={["bp-inner", { "bp-inner--no-rails": !rails }]}>
    {
      markers && divider && (
        <>
          <span class="bp-marker bp-marker--tl" aria-hidden="true" />
          <span class="bp-marker bp-marker--tr" aria-hidden="true" />
        </>
      )
    }
    {
      markers && close && (
        <>
          <span class="bp-marker bp-marker--bl" aria-hidden="true" />
          <span class="bp-marker bp-marker--br" aria-hidden="true" />
        </>
      )
    }

    {
      label && (
        <p class="bp-label label" aria-hidden="true">
          {label}
        </p>
      )
    }

    <slot />
  </div>
</section>

<style>
  .bp-label {
    position: absolute;
    left: var(--bp-gutter);
    top: 0.9rem;
    margin: 0;
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(148, 163, 184, 0.4);
  }
</style>
