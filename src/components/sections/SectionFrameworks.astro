---
import BlueprintSection from "../layout/BlueprintSection.astro"

// Sin versiones a propósito: las herramientas envejecen mejor que los números.
// Los iconos son trazos de 24px (estilo lucide) dibujados inline.
const stack = [
  {
    title: "React & Next.js",
    body: "App Router, server components and composable design systems.",
    icon: `<circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none"/><ellipse cx="12" cy="12" rx="10" ry="3.8"/><ellipse cx="12" cy="12" rx="10" ry="3.8" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="10" ry="3.8" transform="rotate(120 12 12)"/>`,
  },
  {
    title: "Angular",
    body: "Large-scale SPAs with RxJS and a modular architecture.",
    icon: `<path d="M12 2 3 5.5l1.4 12L12 22l7.6-4.5 1.4-12z"/><path d="m8.5 16.5 3.5-9 3.5 9"/><path d="M9.8 13.5h4.4"/>`,
  },
  {
    title: "Backend",
    body: "REST, GraphQL and gRPC APIs on Node; Postgres and Convex.",
    icon: `<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5v14a9 3 0 0 0 18 0V5"/><path d="M3 12a9 3 0 0 0 18 0"/>`,
  },
  {
    title: "Mobile",
    body: "React Native for iOS and Android; native with Swift, Kotlin and Java.",
    icon: `<rect x="6" y="2" width="12" height="20" rx="2.5"/><path d="M11 18h2"/>`,
  },
  {
    title: "Authentication",
    body: "Sessions, JWT, OAuth and Google sign-in; Directus and Strapi.",
    icon: `<path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/>`,
  },
  {
    title: "Subscriptions & Payments",
    body: "Recurring payments, plans and billing with Stripe and Adyen.",
    icon: `<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/><path d="M6 15h3"/>`,
  },
]
---

<BlueprintSection id="stack" class="stack" label="05 — stack" ariaLabelledby="stack-title">
  {/* Sin título visible: el encabezado existe solo para el esquema del documento y lectores de pantalla. */}
  <h2 class="sr-only" id="stack-title">Stack</h2>
  {/*
    La pantalla, al estilo de la tapa de un MacBook: bisel negro fino con
    esquinas redondas, muesca arriba y el panel dentro, plano. Apoyada sobre
    la base con el teclado, el contenido se lee como lo que muestra la pantalla.
  */}
  <div class="stack__screen">
    <div class="stack__display">
      <span class="stack__notch" aria-hidden="true"></span>
    <ul class="stack__grid">
      {
        stack.map((item) => (
          <li class="card">
            <span class="card__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                width="22"
                height="22"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={item.icon}
              />
            </span>
            <h3 class="card__title">{item.title}</h3>
            <p class="card__body">{item.body}</p>
          </li>
        ))
      }
    </ul>
    </div>
  </div>

  <div class="stack__base">
    <img src="/images/teclado-mac.jpg" width="667" height="295" loading="lazy" decoding="async" alt="" />
  </div>
</BlueprintSection>

<style>
  /* ── Pantalla ─────────────────────────────────────────────────────────── */
  /* Bisel: negro casi puro, fino, con un filo claro que marca el canto de la tapa. */
  .stack__screen {
    /*
      Paleta del modo oscuro de Apple: negro para la tapa, systemGray6 para
      el panel, systemGray5 para las celdas, separador a media opacidad y
      etiquetas secundarias en el gris azulado de iOS. Sin degradados.
    */
    --bezel: #000;
    --panel: #1c1c1e;
    --cell: #2c2c2e;
    --cell-hover: #3a3a3c;
    --tile: #3a3a3c;
    --separator: rgba(84, 84, 88, 0.65);
    --label-2: rgba(235, 235, 245, 0.6);

    position: relative;
    z-index: 1;
    margin-top: clamp(3rem, 8vh, 5rem);
    padding: 0.7rem;
    border-radius: 1.6rem;
    border: 1px solid var(--separator);
    background: var(--bezel);
  }

  /* Panel: plano y opaco, como el resto de tarjetas; más aire arriba por la muesca. */
  .stack__display {
    position: relative;
    padding: clamp(2.6rem, 5vw, 3.6rem) clamp(1.25rem, 3.5vw, 2.75rem) clamp(2.25rem, 4.5vw, 3.25rem);
    border-radius: 1rem;
    background: var(--panel);
    overflow: clip;
  }

  .stack__notch {
    position: absolute;
    top: 0;
    left: 50%;
    width: clamp(6rem, 14%, 9rem);
    height: 1.25rem;
    translate: -50% 0;
    border-radius: 0 0 0.75rem 0.75rem;
    background: var(--bezel);
  }

  /* Rejilla 3x2 fija: con auto-fit quedaban huecos vacíos al final. */
  .stack__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Celdas agrupadas al estilo iOS: relleno sólido, sin borde. */
  .card {
    padding: 1.35rem 1.3rem 1.4rem;
    border-radius: 0.9rem;
    background: var(--cell);
    transition: background 220ms ease;
  }

  .card:hover {
    background: var(--cell-hover);
  }

  .card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0.7rem;
    /* Baldosa neutra (systemGray4) con glifo blanco: monocromo, sin acentos. */
    background: var(--tile);
    color: #fff;
  }

  .card__title {
    margin: 1rem 0 0;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: #fff;
  }

  .card__body {
    margin: 0.35rem 0 0;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--label-2);
  }


  /* ── Base del portátil ────────────────────────────────────────────────── */
  /*
    La foto es el MacBook entreabierto visto de frente. Se solapa con la
    pantalla solo por arriba (~25% de su alto): asoma parte de la tapa con
    su brillo y, sobre todo, la base con el teclado. El solape es
    proporcional al ancho de la imagen.
  */
  .stack__base {
    display: flex;
    justify-content: center;
    margin-top: calc(-1 * min(11%, 5.75rem));
    padding-bottom: clamp(2rem, 6vh, 3.5rem);
  }

  .stack__base img {
    width: min(100%, 52rem);
    height: auto;
    mask-image: radial-gradient(ellipse 70% 80% at 50% 55%, #000 45%, transparent 100%);
  }

  @media (max-width: 900px) {
    .stack__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .stack__grid {
      grid-template-columns: 1fr;
    }

    .stack__screen {
      padding: 0.45rem;
      border-radius: 1.25rem;
    }

    .stack__display {
      border-radius: 0.85rem;
    }

    .stack__notch {
      width: 4.5rem;
      height: 1rem;
    }
  }
</style>
