---
// Full-bleed strip: a half-fixed carriage in front (PNG with alpha windows) and
// an enlarged landscape behind it, driven by scroll rather than time.
// 
// Pure CSS scroll-driven animation. Without support it falls back to a slow
// time-based sway; with reduced-motion it holds the middle frame.
import GradualBlur from "../ui/GradualBlur.astro"

const landscape = "/images/home/fondo.webp"
const wagon = "/images/home/vagones.webp"
---

<section class="scenery" aria-hidden="true">
  <img
    class="scenery__landscape"
    src={landscape}
    width="2000"
    height="1116"
    loading="lazy"
    decoding="async"
    alt=""
  />

  {/*
    As in the hero, the sides blur towards the edge, but only the landscape: they
    sit between the two layers, so the carriage stays sharp on top.
  */}
  <GradualBlur position="left" height="20%" strength={1.5} divCount={5} curve="bezier" exponential zIndex={0} />
  <GradualBlur position="right" height="20%" strength={1.5} divCount={5} curve="bezier" exponential zIndex={0} />

  <img
    class="scenery__wagon"
    src={wagon}
    width="1628"
    height="847"
    loading="lazy"
    decoding="async"
    alt=""
  />

  <div class="scenery__tint"></div>
  <div class="scenery__vignette"></div>
</section>

<style>
  /*
    Ratio comes from the carriage PNG so the windows are never cropped.
    `clip` and not `hidden`: hidden would create a scroll container and confuse
    the view timeline.
  */
  .scenery {
    /* How much wider than the section the landscape is: this sets the travel. */
    --scenery-span: 1.7;

    position: relative;
    width: 100%;
    max-width: var(--bp-max);
    /* Air from the frame closing above. */
    margin: clamp(3rem, 8vh, 5rem) auto 0;
    aspect-ratio: 1628 / 847;
    max-height: 36rem;
    overflow: clip;
    /*
      Del color de la página, no de la escena: con una altura fraccionaria, el
      antialias del último píxel dejaba ver el fondo propio como una línea.
    */
    background: var(--page-accent-surface);
    view-timeline: --scenery block;
    /* Sides faded into the page, since no rails frame them. */
    mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
  }

  /*
    Enlarged landscape: starts flush left and travels the whole overflow as the
    section scrolls out.
  */
  .scenery__landscape {
    position: absolute;
    top: 0;
    left: 0;
    width: calc(var(--scenery-span) * 100%);
    max-width: none; /* el preflight de Tailwind limita las img al 100% */
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
    will-change: transform;
    animation: sceneryTravel linear both;
    animation-timeline: --scenery;
    animation-range: cover 0% cover 100%;
  }

  /* Half-fixed carriage: a slight vertical drift, slower than the page. */
  .scenery__wagon {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    will-change: transform;
    animation: sceneryWagon linear both;
    animation-timeline: --scenery;
    animation-range: cover 0% cover 100%;
  }

  /* A veil of page colour over the whole scene, tying it to the palette. */
  .scenery__tint {
    position: absolute;
    inset: 0;
    background: var(--page-accent-surface);
    opacity: 0.1;
    pointer-events: none;
  }

  /*
    Fades roof and seats into the page, top and bottom. The gradient height is a
    % of the section so it scales with it: a fixed px height ate the whole scene
    on mobile.
  */
  .scenery__vignette {
    --scenery-fade: 70%;
    --page: var(--page-accent-surface);

    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, var(--page) 0%, var(--page) 6%, rgb(var(--surface-rgb) / 0.7) 30%, transparent 100%)
        top / 100% var(--scenery-fade) no-repeat,
      linear-gradient(0deg, var(--page) 0%, var(--page) 6%, rgb(var(--surface-rgb) / 0.7) 30%, transparent 100%)
        bottom / 100% var(--scenery-fade) no-repeat;
    pointer-events: none;
  }

  /* The overflow (span − 1) expressed as a % of the landscape itself. */
  @keyframes sceneryTravel {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc((1 - var(--scenery-span)) / var(--scenery-span) * 100%));
    }
  }

  @keyframes sceneryWagon {
    from {
      transform: scale(1.06) translateY(-2.5%);
    }
    to {
      transform: scale(1.06) translateY(2.5%);
    }
  }

  /* Without scroll-driven animations: a slow time-based sway. */
  @supports not (animation-timeline: view()) {
    .scenery__landscape {
      animation: sceneryTravel 40s ease-in-out infinite alternate;
    }

    .scenery__wagon {
      animation: none;
      transform: scale(1.06);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scenery__landscape,
    .scenery__wagon {
      animation: none;
    }

    .scenery__landscape {
      transform: translateX(calc((1 - var(--scenery-span)) / var(--scenery-span) * 50%));
    }

    .scenery__wagon {
      transform: scale(1.06);
    }
  }
</style>
