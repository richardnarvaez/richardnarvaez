    left: 50%;
    padding: 0.25rem 0.55rem;
    translate: -50% 4px;
    border-radius: 0.4rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    background: rgba(20, 19, 34, 0.92);
    font-size: 0.7rem;
    font-weight: 600;
    white-space: nowrap;
    color: #fff;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 140ms ease,
      translate 140ms ease;
  }

  .piece:hover .piece__name,
  .piece:focus-visible .piece__name {
    opacity: 1;
    translate: -50% 0;
  }

  /* "See all": arriba a la derecha, lejos del dock. Píldora de cristal con contador. */
  .canvas__cta {
    position: absolute;
    top: 1rem;
    right: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.7rem 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(14px);
