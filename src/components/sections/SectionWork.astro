---
// Work section: a MacBook screen as the stage, holding a pannable dot canvas
// with the app ↔ stack diagram and one bottom drawer per case study (MDX).
// Pieces are not draggable: the interaction is reading, not arranging.
//
// The gallery drawer and the lightbox are still mounted here even though the
// gallery lives in its own section: they are fixed layers opened by
// delegation on document.
//
// Each case is also a page at /work/[slug]; opening a drawer sets #work/<slug>
// and loading with that hash opens it on its own.
import { getCollection } from "astro:content"
import BlueprintSection from "../layout/BlueprintSection.astro"
import SectionHeader from "../layout/SectionHeader.astro"
import WorkDrawer from "../work/WorkDrawer.astro"
import WorkLightbox from "../work/WorkLightbox.astro"
import CaseStudy from "../case/CaseStudy.astro"
import { gallery } from "../../data/gallery"
import { toolLogoById } from "../../data/tool-logos"
import savedLayouts from "../../data/diagram-layout.json"

const cases = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order)
const published = cases.filter((c) => !c.data.draft)

// ── Apps: diagrama app ↔ stack ─────────────────────────────────────────
// Built from the MDX frontmatter (stack, status, sticker): adding a case
// redraws the map. Both geometries only differ in the coordinates they
// produce, so switching this constant back is the whole revert.
type Layout = "orbit" | "concentric"
const LAYOUT: Layout = "concentric"
// The cast stops TS narrowing to the literal, which would make the
// comparisons below look impossible.
const isOrbit = (LAYOUT as Layout) === "orbit"

// orbit
const HUB_SIZE = 96
const RING_SIZE = 72
const RING_RX = 256
const RING_RY = 138
const COL_X = 392
const COL_GAP = 40

// concentric. The canvas is 1280×640, so every ring is an ellipse.
const CORE_GAP = 40
const APP_RX = 248
const APP_RY = 165
/* One band for mid and exclusive stacks: two do not fit. Between the app ring
   and the edge there are 108px, and the chips are 125 wide. */
const OUT_RX = 424
const OUT_RY = 270
/* Anchored by their outer edge: centring them on the ring wasted half a chip
   of radial budget per side. */
const OUT_PULL = 40
/** Alternates the radius inwards to clear neighbours on the same ring. */
const OUT_STAGGER = 0.05
const OUT_GAP = 26
/*
  Deterministic, not random. The multiplier must spread well modulo 13: one
  that is ≡ 1 collapses the sequence to j and tilts every chip the same way.
*/
const CHIP_TILT = 4
const tiltOf = (j: number) => ((((j * 7) % 13) - 6) / 6) * CHIP_TILT

/** Gap between the two core columns. */
const CORE_COL_X = 72

/* concentric is radial and symmetric: any offset reads as a gap at the bottom. */
const CLUSTER_Y = isOrbit ? -28 : 0

type AppNode = {
  id: string
  name: string
  src?: string
  initial?: string
  tint?: string
  open?: string
  soon?: boolean
  /** Retired years ago: greyscale plus an R.I.P. label. */
  dead?: boolean
  sticker?: string
  stacks: string[]
  /** Light tile: the initial goes dark. */
  light?: boolean
  x: number
  y: number
  size: number
  rot: number
}

const RAD = Math.PI / 180

/*
  Superellipse, not ellipse: the canvas is a rectangle and an inscribed
  ellipse leaves the corners dead. Same size on the axes, fuller diagonals.
*/
const SUPER_P = 0.62
const sup = (v: number) => Math.sign(v) * Math.abs(v) ** SUPER_P
const base = cases.map((entry) => ({
  id: entry.id,
  name: entry.data.name,
  src: entry.data.icon || undefined,
  initial: entry.data.icon ? undefined : entry.data.name[0],
  tint: entry.data.tint,
  open: entry.data.draft ? undefined : `case:${entry.id}`,
  soon: entry.data.draft && entry.data.status !== "discontinued",
  dead: entry.data.status === "discontinued",
  sticker: entry.data.sticker,
  stacks: entry.data.stack as string[],
  light: entry.data.tint?.toLowerCase() === "#fff",
}))

// ── orbit ───────────────────────────────────────────────────────────────
const orbitNodes = (): AppNode[] => {
  const hubIndex = Math.max(0, cases.findIndex((c) => c.id === "huma"))
  const ring = base.filter((_, i) => i !== hubIndex)
  return base.map((entry, i) => {
    const isHub = i === hubIndex
    const k = ring.indexOf(entry)
    const angle = (-90 + (360 / Math.max(1, ring.length)) * k) * RAD
    return {
      ...entry,
      x: isHub ? 0 : Math.cos(angle) * RING_RX,
      y: CLUSTER_Y + (isHub ? 0 : Math.sin(angle) * RING_RY),
      size: isHub ? HUB_SIZE : RING_SIZE,
      rot: isHub ? -6 : ((k * 137) % 17) - 8,
    }
  })
}

// ── concentric ──────────────────────────────────────────────────────────
/* Greedy seriation: each app lands next to the one it shares most stack with,
   so the connectors into the core do not cross. */
const seriate = (nodes: typeof base) => {
  const rest = [...nodes]
  const first = rest.reduce((bi, n, i) => (n.stacks.length > rest[bi].stacks.length ? i : bi), 0)
  const out = [rest.splice(first, 1)[0]]
  while (rest.length) {
    const prev = out[out.length - 1]
    let bi = 0
    let best = -1
    rest.forEach((n, i) => {
      const shared = n.stacks.filter((x) => prev.stacks.includes(x)).length
      if (shared > best) {
        best = shared
        bi = i
      }
    })
    out.push(rest.splice(bi, 1)[0])
  }
  return out
}

const degree = new Map<string, number>()
for (const n of base) for (const st of n.stacks) degree.set(st, (degree.get(st) ?? 0) + 1)
const deg = (name: string) => degree.get(name) ?? 0

const concentricNodes = (): AppNode[] => {
  const order = seriate(base)
  const degs = base.map((n) => n.stacks.length)
  const lo = Math.min(...degs)
  const hi = Math.max(...degs)
  return base.map((entry) => {
    const k = order.indexOf(entry)
    /* The 20° offset keeps an icon from sitting right above the core stack. */
    const angle = (-70 + (360 / order.length) * k) * RAD
    // Size carries weight too: more stack, bigger icon.
    const t = hi === lo ? 1 : (entry.stacks.length - lo) / (hi - lo)
    return {
      ...entry,
      x: sup(Math.cos(angle)) * APP_RX,
      y: CLUSTER_Y + sup(Math.sin(angle)) * APP_RY,
      size: Math.round(56 + t * 16),
      rot: ((k * 137) % 15) - 7,
    }
  })
}

/* Hand-placed exceptions from the dev editor, applied per piece: anything
   not saved keeps placing itself. */
// The JSON starts empty and TS infers `{}`, hence the double cast.
const saved: Record<string, [number, number]> =
  (savedLayouts as unknown as Record<string, Record<string, [number, number]>>)[LAYOUT] ?? {}
const pin = <T extends { x: number; y: number }>(key: string, item: T): T => {
  const at = saved[key]
  return at ? { ...item, x: at[0], y: at[1] } : item
}

const appNodes: AppNode[] = (isOrbit ? orbitNodes() : concentricNodes()).map((n) =>
  pin(`app:${n.id}`, n),
)
const angleOf = (n: AppNode) => Math.atan2(n.y - CLUSTER_Y, n.x)

// Stack → logo id in tool-logos. Anything missing renders as text only.
const stackLogo: Record<string, string> = {
  Swift: "swift", SwiftUI: "swift", Convex: "convex", Stripe: "stripe", "Next.js": "next", TypeScript: "typescript",
  Postgres: "postgres", Kotlin: "kotlin", React: "react", Angular: "angular", Node: "node", AWS: "aws", Docker: "docker",
  Vercel: "vercel", Figma: "figma", Strapi: "strapi", Railway: "railway", "Google Cloud": "googlecloud", SendGrid: "sendgrid",
  Directus: "directus", Unity: "unity", Firebase: "firebase", Cloudflare: "cloudflare", "Node.js": "node", "React Native": "react", Python: "python",
}

// Black or very dark logos sit on a white circle; the rest render as-is.
const darkLogos = new Set(["Next.js", "Railway", "AWS"])

// ── Stacks and connectors ──────────────────────────────────────────────
const stackNames = [...new Set(appNodes.flatMap((n) => n.stacks))]
const withLogo = <T extends { name: string }>(c: T) => ({
  ...c,
  logo: stackLogo[c.name] ? toolLogoById.get(stackLogo[c.name]) : undefined,
})

// orbit: each stack falls on the side where most of its apps sit.
const orbitChips = () => {
  const sideOf = (name: string) => {
    const users = appNodes.filter((n) => n.stacks.includes(name))
    const meanX = users.reduce((acc, n) => acc + n.x, 0) / Math.max(1, users.length)
    return meanX < 0 ? "left" : "right"
  }
  const left = stackNames.filter((n) => sideOf(n) === "left")
  const right = stackNames.filter((n) => sideOf(n) === "right")
  while (left.length - right.length > 1) right.unshift(left.pop()!)
  while (right.length - left.length > 1) left.push(right.shift()!)
  const column = (names: string[], x: number) =>
    names.map((name, j) => ({ name, x, y: CLUSTER_Y + (j - (names.length - 1) / 2) * COL_GAP }))
  return [...column(left, -COL_X), ...column(right, COL_X)].map((c) => ({ ...c, rot: 0 }))
}

/*
  Three bands by degree: core (4+ apps) at the centre, mid (2-3) at the mean
  angle of the apps sharing them, and exclusives hanging off their own app.
*/
const concentricChips = () => {
  const core = stackNames.filter((n) => deg(n) >= 4)
  const outer = stackNames.filter((n) => deg(n) < 4)

  /* Two columns offset half a row: as a list it read like a menu, the only
     orthogonal thing on a scattered canvas. */
  const coreRows = Math.ceil(core.length / 2)
  const coreChips = core.map((name, j) => {
    const col = j % 2 === 0 ? -1 : 1
    const row = Math.floor(j / 2)
    return {
      name,
      rot: tiltOf(j),
      x: col * CORE_COL_X + (((j * 29) % 17) - 8),
      y: CLUSTER_Y + (row - (coreRows - 1) / 2) * CORE_GAP + (col > 0 ? CORE_GAP / 2 : 0),
    }
  })

  /* Circular mean of its apps: unit vectors are summed because the arithmetic
     mean breaks when crossing ±180°. */
  const wanted = outer.map((name) => {
    const users = appNodes.filter((n) => n.stacks.includes(name))
    const sx = users.reduce((a, n) => a + Math.cos(angleOf(n)), 0)
    const sy = users.reduce((a, n) => a + Math.sin(angleOf(n)), 0)
    let a = Math.atan2(sy, sx)
    if (a < 0) a += 2 * Math.PI
    return { name, a }
  })

  const sorted = [...wanted].sort((p, q) => p.a - q.a)

  /*
    Angle is shared by chip width, not evenly: they run 49px to 125px and an
    even split left the wide ones overlapping. Width is estimated from the text.
  */
  const chipWidth = (name: string) => (stackLogo[name] ? 53 : 26) + name.length * 5.7
  const weights = sorted.map(({ name }) => chipWidth(name) + OUT_GAP)
  const total = weights.reduce((a, b) => a + b, 0)

  let acc = 0
  const outerChips = sorted.map(({ name }, j) => {
    const a = sorted[0].a + ((acc + weights[j] / 2) / total) * 2 * Math.PI
    acc += weights[j]
    const k = 1 - (j % 2) * OUT_STAGGER
    const x = sup(Math.cos(a)) * OUT_RX * k
    return {
      name,
      rot: tiltOf(j),
      x: x - Math.sign(x) * OUT_PULL,
      y: CLUSTER_Y + sup(Math.sin(a)) * OUT_RY * k,
    }
  })

  return [...coreChips, ...outerChips]
}

const stackChips = (isOrbit ? orbitChips() : concentricChips())
  .map(withLogo)
  .map((c) => pin(`stack:${c.name}`, c))
const chipByName = new Map(stackChips.map((c) => [c.name, c]))

// orbit bends in a horizontal S; concentric bows towards the centre so the
// radii converge instead of crossing.
const linkPath = (ax: number, ay: number, bx: number, by: number) => {
  if (isOrbit) {
    const midX = (ax + bx) / 2
    return `M${ax} ${ay} C${midX} ${ay}, ${midX} ${by}, ${bx} ${by}`
  }
  const k = 0.14
  const cx = ((ax + bx) / 2) * (1 - k)
  const cy = CLUSTER_Y + ((ay + by) / 2 - CLUSTER_Y) * (1 - k)
  return `M${ax} ${ay} Q${cx.toFixed(1)} ${cy.toFixed(1)}, ${bx} ${by}`
}

const links = appNodes.flatMap((node) =>
  node.stacks.flatMap((name) => {
    const chip = chipByName.get(name)
    if (!chip) return []
    return [{ app: node.id, stack: name, d: linkPath(node.x, node.y, chip.x, chip.y) }]
  }),
)



---

<BlueprintSection id="work" class="work" label="03 — work" ariaLabelledby="work-title">
  <SectionHeader
    class="work__header"
    claim="Products that shipped, not demos."
    context="The stack behind each one, and the decision that cost the most. Drag the canvas, open any app to read it."
    titleId="work-title"
  />

  <div class="work__mac">
    {/* Lid: thin black bezel, notch and screen. */}
    <div class="work__screen">
      <div class="work__display" data-display data-layout={LAYOUT}>
        <span class="work__notch" aria-hidden="true"></span>

        <div class="canvas" data-canvas>
          <div class="canvas__dots" aria-hidden="true"></div>
          <div class="canvas__layer canvas__layer--diagram" id="layer-apps">
            <div class="canvas__cluster">
                    <div class="diagram" data-diagram data-cluster-y={CLUSTER_Y}>
                      <svg class="diagram__links" viewBox="-640 -320 1280 640" width="1280" height="640" aria-hidden="true">
                        {links.map((l) => <path d={l.d} data-link-app={l.app} data-link-stack={l.stack} />)}
                        <defs>
                          <marker id="diagram-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
                            <path d="M0 0.5 7 4 0 7.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                          </marker>
                        </defs>
                      </svg>

                      {stackChips.map((chip) => (
                        <span
                          class="chip-node"
                          style={`--x: ${chip.x.toFixed(1)}px; --y: ${chip.y.toFixed(1)}px; --rot: ${chip.rot.toFixed(2)}deg;`}
                          data-stack={chip.name}
                        >
                          {chip.logo && (
                            <svg class:list={["chip-node__logo", { "chip-node__logo--badge": darkLogos.has(chip.name) }]} viewBox={chip.logo.viewBox} fill={chip.logo.fill} set:html={chip.logo.body} />
                          )}
                          <span class="chip-node__label">{chip.name}</span>
                        </span>
                      ))}

                      {appNodes.map((node) => {
                        const style = `--x: ${node.x.toFixed(1)}px; --y: ${node.y.toFixed(1)}px; --w: ${node.size}px; --h: ${node.size}px; --rot: ${node.rot}deg;`
                        const tile = (
                          <span class:list={["piece__tile", { "piece__tile--light": node.light, "piece__tile--dead": node.dead }]} style={node.tint ? `background: ${node.tint};` : undefined}>
                            {node.src && <img src={node.src} loading="lazy" decoding="async" draggable="false" alt="" />}
                            {node.initial && <span class="piece__initial">{node.initial}</span>}
                          </span>
                        )
                        const inner = (
                          <>
                            {tile}
                            <span class="node__name">{node.name}</span>
                            {node.sticker && <span class="node__sticker" aria-hidden="true">{node.sticker}</span>}
                          </>
                        )
                        return node.open ? (
                          <button type="button" class="piece node" style={style} data-open={node.open} data-app={node.id} data-stacks={node.stacks.join("|")} aria-label={node.name}>
                            {inner}
                          </button>
                        ) : (
                          <span class="piece piece--static node" style={style} data-app={node.id} data-stacks={node.stacks.join("|")}>
                            {inner}
                          </span>
                        )
                      })}
                    </div>
            </div>
          </div>
        </div>

        {/*
          Herramientas del lienzo, en fila: al aparecer el botón de centrar
          los chips del editor se apartan solos en vez de dejarle un hueco
          reservado que casi siempre está vacío.
        */}
        <div class="work__tools">
          {
            /* Dev only: Vite replaces import.meta.env.DEV with false at build time. */
            import.meta.env.DEV && (
              <>
            <style is:inline>
  .dev-layout {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .dev-layout button {
    display: inline-flex;
    align-items: center;
    height: 2.25rem;
    padding: 0 0.8rem;
    border-radius: 999px;
    border: 1px solid var(--line-tint);
    background: rgb(var(--surface-rgb) / 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: rgb(var(--text-rgb) / 0.75);
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 200ms ease,
      border-color 200ms ease;
  }

  .dev-layout button:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.35);
  }

  .dev-layout button.is-on {
    background: var(--page-accent);
    border-color: var(--page-accent);
    color: #fff;
  }

  .dev-layout__status {
    font-size: 0.68rem;
    color: rgb(var(--text-rgb) / 0.6);
    white-space: nowrap;
  }

  .diagram.is-editing .chip-node,
  .diagram.is-editing .node {
    cursor: grab;
  }

  .diagram.is-editing .chip-node:active,
  .diagram.is-editing .node:active {
    cursor: grabbing;
  }

  .diagram.is-editing .node:hover,
  .diagram.is-editing .chip-node:hover {
    scale: 1;
  }
              /* Not on mobile: development happens on desktop. */
              @media (max-width: 900px) {
                .dev-layout {
                  display: none;
                }
              }
            </style>

              <div class="dev-layout" data-dev-layout>
                <button type="button" data-dev-edit>Mover piezas</button>
                <button type="button" data-dev-save hidden>Guardar</button>
                <button type="button" data-dev-clear hidden>Borrar guardadas</button>
                <span class="dev-layout__status" data-dev-status />
              </div>
              </>
            )
          }

          <button type="button" class="work__recenter" data-recenter aria-label="Recentre the canvas">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="3.2" />
              <path d="M12 2.6v3.2M12 18.2v3.2M2.6 12h3.2M18.2 12h3.2" />
            </svg>
          </button>
        </div>

      </div>
    </div>

    {/* Keyboard base, behind the lid. */}
    <div class="work__base" aria-hidden="true">
      <img src="/images/teclado-mac.jpg" width="667" height="295" loading="lazy" decoding="async" alt="" />
    </div>

    {/* Drawers are fixed full-screen; they live here so the script finds them. */}
    {
      published.map((entry) => (
        <WorkDrawer id={`drawer-${entry.id}`} labelledby={`case-${entry.id}-title`}>
          <CaseStudy entry={entry} headingLevel="h2" titleId={`case-${entry.id}-title`} />
          <p class="work__fullpage">
            <a class="btn btn--ghost btn--sm" href={`/work/${entry.id}`}>Open as a page</a>
          </p>
        </WorkDrawer>
      ))
    }

    <WorkDrawer id="drawer-gallery" labelledby="gallery-title" class="drawer--gallery">
      <header class="gallery__head">
        <h2 class="gallery__title" id="gallery-title">Gallery</h2>
        <div class="gallery__filters" role="group" aria-label="Filter">
          <button type="button" class="chip chip--active" data-gallery-filter="all" aria-pressed="true">All</button>
          <button type="button" class="chip" data-gallery-filter="illustration" aria-pressed="false">Illustrations</button>
          <button type="button" class="chip" data-gallery-filter="app" aria-pressed="false">App icons</button>
          <button type="button" class="chip" data-gallery-filter="photo" aria-pressed="false">Photography</button>
        </div>
      </header>
      <div class="gallery" data-gallery>
        {
          gallery.map((item) => (
            <figure class="gallery__item" id={`g-${item.id}`} data-kind={item.kind}>
              <button type="button" class="gallery__thumb" data-open={`image:${item.id}`} aria-label={`Open ${item.name}`}>
                <img src={item.src} alt={item.name} loading="lazy" decoding="async" style={`aspect-ratio: ${item.ratio};`} />
              </button>
              <figcaption>
                <span class="gallery__name">{item.name}</span>
                {item.desc && <span class="gallery__desc">{item.desc}</span>}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </WorkDrawer>

    <WorkLightbox />

    {/* Gallery data for the viewer: name, text and ratio by id. */}
    <script type="application/json" data-gallery-data set:html={JSON.stringify(Object.fromEntries(gallery.map((g) => [g.id, { name: g.name, desc: g.desc ?? "", src: g.src, full: g.full, ratio: g.ratio, kind: g.kind }])))} />
  </div>
</BlueprintSection>

<script>
  import { initDrawers } from "../../scripts/drawers"

  const root = document.querySelector<HTMLElement>("#work")
  const display = root?.querySelector<HTMLElement>("[data-display]")
  const canvas = root?.querySelector<HTMLElement>("[data-canvas]")

  if (root && display && canvas) {
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches

    // ── Canvas panning (drag with inertia) ─────────────────────────────
    const BOUND_X = 460
    const BOUND_Y = 260
    const clamp = (v: number, b: number) => Math.max(-b, Math.min(b, v))
    let px = 0
    let py = 0
    const recenter = root.querySelector<HTMLElement>("[data-recenter]")
    const setPan = (x: number, y: number) => {
      px = clamp(x, BOUND_X)
      py = clamp(y, BOUND_Y)
      canvas.style.setProperty("--px", `${px.toFixed(1)}px`)
      canvas.style.setProperty("--py", `${py.toFixed(1)}px`)
      // 24px of slack so a micro-drag does not light the button.
      recenter?.classList.toggle("is-on", Math.hypot(px, py) > 24)
    }

    let drag: { id: number; sx: number; sy: number; bx: number; by: number; lx: number; ly: number; lt: number; vx: number; vy: number } | null = null
    let panning = false
    let inertia = 0

    recenter?.addEventListener("click", () => {
      // Shares the inertia handle, so starting a drag cancels the trip home.
      cancelAnimationFrame(inertia)
      if (reduced) return setPan(0, 0)
      const fromX = px
      const fromY = py
      const start = performance.now()
      const glideHome = (now: number) => {
        const t = Math.min(1, (now - start) / 520)
        const eased = 1 - Math.pow(1 - t, 3)
        setPan(fromX * (1 - eased), fromY * (1 - eased))
        if (t < 1) inertia = requestAnimationFrame(glideHome)
      }
      inertia = requestAnimationFrame(glideHome)
    })

    canvas.addEventListener("pointerdown", (event) => {
      if (event.button !== 0) return
      cancelAnimationFrame(inertia)
      drag = { id: event.pointerId, sx: event.clientX, sy: event.clientY, bx: px, by: py, lx: event.clientX, ly: event.clientY, lt: performance.now(), vx: 0, vy: 0 }
      panning = false
    })

    canvas.addEventListener("pointermove", (event) => {
      if (!drag || event.pointerId !== drag.id) return
      const dx = event.clientX - drag.sx
      const dy = event.clientY - drag.sy
      if (!panning && Math.hypot(dx, dy) < 5) return
      if (!panning) {
        panning = true
        canvas.classList.add("is-panning")
        try {
          canvas.setPointerCapture(drag.id)
        } catch {
          /* no capture: still works while the pointer stays over it */
        }
      }
      const now = performance.now()
      const dt = Math.max(1, now - drag.lt)
      drag.vx = ((event.clientX - drag.lx) / dt) * 16
      drag.vy = ((event.clientY - drag.ly) / dt) * 16
      drag.lx = event.clientX
      drag.ly = event.clientY
      drag.lt = now
      setPan(drag.bx + dx, drag.by + dy)
    })

    const endDrag = () => {
      if (!drag) return
      const { vx, vy } = drag
      drag = null
      if (!panning) return
      canvas.classList.remove("is-panning")
      // A click right after a drag must not open anything.
      suppressClick = true
      setTimeout(() => (suppressClick = false), 0)
      if (reduced) return
      let cx = vx
      let cy = vy
      const glide = () => {
        cx *= 0.92
        cy *= 0.92
        setPan(px + cx, py + cy)
        if (Math.abs(cx) + Math.abs(cy) > 0.2) inertia = requestAnimationFrame(glide)
      }
      inertia = requestAnimationFrame(glide)
    }
    // On window: releasing outside the canvas must not leave the drag armed.
    window.addEventListener("pointerup", endDrag)
    window.addEventListener("pointercancel", endDrag)

    let suppressClick = false
    canvas.addEventListener(
      "click",
      (event) => {
        if (suppressClick) {
          event.stopPropagation()
          event.preventDefault()
        }
      },
      true,
    )

    // ── Diagram: only ONE app shows full connectors, the pinned one; the
    //    rest sit at 10%. Hovering lights its own and dims everything else.
    const diagram = canvas.querySelector<HTMLElement>("[data-diagram]")
    if (diagram) {
      const nodes = [...diagram.querySelectorAll<HTMLElement>("[data-app]")]
      const chips = [...diagram.querySelectorAll<HTMLElement>("[data-stack]")]
      const paths = [...diagram.querySelectorAll<SVGPathElement>("path[data-link-app]")]
      let pinned = nodes.some((n) => n.dataset.app === "huma") ? "huma" : nodes[0]?.dataset.app ?? ""

      const clear = () => {
        diagram.classList.remove("has-focus")
        for (const el of [...nodes, ...chips, ...paths]) el.classList.remove("is-lit")
      }
      // Also dims unrelated nodes and chips, but only while a pointer is over one.
      const focusApp = (id: string, dim: boolean) => {
        clear()
        diagram.classList.toggle("has-focus", dim)
        const node = nodes.find((n) => n.dataset.app === id)
        node?.classList.add("is-lit")
        const stacks = new Set((node?.dataset.stacks ?? "").split("|").filter(Boolean))
        for (const chip of chips) if (stacks.has(chip.dataset.stack!)) chip.classList.add("is-lit")
        for (const path of paths) if (path.dataset.linkApp === id) path.classList.add("is-lit")
      }
      const focusStack = (name: string) => {
        clear()
        diagram.classList.add("has-focus")
        chips.find((c) => c.dataset.stack === name)?.classList.add("is-lit")
        const apps = new Set(paths.filter((p) => p.dataset.linkStack === name).map((p) => p.dataset.linkApp!))
        for (const node of nodes) if (apps.has(node.dataset.app!)) node.classList.add("is-lit")
        for (const path of paths) if (path.dataset.linkStack === name) path.classList.add("is-lit")
      }
      const restore = () => focusApp(pinned, false)

      for (const node of nodes) {
        const id = node.dataset.app!
        node.addEventListener("pointerenter", () => {
          pinned = id
          focusApp(id, true)
        })
        node.addEventListener("focus", () => {
          pinned = id
          focusApp(id, true)
        })
        node.addEventListener("blur", restore)
      }
      for (const chip of chips) chip.addEventListener("pointerenter", () => focusStack(chip.dataset.stack!))
      diagram.addEventListener("pointerleave", restore)
      restore()
    }

    // ── Drawers ────────────────────────────────────────────────────────
    // Opening, focus, Escape and drag live in scripts/drawers.ts, shared with
    // the Lab section. Only the Mac-specific parts stay here.
    const drawers = initDrawers(root, {
      onOpen: () => display.classList.add("has-drawer"),
      onClose: () => {
        display.classList.remove("has-drawer")
        if (location.hash.startsWith("#work/")) history.replaceState(null, "", "#work")
      },
    })
    const open = drawers.open

    // ── Gallery filter ─────────────────────────────────────────────────
    const galleryDrawer = root.querySelector<HTMLElement>("#drawer-gallery")
    const filterButtons = [...(galleryDrawer?.querySelectorAll<HTMLButtonElement>("[data-gallery-filter]") ?? [])]
    const galleryItems = [...(galleryDrawer?.querySelectorAll<HTMLElement>(".gallery__item") ?? [])]

    const setFilter = (kind: string) => {
      for (const btn of filterButtons) {
        const on = btn.dataset.galleryFilter === kind
        btn.classList.toggle("chip--active", on)
        btn.setAttribute("aria-pressed", String(on))
      }
      for (const item of galleryItems) item.hidden = kind !== "all" && item.dataset.kind !== kind
    }
    for (const btn of filterButtons) btn.addEventListener("click", () => setFilter(btn.dataset.galleryFilter!))

    const openGallery = (from?: HTMLElement | null, kind = "all") => {
      if (!galleryDrawer) return
      setFilter(kind)
      open(galleryDrawer, from)
    }

    const openCase = (slug: string, from?: HTMLElement | null) => {
      const drawer = root.querySelector<HTMLElement>(`#drawer-${slug}`)
      if (!drawer) return
      open(drawer, from)
      history.replaceState(null, "", `#work/${slug}`)
    }

    // ── Image viewer: flies from the thumbnail over a blurred backdrop ──
    type GalleryDatum = { name: string; desc: string; src: string; full: string; ratio: number; kind: string }
    const galleryData: Record<string, GalleryDatum> = JSON.parse(root.querySelector("[data-gallery-data]")?.textContent ?? "{}")
    const lightbox = root.querySelector<HTMLElement>("[data-lightbox]")
    const lbImg = lightbox?.querySelector<HTMLImageElement>("[data-lightbox-img]")
    const lbName = lightbox?.querySelector<HTMLElement>("[data-lightbox-name]")
    const lbDesc = lightbox?.querySelector<HTMLElement>("[data-lightbox-desc]")
    let lbSource: HTMLElement | null = null
    let lbOpener: HTMLElement | null = null

    type Rect = { left: number; top: number; width: number; height: number }
    const rectOf = (el: Element): Rect => {
      const r = el.getBoundingClientRect()
      return { left: r.left, top: r.top, width: r.width, height: r.height }
    }
    const applyRect = (r: Rect) => {
      if (!lbImg) return
      lbImg.style.left = `${r.left}px`
      lbImg.style.top = `${r.top}px`
      lbImg.style.width = `${r.width}px`
      lbImg.style.height = `${r.height}px`
    }
    // The thumbnail's visible radius lives on an ancestor, not the <img>:
    // walk up until one has it, else 0.
    const radiusOf = (el: HTMLElement, stopAt: HTMLElement) => {
      let node: HTMLElement | null = el
      while (node) {
        const r = getComputedStyle(node).borderRadius
        if (r && r !== "0px") return r
        if (node === stopAt) break
        node = node.parentElement
      }
      return "0px"
    }
    const targetRect = (ratio: number, kind = "photo"): Rect => {
      // App icons are small to begin with: the viewer caps them at 320px.
      const cap = kind === "app" ? 320 : 72 * 16
      const maxW = Math.min(innerWidth * 0.9, cap)
      const maxH = innerHeight * 0.78
      let width = maxW
      let height = width / ratio
      if (height > maxH) {
        height = maxH
        width = height * ratio
      }
      return { left: (innerWidth - width) / 2, top: (innerHeight - height) / 2 - 24, width, height }
    }

    const openImage = (id: string, from: HTMLElement) => {
      const datum = galleryData[id]
      if (!lightbox || !lbImg || !datum) return
      const thumb = (from.querySelector("img") ?? from) as HTMLElement
      lbSource = thumb
      lbOpener = from
      // Starts from the cached thumbnail and swaps to the full size on load.
      lbImg.src = (thumb as HTMLImageElement).currentSrc || datum.src
      lbImg.alt = datum.name
      const large = new Image()
      large.decoding = "async"
      large.onload = () => {
        if (lbSource === thumb && !lightbox.hidden) lbImg.src = datum.full
      }
      large.src = datum.full
      if (lbName) lbName.textContent = datum.name
      if (lbDesc) lbDesc.textContent = datum.desc
      lightbox.hidden = false
      lightbox.classList.remove("is-settled")
      lbImg.style.transition = "none"
      lbImg.style.borderRadius = radiusOf(thumb, from)
      applyRect(rectOf(thumb))
      void lbImg.offsetWidth
      lbImg.style.transition = ""
      lbImg.style.borderRadius = ""
      lightbox.classList.add("is-open")
      applyRect(targetRect(datum.ratio, datum.kind))
      document.documentElement.style.overflow = "hidden"
      setTimeout(() => lightbox.classList.add("is-settled"), reduced ? 0 : 460)
      lightbox.querySelector<HTMLElement>(".lightbox__close")?.focus({ preventScroll: true })
    }

    const closeImage = () => {
      if (!lightbox || !lbImg || lightbox.hidden) return
      lightbox.classList.remove("is-settled")
      lightbox.classList.remove("is-open")
      // Returns to wherever the thumbnail is now: the drawer may have moved.
      if (lbSource) {
        applyRect(rectOf(lbSource))
        lbImg.style.borderRadius = radiusOf(lbSource, lbOpener ?? lbSource)
      }
      const done = () => {
        lightbox.hidden = true
        lbImg.removeAttribute("src")
        lbImg.style.borderRadius = ""
        // With no drawer open underneath, the page scrolls again.
        if (!drawers.current()) document.documentElement.style.overflow = ""
      }
      if (reduced) done()
      else setTimeout(done, 480)
      lbOpener?.focus({ preventScroll: true })
    }

    for (const btn of lightbox?.querySelectorAll("[data-lightbox-close]") ?? []) btn.addEventListener("click", closeImage)
    root.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape" && lightbox && !lightbox.hidden) {
          event.preventDefault()
          event.stopPropagation()
          closeImage()
        }
      },
      true,
    )

    // data-open="case:slug" | "image:id" | "gallery" | "gallery:photo"
    const route = (target: HTMLElement) => {
      const [kind, id] = target.dataset.open!.split(":")
      if (kind === "case") openCase(id, target)
      else if (kind === "image") openImage(id, target)
      else if (kind === "gallery") openGallery(target, id || "all")
    }
    galleryDrawer?.addEventListener("click", (event) => {
      const el = (event.target as HTMLElement).closest<HTMLElement>("[data-open]")
      if (el) route(el)
    })

    canvas.addEventListener("click", (event) => {
      const piece = (event.target as HTMLElement).closest<HTMLElement>("[data-open]")
      if (piece) route(piece)
    })

    // Triggers outside this section, like the bento's Photography card: only
    // the ones pointing at cases, images or the gallery.
    document.addEventListener("click", (event) => {
      const el = (event.target as HTMLElement).closest<HTMLElement>("[data-open]")
      if (!el || root.contains(el)) return
      const kind = el.dataset.open!.split(":")[0]
      if (kind === "case" || kind === "image" || kind === "gallery") route(el)
    })

    // Deep link: /#work/huma opens the case, on load or on hash change.
    const openFromHash = () => {
      const match = location.hash.match(/^#work\/([\w-]+)$/)
      if (!match) return
      root.scrollIntoView({ block: "start" })
      openCase(match[1], null)
    }
    requestAnimationFrame(openFromHash)
    window.addEventListener("hashchange", openFromHash)

    /*
      Position editor, dev only. It sends just the pieces you moved and the
      server merges them, so everything else keeps placing itself.
    */
    if (import.meta.env.DEV && diagram) {
      const bar = root.querySelector<HTMLElement>("[data-dev-layout]")
      const cluster = root.querySelector<HTMLElement>(".canvas__cluster")
      const editBtn = bar?.querySelector<HTMLButtonElement>("[data-dev-edit]")
      const saveBtn = bar?.querySelector<HTMLButtonElement>("[data-dev-save]")
      const clearBtn = bar?.querySelector<HTMLButtonElement>("[data-dev-clear]")
      const status = bar?.querySelector<HTMLElement>("[data-dev-status]")

      if (bar && cluster && editBtn && saveBtn && clearBtn && status) {
        const layout = display.dataset.layout ?? "concentric"
        const clusterY = Number(diagram.dataset.clusterY ?? 0)
        const moved = new Set<string>()
        let editing = false

        // The cluster is scaled on narrow screens: divide the pointer delta
        // by that scale or the piece moves twice as far.
        const scaleOf = () => parseFloat(getComputedStyle(cluster).scale) || 1
        const at = (el: HTMLElement) => ({
          x: parseFloat(el.style.getPropertyValue("--x")) || 0,
          y: parseFloat(el.style.getPropertyValue("--y")) || 0,
        })
        const keyOf = (el: HTMLElement) =>
          el.dataset.stack ? `stack:${el.dataset.stack}` : el.dataset.app ? `app:${el.dataset.app}` : null

        // Same path the server computes, so connectors follow while dragging.
        const redraw = () => {
          for (const path of diagram.querySelectorAll<SVGPathElement>("[data-link-app]")) {
            const node = diagram.querySelector<HTMLElement>(`.node[data-app="${path.dataset.linkApp}"]`)
            const chip = diagram.querySelector<HTMLElement>(`.chip-node[data-stack="${path.dataset.linkStack}"]`)
            if (!node || !chip) continue
            const a = at(node)
            const b = at(chip)
            if (layout === "orbit") {
              const mx = (a.x + b.x) / 2
              path.setAttribute("d", `M${a.x} ${a.y} C${mx} ${a.y}, ${mx} ${b.y}, ${b.x} ${b.y}`)
            } else {
              const k = 0.14
              const cx = ((a.x + b.x) / 2) * (1 - k)
              const cy = clusterY + ((a.y + b.y) / 2 - clusterY) * (1 - k)
              path.setAttribute("d", `M${a.x} ${a.y} Q${cx.toFixed(1)} ${cy.toFixed(1)}, ${b.x} ${b.y}`)
            }
          }
        }

        editBtn.addEventListener("click", () => {
          editing = !editing
          diagram.classList.toggle("is-editing", editing)
          editBtn.classList.toggle("is-on", editing)
          editBtn.textContent = editing ? "Terminar" : "Mover piezas"
          saveBtn.hidden = !editing
          clearBtn.hidden = !editing
          status.textContent = editing ? "arrastra las piezas" : ""
        })

        let moving: { el: HTMLElement; sx: number; sy: number; ox: number; oy: number } | null = null

        diagram.addEventListener("pointerdown", (event) => {
          if (!editing) return
          const el = (event.target as HTMLElement).closest<HTMLElement>(".chip-node, .node")
          if (!el) return
          // Stop here or the whole canvas starts panning.
          event.preventDefault()
          event.stopPropagation()
          const p = at(el)
          moving = { el, sx: event.clientX, sy: event.clientY, ox: p.x, oy: p.y }
          try {
            el.setPointerCapture(event.pointerId)
          } catch {
            /* no capture: still works while the pointer stays over it */
          }
        })

        window.addEventListener("pointermove", (event) => {
          if (!moving) return
          const k = scaleOf()
          moving.el.style.setProperty("--x", `${(moving.ox + (event.clientX - moving.sx) / k).toFixed(1)}px`)
          moving.el.style.setProperty("--y", `${(moving.oy + (event.clientY - moving.sy) / k).toFixed(1)}px`)
          redraw()
        })

        window.addEventListener("pointerup", () => {
          if (!moving) return
          const key = keyOf(moving.el)
          if (key) {
            moved.add(key)
            status.textContent = `${moved.size} movida${moved.size === 1 ? "" : "s"} — sin guardar`
          }
          moving = null
          // Releasing after a drag must not open the case.
          suppressClick = true
          setTimeout(() => (suppressClick = false), 0)
        })

        const post = (body: unknown) =>
          fetch("/__diagram-layout", { method: "POST", body: JSON.stringify(body) }).then((r) => r.json())

        saveBtn.addEventListener("click", async () => {
          const positions: Record<string, [number, number]> = {}
          for (const key of moved) {
            const el = diagram.querySelector<HTMLElement>(
              key.startsWith("stack:")
                ? `.chip-node[data-stack="${key.slice(6)}"]`
                : `.node[data-app="${key.slice(4)}"]`,
            )
            if (!el) continue
            const p = at(el)
            positions[key] = [Math.round(p.x), Math.round(p.y)]
          }
          status.textContent = "guardando…"
          const out = await post({ layout, positions })
          status.textContent = out.ok ? `guardadas ${out.saved}` : `error: ${out.error}`
          if (out.ok) moved.clear()
        })

        clearBtn.addEventListener("click", async () => {
          const out = await post({ layout, positions: {}, reset: true })
          status.textContent = out.ok ? "borradas — recarga" : `error: ${out.error}`
        })
      }
    }
  }
</script>

<style>
  /* ── MacBook ─────────────────────────────────────────────────────────── */
  /* Top air comes from the bento, which closes its own block with padding. */

  /* Rendered by SectionHeader with its own scope: only :global reaches it. */
  :global(.work__header) {
    padding-block: var(--section-y) 0;
  }

  .work__mac {
    margin-top: 0;
  }

  .work__screen {
    /* Flat colour, not transparency, so bezel and notch do not depend on
       whatever sits behind them. */
    --bezel: #0d0d18;

    position: relative;
    z-index: 1;
    padding: 0.7rem;
    border-radius: 1.6rem;
    background: var(--bezel);
    /* No border: the lid separates from the page with shadow alone. */
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.35),
      0 30px 80px -30px rgba(0, 0, 0, 0.9);
  }

  .work__display {
    position: relative;
    height: clamp(22rem, 52vw, 34rem);
    /* Height is tied to the layout: going back to "orbit" restores it too. */
    overflow: clip;
    border-radius: 1rem;
    background: var(--page-accent-surface);
    /* Own stacking context: drawers pile up inside the screen. */
    isolation: isolate;
  }

  .work__display[data-layout="concentric"] {
    height: clamp(22rem, 54vw, 40rem);
  }

  /* Focuses in rather than appearing, like the menu circles. */
  .work__recenter {
    display: grid;
    place-items: center;
    flex: none;
    /* Collapses to zero width and eats the flex gap, so neighbours shift. */
    width: 0;
    margin-left: -0.4rem;
    height: 2.25rem;
    padding: 0;
    overflow: hidden;
    border-radius: 999px;
    border: 1px solid var(--line-tint);
    background: rgb(var(--surface-rgb) / 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: rgb(var(--text-rgb) / 0.75);
    cursor: pointer;
    opacity: 0;
    filter: blur(6px);
    scale: 0.78;
    pointer-events: none;
    transition:
      width 380ms var(--ease-out),
      margin-left 380ms var(--ease-out),
      opacity 320ms var(--ease-out),
      filter 380ms var(--ease-out),
      scale 380ms var(--ease-out),
      color 200ms ease,
      border-color 200ms ease;
  }

  .work__recenter.is-on {
    width: 2.25rem;
    margin-left: 0;
    opacity: 1;
    filter: blur(0);
    scale: 1;
    pointer-events: auto;
  }

  .work__recenter svg {
    flex: none;
  }

  .work__recenter:hover {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.35);
  }

  .work__tools {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .work__notch {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 4;
    width: clamp(6rem, 14%, 9rem);
    height: 1.25rem;
    translate: -50% 0;
    border-radius: 0 0 0.75rem 0.75rem;
    background: var(--bezel);
    pointer-events: none;
  }

  .work__base {
    display: flex;
    justify-content: center;
    margin-top: calc(-1 * min(11%, 5.75rem));
    padding-bottom: clamp(2rem, 6vh, 3.5rem);
  }

  .work__base img {
    width: min(100%, 52rem);
    height: auto;
    mask-image: radial-gradient(ellipse 70% 80% at 50% 55%, #000 45%, transparent 100%);
  }

  /* ── Canvas ──────────────────────────────────────────────────────────── */
  .canvas {
    --px: 0px;
    --py: 0px;
    --cluster-scale: 1;

    position: absolute;
    inset: 0;
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  .canvas.is-panning {
    cursor: grabbing;
  }

  /* Pieces take no events while panning: no stray hover or click. */
  .canvas.is-panning .piece {
    pointer-events: none;
  }

  .canvas__dots {
    position: absolute;
    inset: -60%;
    background-image: radial-gradient(circle, var(--line-tint) 1px, transparent 1.6px);
    background-size: 22px 22px;
    translate: calc(var(--px) * 0.5) calc(var(--py) * 0.5);
    mask-image: radial-gradient(ellipse 45% 45% at 50% 50%, #000 40%, transparent 100%);
    pointer-events: none;
  }

  .canvas__layer {
    position: absolute;
    inset: 0;
  }

  .canvas__cluster {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    translate: var(--px) var(--py);
    scale: var(--cluster-scale);
    will-change: translate;
  }

  /* ── App ↔ stack diagram ─────────────────────────────────────────────── */
  .diagram {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
  }

  .diagram__links {
    position: absolute;
    left: -640px;
    top: -320px;
    overflow: visible;
    color: rgba(139, 126, 210, 0.85);
    pointer-events: none;
  }

  /* Connectors sit at 10% unless their app is pinned or focused. */
  .diagram__links path {
    fill: none;
    stroke: var(--line-tint);
    stroke-width: 1.2;
    stroke-dasharray: 4 5;
    marker-end: url(#diagram-arrow);
    opacity: 0.1;
    transition:
      stroke 220ms ease,
      opacity 220ms ease;
  }

  /* Pinned: full connectors, dashed, in the base ink. */
  .diagram__links path.is-lit {
    opacity: 1;
  }

  .diagram.has-focus .diagram__links path.is-lit {
    stroke: var(--page-accent);
    stroke-width: 1.5;
  }

  .chip-node {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.75rem 0.4rem 0.6rem;
    translate: -50% -50%;
    rotate: var(--rot, 0deg);
    border-radius: 999px;
    border: 1px solid var(--line-tint);
    background: var(--surface-2);
    font-size: 0.74rem;
    font-weight: 600;
    white-space: nowrap;
    color: rgb(var(--text-rgb) / 0.95);
    /*
      Grey at rest: what competed with the icons was colour, not brightness,
      so colour becomes the signal. Note greyscale already marks retired apps
      in .piece__tile--dead.
    */
    filter: grayscale(1);
    opacity: 0.78;
    cursor: default;
    transition:
      opacity 220ms ease,
      filter 260ms ease,
      border-color 220ms ease,
      color 220ms ease,
      background 220ms ease;
  }

  .chip-node__logo {
