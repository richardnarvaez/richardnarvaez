---
// Sección de trabajo: la pantalla de un MacBook como escenario. Dentro, un
// lienzo de puntos que se puede desplazar (arrastrando, con inercia) con
// las piezas de la capa activa; un dock con tres capas (Apps, Illustrations,
// Photography); y drawers inferiores: uno por caso de estudio (MDX) y uno
// para la galería con filtro simple. Sin arrastrar piezas: las posiciones
// son fijas y la interacción es leer, no ordenar.
//
// Cada caso existe además como página propia en /work/[slug]; el drawer es
// la misma pieza montada aquí. Al abrir uno, la URL pasa a #work/<slug>, y
// al cargar con ese hash se abre solo.
import { getCollection } from "astro:content"
import BlueprintSection from "../layout/BlueprintSection.astro"
import MacDock from "../work/MacDock.astro"
import WorkDrawer from "../work/WorkDrawer.astro"
import WorkLightbox from "../work/WorkLightbox.astro"
import CaseStudy from "../case/CaseStudy.astro"
import { gallery, type GalleryItem } from "../../data/gallery"

const cases = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order)
const published = cases.filter((c) => !c.data.draft)

// ── Ranuras (px respecto al centro del lienzo) ──────────────────────────
type Slot = { x: number; y: number; w: number; ratio?: number }

// Apps: 3 grandes (88px) alrededor del centro y 6 pequeños (56px) en parejas
// flanqueando cada hueco; radios para ~16px entre vecinos.
const polar = (r: number, deg: number) => ({ x: Math.cos((deg * Math.PI) / 180) * r, y: Math.sin((deg * Math.PI) / 180) * r })
const appSlots: Slot[] = [
  ...[-90, 30, 150].map((deg) => ({ ...polar(60, deg), w: 88 })),
  ...[-46.8, -13.2, 73.2, 106.8, 193.2, 226.8].map((deg) => ({ ...polar(123, deg), w: 56 })),
]

// Galería: lo principal de ilustración y fotografía en una sola composición
// tipo mood board, 7 piezas alternando ambos tipos. El resto vive en el drawer.
const featuredIds = ["madeira", "ill-1", "landing-path", "ill-2", "sail-line", "ill-4", "blue-valley"]
const gallerySlots: Slot[] = [
  { x: 0, y: -12, w: 168, ratio: 0.8 },
  { x: -176, y: -64, w: 128, ratio: 1 },
  { x: 168, y: -56, w: 108, ratio: 0.75 },
  { x: -168, y: 92, w: 108, ratio: 1.43 },
  { x: 164, y: 104, w: 92, ratio: 0.5625 },
  { x: 306, y: 24, w: 88, ratio: 0.7 },
  { x: -318, y: 14, w: 84, ratio: 0.8 },
]
const featured = featuredIds.map((id) => gallery.find((g) => g.id === id)!).filter(Boolean)

type Piece = {
  id: string
  name: string
  src?: string
  initial?: string
  tint?: string
  /** "case:<slug>" o "image:<id>"; sin `open`, la pieza no es pulsable. */
  open?: string
  soon?: boolean
  placeholder?: boolean
  x: number
  y: number
  w: number
  h: number
  rot: number
}

const appPieces: Piece[] = appSlots.map((slot, i) => {
  const entry = cases[i]
  const base = { ...slot, h: slot.w, rot: ((i * 137) % 25) - 12 }
  if (!entry) return { ...base, id: `slot-${i}`, name: "Coming soon", placeholder: true }
  return {
    ...base,
    id: entry.id,
    name: entry.data.name,
    src: entry.data.icon || undefined,
    initial: entry.data.icon ? undefined : entry.data.name[0],
    tint: entry.data.tint,
    open: entry.data.draft ? undefined : `case:${entry.id}`,
    soon: entry.data.draft,
  }
})

const galleryPieces = (items: GalleryItem[], slots: Slot[]): Piece[] =>
  items.slice(0, slots.length).map((item, i) => {
    const slot = slots[i]
    return { id: item.id, name: item.name, src: item.src, open: `image:${item.id}`, x: slot.x, y: slot.y, w: slot.w, h: slot.w / (slot.ratio ?? 1), rot: 0 }
  })

const layers = [
  {
    id: "apps",
    label: "Apps",
    kind: "icons",
    pieces: appPieces,
    icon: `<rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/>`,
    tint: ["#5ac8fa", "#0a5fd6"] as [string, string],
  },
  {
    id: "gallery",
    label: "Gallery",
    kind: "canvas",
    pieces: galleryPieces(featured, gallerySlots),
    icon: `<rect x="3" y="5" width="18" height="14" rx="2.5"/><circle cx="9" cy="10" r="1.6"/><path d="m21 15-4.5-4.5L8 19"/>`,
    tint: ["#ff9f5a", "#e0402f"] as [string, string],
  },
] as const

const dockItems = layers.map(({ id, label, icon, tint }) => ({ id, label, icon, tint }))
---

{/* Sin divisor ni título: continúa el bloque 02 (shortcuts & work) que abre el bento. */}
<BlueprintSection id="work" class="work" divider={false} ariaLabel="Projects and products">
  <div class="work__mac">
    {/* Tapa: bisel negro fino, muesca y pantalla. */}
    <div class="work__screen">
      <div class="work__display" data-display>
        <span class="work__notch" aria-hidden="true"></span>

        <div class="canvas" data-canvas>
          <div class="canvas__dots" aria-hidden="true"></div>
          {
            layers.map((layer) => (
              <div
                class:list={["canvas__layer", `canvas__layer--${layer.kind}`]}
                id={`layer-${layer.id}`}
                role="tabpanel"
                aria-labelledby={`dock-${layer.id}`}
                data-layer={layer.id}
                hidden={layer.id !== "apps"}
              >
                <div class="canvas__cluster">
                  {layer.pieces.map((p) => {
                    const style = `--x: ${p.x.toFixed(1)}px; --y: ${p.y.toFixed(1)}px; --w: ${p.w}px; --h: ${p.h.toFixed(1)}px; --rot: ${p.rot}deg;`
                    const tile = (
                      <span class="piece__tile" style={p.tint ? `background: ${p.tint};` : undefined}>
                        {p.src && <img src={p.src} loading="lazy" decoding="async" draggable="false" alt="" />}
                        {p.initial && <span class="piece__initial">{p.initial}</span>}
                        {p.placeholder && <span class="piece__plus" aria-hidden="true">+</span>}
                        {p.soon && <span class="piece__soon font-jetbrains">soon</span>}
                      </span>
                    )
                    return p.open ? (
                      <button type="button" class="piece" style={style} data-open={p.open} aria-label={p.name}>
                        {tile}
                        <span class="piece__name" aria-hidden="true">{p.name}</span>
                      </button>
                    ) : (
                      <span class:list={["piece", "piece--static", { "piece--placeholder": p.placeholder }]} style={style} aria-hidden="true">
                        {tile}
                      </span>
                    )
                  })}
                </div>
                {layer.id === "gallery" && (
                  <button type="button" class="canvas__cta" data-open="gallery">
                    <span>See all</span>
                    <span class="canvas__cta-count font-jetbrains">{gallery.length}</span>
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg>
                  </button>
                )}
              </div>
            ))
          }
        </div>

        <MacDock items={dockItems} active="apps" />
      </div>
    </div>

    {/* Base con el teclado, detrás de la tapa. */}
    <div class="work__base" aria-hidden="true">
      <img src="/images/teclado-mac.jpg" width="667" height="295" loading="lazy" decoding="async" alt="" />
    </div>

    {/* Drawers: fijos a pantalla completa; viven aquí para que el script los encuentre. */}
    {
      published.map((entry) => (
        <WorkDrawer id={`drawer-${entry.id}`} labelledby={`case-${entry.id}-title`}>
          <CaseStudy entry={entry} headingLevel="h2" titleId={`case-${entry.id}-title`} />
          <p class="work__fullpage">
            <a class="btn btn--ghost btn--sm" href={`/work/${entry.id}`}>Open as a page</a>
          </p>
        </WorkDrawer>
      ))
    }

    <WorkDrawer id="drawer-gallery" labelledby="gallery-title" class="drawer--gallery">
      <header class="gallery__head">
        <h2 class="gallery__title" id="gallery-title">Gallery</h2>
        <div class="gallery__filters" role="group" aria-label="Filter">
          <button type="button" class="chip chip--active" data-gallery-filter="all" aria-pressed="true">All</button>
          <button type="button" class="chip" data-gallery-filter="illustration" aria-pressed="false">Illustrations</button>
          <button type="button" class="chip" data-gallery-filter="photo" aria-pressed="false">Photography</button>
        </div>
      </header>
      <div class="gallery" data-gallery>
        {
          gallery.map((item) => (
            <figure class="gallery__item" id={`g-${item.id}`} data-kind={item.kind}>
              <button type="button" class="gallery__thumb" data-open={`image:${item.id}`} aria-label={`Open ${item.name}`}>
                <img src={item.src} alt={item.name} loading="lazy" decoding="async" style={`aspect-ratio: ${item.ratio};`} />
              </button>
              <figcaption>
                <span class="gallery__name">{item.name}</span>
                {item.desc && <span class="gallery__desc">{item.desc}</span>}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </WorkDrawer>

    <WorkLightbox />

    {/* Datos de la galería para el visor: nombre, texto y proporción por id. */}
    <script type="application/json" data-gallery-data set:html={JSON.stringify(Object.fromEntries(gallery.map((g) => [g.id, { name: g.name, desc: g.desc ?? "", src: g.src, full: g.full, ratio: g.ratio }])))} />
  </div>
</BlueprintSection>

<script>
  const root = document.querySelector<HTMLElement>("#work")
  const display = root?.querySelector<HTMLElement>("[data-display]")
  const canvas = root?.querySelector<HTMLElement>("[data-canvas]")
  const dock = root?.querySelector<HTMLElement>("[data-dock]")

  if (root && display && canvas && dock) {
    const hoverable = matchMedia("(hover: hover)").matches
    const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches

    // ── Capas ↔ dock (pestañas) ─────────────────────────────────────────
    const tabs = [...dock.querySelectorAll<HTMLButtonElement>("[data-dock-item]")]
    const layersEl = [...canvas.querySelectorAll<HTMLElement>("[data-layer]")]

    const showLayer = (id: string) => {
      for (const tab of tabs) {
        const on = tab.dataset.dockItem === id
        tab.setAttribute("aria-selected", String(on))
        tab.tabIndex = on ? 0 : -1
      }
      for (const layer of layersEl) layer.hidden = layer.dataset.layer !== id
      // Cada capa vuelve al centro: sus piezas están compuestas para él.
      setPan(0, 0)
    }

    for (const tab of tabs) tab.addEventListener("click", () => showLayer(tab.dataset.dockItem!))
    dock.addEventListener("keydown", (event) => {
      const i = tabs.findIndex((t) => t === document.activeElement)
      if (i < 0) return
      const next = event.key === "ArrowRight" ? i + 1 : event.key === "ArrowLeft" ? i - 1 : -1
      if (next < 0) return
      event.preventDefault()
      const tab = tabs[(next + tabs.length) % tabs.length]
      showLayer(tab.dataset.dockItem!)
      tab.focus()
    })

    // ── Magnificación del dock ──────────────────────────────────────────
    if (hoverable) {
      const RANGE = 96
      const GAIN = 0.55
      // La barra se ensancha simétricamente al magnificar (está centrada), así
      // que se comparan posiciones respecto a su centro: los centros de los
      // iconos se miden en reposo y el puntero se refiere al centro actual.
      // Sin realimentación: la medida no depende del estado magnificado.
      let centers: number[] = []
      const measure = () => {
        for (const tab of tabs) tab.style.setProperty("--s", "1")
        const mid = dock.getBoundingClientRect()
        const dockMid = mid.left + mid.width / 2
        centers = tabs.map((tab) => {
          const box = tab.getBoundingClientRect()
          return box.left + box.width / 2 - dockMid
        })
      }
      dock.addEventListener("pointerenter", () => {
        measure()
        dock.classList.remove("is-idle")
      })
      dock.addEventListener("pointermove", (event) => {
        const box = dock.getBoundingClientRect()
        const x = event.clientX - (box.left + box.width / 2)
        tabs.forEach((tab, i) => {
          const d = Math.abs(x - centers[i])
          // Caída en coseno: suave en el centro y en los bordes, como el Dock.
          const t = Math.max(0, 1 - d / RANGE)
          const s = 1 + GAIN * (0.5 - 0.5 * Math.cos(Math.PI * t))
          tab.style.setProperty("--s", s.toFixed(3))
        })
      })
      dock.addEventListener("pointerleave", () => {
        dock.classList.add("is-idle")
        for (const tab of tabs) tab.style.setProperty("--s", "1")
      })
    }

    // ── Desplazamiento del lienzo (arrastre con inercia) ────────────────
    const BOUND_X = 280
    const BOUND_Y = 190
    const clamp = (v: number, b: number) => Math.max(-b, Math.min(b, v))
    let px = 0
    let py = 0
    const setPan = (x: number, y: number) => {
      px = clamp(x, BOUND_X)
      py = clamp(y, BOUND_Y)
      canvas.style.setProperty("--px", `${px.toFixed(1)}px`)
      canvas.style.setProperty("--py", `${py.toFixed(1)}px`)
    }

    let drag: { id: number; sx: number; sy: number; bx: number; by: number; lx: number; ly: number; lt: number; vx: number; vy: number } | null = null
    let panning = false
    let inertia = 0

    canvas.addEventListener("pointerdown", (event) => {
      if (event.button !== 0) return
      cancelAnimationFrame(inertia)
      drag = { id: event.pointerId, sx: event.clientX, sy: event.clientY, bx: px, by: py, lx: event.clientX, ly: event.clientY, lt: performance.now(), vx: 0, vy: 0 }
      panning = false
    })

    canvas.addEventListener("pointermove", (event) => {
      if (!drag || event.pointerId !== drag.id) return
      const dx = event.clientX - drag.sx
      const dy = event.clientY - drag.sy
      if (!panning && Math.hypot(dx, dy) < 5) return
      if (!panning) {
        panning = true
        canvas.classList.add("is-panning")
        try {
          canvas.setPointerCapture(drag.id)
        } catch {
          /* sin captura: sigue funcionando mientras el puntero esté encima */
        }
      }
      const now = performance.now()
      const dt = Math.max(1, now - drag.lt)
      drag.vx = ((event.clientX - drag.lx) / dt) * 16
      drag.vy = ((event.clientY - drag.ly) / dt) * 16
      drag.lx = event.clientX
      drag.ly = event.clientY
      drag.lt = now
      setPan(drag.bx + dx, drag.by + dy)
    })

    const endDrag = () => {
      if (!drag) return
      const { vx, vy } = drag
      drag = null
      if (!panning) return
      canvas.classList.remove("is-panning")
      // Un clic justo después de arrastrar no debe abrir nada.
      suppressClick = true
      setTimeout(() => (suppressClick = false), 0)
      if (reduced) return
      let cx = vx
      let cy = vy
      const glide = () => {
        cx *= 0.92
        cy *= 0.92
        setPan(px + cx, py + cy)
        if (Math.abs(cx) + Math.abs(cy) > 0.2) inertia = requestAnimationFrame(glide)
      }
      inertia = requestAnimationFrame(glide)
    }
    canvas.addEventListener("pointerup", endDrag)
    canvas.addEventListener("pointercancel", endDrag)

    let suppressClick = false
    canvas.addEventListener(
      "click",
      (event) => {
        if (suppressClick) {
          event.stopPropagation()
          event.preventDefault()
        }
      },
      true,
    )

    // ── Drawers ────────────────────────────────────────────────────────
    const drawers = [...root.querySelectorAll<HTMLElement>("[data-drawer]")]
    let openDrawer: HTMLElement | null = null
    let opener: HTMLElement | null = null

    const focusables = (el: HTMLElement) =>
      [...el.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])')].filter((n) => !n.closest("[hidden]"))

    const open = (drawer: HTMLElement, from?: HTMLElement | null) => {
      if (openDrawer && openDrawer !== drawer) close(false)
      opener = from ?? (document.activeElement as HTMLElement | null)
      openDrawer = drawer
      drawer.hidden = false
      // Fuerza el layout con el panel abajo antes de animarlo hacia arriba.
      void drawer.offsetHeight
      drawer.classList.add("is-open")
      display.classList.add("has-drawer")
      // La página no se desplaza mientras el drawer está abierto.
      document.documentElement.style.overflow = "hidden"
      drawer.querySelector<HTMLElement>("[data-drawer-body]")?.scrollTo({ top: 0 })
      drawer.querySelector<HTMLElement>("[data-drawer-close]:not(.drawer__scrim)")?.focus()
    }

    const close = (restoreFocus = true) => {
      const drawer = openDrawer
      if (!drawer) return
      openDrawer = null
      drawer.classList.remove("is-open")
      display.classList.remove("has-drawer")
      document.documentElement.style.overflow = ""
      const done = () => {
        drawer.hidden = true
        drawer.querySelector<HTMLElement>("[data-drawer-panel]")!.style.translate = ""
        const scrim = drawer.querySelector<HTMLElement>(".drawer__scrim")!
        scrim.style.backdropFilter = ""
        scrim.style.removeProperty("-webkit-backdrop-filter")
      }
      if (reduced) done()
      else setTimeout(done, 480)
      if (restoreFocus) opener?.focus()
      if (location.hash.startsWith("#work/")) history.replaceState(null, "", "#work")
    }

    for (const drawer of drawers) {
      for (const btn of drawer.querySelectorAll("[data-drawer-close]")) btn.addEventListener("click", () => close())

      // Arrastrar el asa hacia abajo cierra; si no llega, vuelve a su sitio.
      const grip = drawer.querySelector<HTMLElement>("[data-drawer-grip]")!
      const panel = drawer.querySelector<HTMLElement>("[data-drawer-panel]")!
      const scrim = drawer.querySelector<HTMLElement>(".drawer__scrim")!
      let start: number | null = null
      let last = 0
      let lastT = 0
      let v = 0
      grip.addEventListener("pointerdown", (event) => {
        // El botón de cerrar vive dentro del asa: si el gesto empieza ahí, no
        // es un arrastre (capturar el puntero le robaría el clic).
        if ((event.target as HTMLElement).closest("[data-drawer-close]")) return
        start = event.clientY
        last = start
        lastT = performance.now()
        v = 0
        drawer.classList.add("is-dragging")
        try {
          grip.setPointerCapture(event.pointerId)
        } catch {
          /* idem */
        }
      })
      grip.addEventListener("pointermove", (event) => {
        if (start === null) return
        const dy = Math.max(0, event.clientY - start)
        const now = performance.now()
        v = (event.clientY - last) / Math.max(1, now - lastT)
        last = event.clientY
        lastT = now
        panel.style.translate = `0 ${dy}px`
        // El velo se despeja a medias en proporción a lo que ha bajado el panel: solo filtro, nunca opacidad.
        const t = Math.min(1, dy / panel.offsetHeight) * 0.5
        const filter = `blur(${(8 * (1 - t)).toFixed(2)}px) brightness(${(0.55 + 0.45 * t).toFixed(3)})`
        scrim.style.backdropFilter = filter
        scrim.style.setProperty("-webkit-backdrop-filter", filter)
      })
      const release = () => {
        if (start === null) return
        const dy = last - start
        start = null
        // Con las transiciones activas de nuevo, panel y scrim van de donde
        // estén a su destino (cerrado o abierto) en un solo movimiento.
        drawer.classList.remove("is-dragging")
        void drawer.offsetHeight
        if (dy > 120 || v > 0.6) close()
        panel.style.translate = ""
        scrim.style.backdropFilter = ""
        scrim.style.removeProperty("-webkit-backdrop-filter")
      }
      grip.addEventListener("pointerup", release)
      grip.addEventListener("pointercancel", release)
    }

    root.addEventListener("keydown", (event) => {
      if (!openDrawer) return
      if (event.key === "Escape") {
        event.preventDefault()
        close()
        return
      }
      if (event.key === "Tab") {
        const nodes = focusables(openDrawer)
        if (!nodes.length) return
        const first = nodes[0]
        const lastNode = nodes[nodes.length - 1]
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault()
          lastNode.focus()
        } else if (!event.shiftKey && document.activeElement === lastNode) {
          event.preventDefault()
          first.focus()
        }
      }
    })

    // ── Galería: filtro ─────────────────────────────────────────────────
    const galleryDrawer = root.querySelector<HTMLElement>("#drawer-gallery")
    const filterButtons = [...(galleryDrawer?.querySelectorAll<HTMLButtonElement>("[data-gallery-filter]") ?? [])]
    const galleryItems = [...(galleryDrawer?.querySelectorAll<HTMLElement>(".gallery__item") ?? [])]

    const setFilter = (kind: string) => {
      for (const btn of filterButtons) {
        const on = btn.dataset.galleryFilter === kind
        btn.classList.toggle("chip--active", on)
        btn.setAttribute("aria-pressed", String(on))
      }
      for (const item of galleryItems) item.hidden = kind !== "all" && item.dataset.kind !== kind
    }
    for (const btn of filterButtons) btn.addEventListener("click", () => setFilter(btn.dataset.galleryFilter!))

    const openGallery = (from?: HTMLElement | null) => {
      if (!galleryDrawer) return
      setFilter("all")
      open(galleryDrawer, from)
    }

    const openCase = (slug: string, from?: HTMLElement | null) => {
      const drawer = root.querySelector<HTMLElement>(`#drawer-${slug}`)
      if (!drawer) return
      open(drawer, from)
      history.replaceState(null, "", `#work/${slug}`)
    }

    // ── Visor de imagen: vuela desde la miniatura, fondo desenfocado ────
    type GalleryDatum = { name: string; desc: string; src: string; full: string; ratio: number }
    const galleryData: Record<string, GalleryDatum> = JSON.parse(root.querySelector("[data-gallery-data]")?.textContent ?? "{}")
    const lightbox = root.querySelector<HTMLElement>("[data-lightbox]")
    const lbImg = lightbox?.querySelector<HTMLImageElement>("[data-lightbox-img]")
    const lbName = lightbox?.querySelector<HTMLElement>("[data-lightbox-name]")
    const lbDesc = lightbox?.querySelector<HTMLElement>("[data-lightbox-desc]")
    let lbSource: HTMLElement | null = null
    let lbOpener: HTMLElement | null = null

    type Rect = { left: number; top: number; width: number; height: number }
    const rectOf = (el: Element): Rect => {
      const r = el.getBoundingClientRect()
      return { left: r.left, top: r.top, width: r.width, height: r.height }
    }
    const applyRect = (r: Rect) => {
      if (!lbImg) return
      lbImg.style.left = `${r.left}px`
      lbImg.style.top = `${r.top}px`
      lbImg.style.width = `${r.width}px`
      lbImg.style.height = `${r.height}px`
    }
    // Radio visible de la miniatura: el <img> no lo tiene, lo recorta su
    // contenedor. Se sube por los ancestros hasta encontrarlo; si no, 0.
    const radiusOf = (el: HTMLElement, stopAt: HTMLElement) => {
      let node: HTMLElement | null = el
      while (node) {
        const r = getComputedStyle(node).borderRadius
        if (r && r !== "0px") return r
        if (node === stopAt) break
        node = node.parentElement
      }
      return "0px"
    }
    const targetRect = (ratio: number): Rect => {
      const maxW = Math.min(innerWidth * 0.9, 72 * 16)
      const maxH = innerHeight * 0.78
      let width = maxW
      let height = width / ratio
      if (height > maxH) {
        height = maxH
        width = height * ratio
      }
      return { left: (innerWidth - width) / 2, top: (innerHeight - height) / 2 - 24, width, height }
    }

    const openImage = (id: string, from: HTMLElement) => {
      const datum = galleryData[id]
      if (!lightbox || !lbImg || !datum) return
      const thumb = (from.querySelector("img") ?? from) as HTMLElement
      lbSource = thumb
      lbOpener = from
      // Arranca con la miniatura (ya en caché) y cambia a la grande en cuanto carga.
      lbImg.src = (thumb as HTMLImageElement).currentSrc || datum.src
      lbImg.alt = datum.name
      const large = new Image()
      large.decoding = "async"
      large.onload = () => {
        if (lbSource === thumb && !lightbox.hidden) lbImg.src = datum.full
      }
      large.src = datum.full
      if (lbName) lbName.textContent = datum.name
      if (lbDesc) lbDesc.textContent = datum.desc
      lightbox.hidden = false
      lightbox.classList.remove("is-settled")
      // Arranca exactamente sobre la miniatura y vuela al centro.
      lbImg.style.transition = "none"
      lbImg.style.borderRadius = radiusOf(thumb, from)
      applyRect(rectOf(thumb))
      void lbImg.offsetWidth
      lbImg.style.transition = ""
      lbImg.style.borderRadius = ""
      lightbox.classList.add("is-open")
      applyRect(targetRect(datum.ratio))
      document.documentElement.style.overflow = "hidden"
      setTimeout(() => lightbox.classList.add("is-settled"), reduced ? 0 : 460)
      lightbox.querySelector<HTMLElement>(".lightbox__close")?.focus({ preventScroll: true })
    }

    const closeImage = () => {
      if (!lightbox || !lbImg || lightbox.hidden) return
      lightbox.classList.remove("is-settled")
      lightbox.classList.remove("is-open")
      // Vuelve a donde esté ahora la miniatura (el drawer puede haberse desplazado).
      if (lbSource) {
        applyRect(rectOf(lbSource))
        lbImg.style.borderRadius = radiusOf(lbSource, lbOpener ?? lbSource)
      }
      const done = () => {
        lightbox.hidden = true
        lbImg.removeAttribute("src")
        lbImg.style.borderRadius = ""
        // Si no hay drawer abierto debajo, la página vuelve a desplazarse.
        if (!openDrawer) document.documentElement.style.overflow = ""
      }
      if (reduced) done()
      else setTimeout(done, 480)
      lbOpener?.focus({ preventScroll: true })
    }

    for (const btn of lightbox?.querySelectorAll("[data-lightbox-close]") ?? []) btn.addEventListener("click", closeImage)
    root.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape" && lightbox && !lightbox.hidden) {
          event.preventDefault()
          event.stopPropagation()
          closeImage()
        }
      },
      true,
    )

    const route = (target: HTMLElement) => {
      const [kind, id] = target.dataset.open!.split(":")
      if (kind === "case") openCase(id, target)
      else if (kind === "image") openImage(id, target)
      else if (kind === "gallery") openGallery(target)
    }
    galleryDrawer?.addEventListener("click", (event) => {
      const el = (event.target as HTMLElement).closest<HTMLElement>("[data-open]")
      if (el) route(el)
    })

    canvas.addEventListener("click", (event) => {
      const piece = (event.target as HTMLElement).closest<HTMLElement>("[data-open]")
      if (piece) route(piece)
    })

    // Enlace profundo: /#work/huma abre el caso, al cargar o al cambiar el hash.
    const openFromHash = () => {
      const match = location.hash.match(/^#work\/([\w-]+)$/)
      if (!match) return
      root.scrollIntoView({ block: "start" })
      openCase(match[1], null)
    }
    requestAnimationFrame(openFromHash)
    window.addEventListener("hashchange", openFromHash)
  }
</script>

<style>
  /* ── MacBook ─────────────────────────────────────────────────────────── */
  /* El aire superior lo pone el bento, que cierra su propio bloque con relleno. */
  .work__mac {
    margin-top: 0;
  }

  /* Bisel: negro casi puro, fino, con filo de separador de Apple. */
  .work__screen {
    /* Negro al 30%: el bisel y la muesca se leen como un tinte sobre la página, no como un bloque. */
    --bezel: rgba(0, 0, 0, 0.3);

    position: relative;
    z-index: 1;
    padding: 0.7rem;
    border-radius: 1.6rem;
    background: var(--bezel);
    /* Sin borde: la tapa se separa de la página con sombra, de contacto y de caída. */
    box-shadow:
      0 2px 8px rgba(0, 0, 0, 0.35),
      0 30px 80px -30px rgba(0, 0, 0, 0.9);
  }

  .work__display {
    position: relative;
    height: clamp(22rem, 52vw, 34rem);
    overflow: clip;
    border-radius: 1rem;
    background: var(--page-accent-surface);
    /* Contexto propio: los drawers y el dock se apilan dentro de la pantalla. */
    isolation: isolate;
  }

  .work__notch {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: 4;
    width: clamp(6rem, 14%, 9rem);
    height: 1.25rem;
    translate: -50% 0;
    border-radius: 0 0 0.75rem 0.75rem;
    background: var(--bezel);
    pointer-events: none;
  }

  .work__base {
    display: flex;
    justify-content: center;
    margin-top: calc(-1 * min(11%, 5.75rem));
    padding-bottom: clamp(2rem, 6vh, 3.5rem);
  }

  .work__base img {
    width: min(100%, 52rem);
    height: auto;
    mask-image: radial-gradient(ellipse 70% 80% at 50% 55%, #000 45%, transparent 100%);
  }

  /* ── Lienzo ──────────────────────────────────────────────────────────── */
  .canvas {
    --px: 0px;
    --py: 0px;
    --cluster-scale: 1;

    position: absolute;
    inset: 0;
    cursor: grab;
    touch-action: none;
    user-select: none;
  }

  .canvas.is-panning {
    cursor: grabbing;
  }

  /* Las piezas no reciben eventos mientras se arrastra: no hay hover ni clic accidental. */
  .canvas.is-panning .piece {
    pointer-events: none;
  }

  /* Retícula de puntos, con paralaje a la mitad del desplazamiento. */
  .canvas__dots {
    position: absolute;
    inset: -60%;
    background-image: radial-gradient(circle, var(--line-tint) 1px, transparent 1.6px);
    background-size: 22px 22px;
    translate: calc(var(--px) * 0.5) calc(var(--py) * 0.5);
    mask-image: radial-gradient(ellipse 45% 45% at 50% 50%, #000 40%, transparent 100%);
    pointer-events: none;
  }

  .canvas__layer {
    position: absolute;
    inset: 0;
  }

  .canvas__cluster {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0;
    height: 0;
    translate: var(--px) var(--py);
    scale: var(--cluster-scale);
    will-change: translate;
  }

  /* ── Piezas ──────────────────────────────────────────────────────────── */
  .piece {
    position: absolute;
    left: var(--x);
    top: var(--y);
    display: block;
    width: var(--w);
    height: var(--h);
    padding: 0;
    border: 0;
    background: none;
    translate: -50% -50%;
    cursor: pointer;
    transition: scale 260ms var(--ease-out);
  }

  .piece--static {
    cursor: default;
  }

  .piece:hover,
  .piece:focus-visible {
    scale: 1.06;
    z-index: 2;
