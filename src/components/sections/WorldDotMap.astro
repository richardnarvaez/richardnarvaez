---
// Mapa de puntos decorativo. Se genera en build desde una máscara de tierra
// de baja resolución, así que sale como SVG estático: sin JS, sin Mapbox y
// sin depender de datos externos.
//
// Cada carácter es una celda de ~6° de longitud x ~5° de latitud.
const land = [
  "..........####...........................###................",
  "......#########.......####..........########################",
  ".....############....######.......##########################",
  "....##############...####.......############################",
  "....##############....##........############################",
  ".....#############.............#############################",
  "......###########.............####..########################",
  ".......#########..............####...#######################",
  "........#######...............#####...#####################.",
  ".........####.................######...###################..",
  "..........##.................#######....################....",
  "...........#.................########....#############......",
  "............##...............########.....##########........",
  ".............###.............########......########.........",
  "..............###............########.......#####...........",
  "..............####...........#######.........###............",
  "...............####..........######...........#.............",
  "...............####..........#####.................####.....",
  "...............####..........####.................######....",
  "...............####..........###..................#####.....",
  "................###...........#....................###......",
  "................###................................##.......",
  ".................##.........................................",
  ".................#..........................................",
]

const cols = land[0].length
const rows = land.length
const step = 10
const dots: { x: number; y: number }[] = []

land.forEach((row, y) => {
  Array.from(row).forEach((cell, x) => {
    if (cell === "#") dots.push({ x: x * step + step / 2, y: y * step + step / 2 })
  })
})

// Marcadores de actividad, en coordenadas de la misma rejilla.
const pins = [
  { x: 17, y: 8 },
  { x: 18, y: 13 },
  { x: 30, y: 4 },
  { x: 31, y: 3 },
  { x: 33, y: 5 },
  { x: 44, y: 6 },
  { x: 50, y: 18 },
].map((p) => ({ x: p.x * step + step / 2, y: p.y * step + step / 2 }))
---

<svg
  class="world-map"
  viewBox={`0 0 ${cols * step} ${rows * step}`}
  fill="none"
  aria-hidden="true"
  preserveAspectRatio="xMidYMid meet"
>
  {dots.map((d) => <circle cx={d.x} cy={d.y} r="1.7" class="world-map__dot" />)}
  {
    pins.map((p) => (
      <>
        <circle cx={p.x} cy={p.y} r="9" class="world-map__glow" />
        <circle cx={p.x} cy={p.y} r="2.8" class="world-map__pin" />
      </>
    ))
  }
</svg>

<style>
  .world-map {
    width: 100%;
    height: 100%;
  }

  .world-map__dot {
    fill: rgba(148, 163, 184, 0.22);
  }

  .world-map__glow {
    fill: rgba(139, 92, 246, 0.16);
  }

  .world-map__pin {
    fill: #a78bfa;
  }
</style>
