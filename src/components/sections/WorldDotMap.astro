---
// Mapa de puntos decorativo, generado en build desde una máscara de tierra
// real: Natural Earth 110m rasterizado a celdas de 3° (120 × 47, sin
// Antártida). Nada de esto llega al cliente: solo el SVG resultante.
//
// Rendimiento: los ~1700 puntos no son <circle> sino UN solo <path> hecho de
// segmentos de longitud ~0 con `stroke-linecap: round`. Un nodo DOM en vez
// de miles, y el navegador lo pinta de una pasada.
//
// Para regenerar la máscara con otra resolución o recorte:
// scripts/rasterize-land.mjs (point-in-polygon sobre el GeoJSON de Natural Earth).

interface Props {
  /** Ventana visible, en grados. Por defecto, todo el mapa. */
  lonMin?: number
  lonMax?: number
  latMin?: number
  latMax?: number
}

const COLS = 120
const STEP_DEG = 3
const LAT_MAX = 84

// Una celda = UNIT unidades del viewBox; el punto va en el centro.
const UNIT = 10

const land = [
  "...............................########.....#########...................................................................",
  "............................#######...################..........##.#.......................##...........................",
  "...................##..#..#.######...################.............................#...........###.......................",
  "...................##...#.#####.##.......############.........................#........#############.#.....#............",
  "......####............####..#.#######.....#########.................##............##.############################.......",
  "#....############################.#.###...#######................#########..########.###################################",
  "......###########################.####.....###.......##.........###.###################################################.",
  ".....########################.....##........##................####.#############################################.#.###..",
  "........#.....###############.....###.#...................#...#.##..#######################################......#......",
  "................###############...######..................#.....#..######################################.......##......",
  ".................################.#######................#.#################################################....#.......",
  "...................###################.....................#################################################............",
  "...................###################.....................###########.#.####.############################.#............",
  "...................##################....................#.###.######....###.############################..#............",
  "...................################......................###.....###..#######.######################.##.................",
  "...................################......................###....#..#.########.#######################.#...#.............",
  "....................##############........................#####.........############################....##..............",
  ".....................############........................########..##...#############################..#................",
  ".......................#####....#.......................###############.####.########################...................",
  "........................####...........................######################...####################....................",
  ".........................##......#.....................#################.#######...#######.#######......................",
  ".........................###..#.....#..................#################..#####.....####...####.#.......................",
  "...........................####.......................###################.####......###....#####....#...................",
  "..............................##......................######################.........##......###........................",
  "...............................#...###.#...............######################........##........#........................",
  "..................................######................#####################........................#..................",
  "..................................#########..............#....##############................#.....##....................",
  "..................................#########....................############..................##.###.....................",
  ".................................############..................###########....................#..##.#...#...............",
  ".................................##############.................#########.....................#..........###............",
  ".................................###############................#########.......................##........###...........",
  "..................................##############................#########...............................................",
  "...................................############.................##########..#..........................##..#............",
  "....................................###########.................#########..##........................#####.##...........",
  ".....................................##########.................########...#........................#########...........",
  ".....................................#########...................#######..##......................############..........",
  "....................................########.....................######...........................#############.........",
  "....................................########.....................######...........................#############.........",
  "....................................#######.......................####.............................############.........",
  "....................................######........................#................................#......####..........",
  "...................................######..................................................................###........#.",
  "...................................####...............................................................................#.",
  "....................................##...............................................................................#..",
  "...................................###..............................................................................#...",
  "...................................##...................................................................................",
  "...................................##...................................................................................",
  "........................................................................................................................",
]

const ROWS = land.length
const width = COLS * UNIT
const LAT_MIN = LAT_MAX - ROWS * STEP_DEG

const {
  lonMin = -180,
  lonMax = 180,
  latMin = LAT_MIN,
  latMax = LAT_MAX,
} = Astro.props

const project = ({ lat, lon }: { lat: number; lon: number }) => ({
  x: ((lon + 180) / 360) * width,
  y: ((LAT_MAX - lat) / STEP_DEG) * UNIT,
})

// Ventana del viewBox a partir del recorte en grados.
const topLeft = project({ lat: latMax, lon: lonMin })
const bottomRight = project({ lat: latMin, lon: lonMax })
const viewBox = [
  topLeft.x,
  topLeft.y,
  bottomRight.x - topLeft.x,
  bottomRight.y - topLeft.y,
]
  .map((n) => Math.round(n * 10) / 10)
  .join(" ")

// "M x y h.1" por punto: el .1 evita que algún motor descarte un segmento de
// longitud exactamente cero antes de aplicarle el linecap redondo.
// Solo se emiten los puntos dentro de la ventana: el resto no se vería y
// solo engordaría el HTML.
let dotsPath = ""
land.forEach((row, r) => {
  const lat = LAT_MAX - (r + 0.5) * STEP_DEG
  if (lat < latMin || lat > latMax) return
  for (let c = 0; c < COLS; c++) {
    if (row[c] !== "#") continue
    const lon = -180 + (c + 0.5) * STEP_DEG
    if (lon < lonMin || lon > lonMax) continue
    dotsPath += `M${c * UNIT + UNIT / 2} ${r * UNIT + UNIT / 2}h.1`
  }
})

// Marcadores de actividad en lat/lon reales. Editar aquí.
const places = [
  { name: "Quito", lat: -0.18, lon: -78.47 },
  { name: "Lima", lat: -12.05, lon: -77.04 },
  { name: "Mexico City", lat: 19.43, lon: -99.13 },
  { name: "Miami", lat: 25.76, lon: -80.19 },
  { name: "New York", lat: 40.71, lon: -74.01 },
  { name: "Madrid", lat: 40.42, lon: -3.7 },
  { name: "Paris", lat: 48.86, lon: 2.35 },
]

const pins = places
  .filter((p) => p.lon >= lonMin && p.lon <= lonMax && p.lat >= latMin && p.lat <= latMax)
  .map((p) => ({ ...p, ...project(p) }))
---

<svg
  class="world-map"
  viewBox={viewBox}
  fill="none"
  aria-hidden="true"
  preserveAspectRatio="xMidYMid meet"
>
  <path class="world-map__dots" d={dotsPath} />
  {
    pins.map((p) => (
      <g data-place={p.name}>
        <circle cx={p.x} cy={p.y} r="14" class="world-map__glow" />
        <circle cx={p.x} cy={p.y} r="4.2" class="world-map__pin" />
      </g>
    ))
  }
</svg>

<style>
  .world-map {
    width: 100%;
    height: 100%;
  }

  /* El grosor del trazo es el diámetro del punto; el linecap lo hace redondo. */
  .world-map__dots {
    stroke: rgba(148, 163, 184, 0.3);
    stroke-width: 4.2;
    stroke-linecap: round;
  }

  .world-map__glow {
    fill: rgba(139, 92, 246, 0.22);
  }

  .world-map__pin {
    fill: #a78bfa;
  }
</style>
