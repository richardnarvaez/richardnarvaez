---
// Decorative dot map, built from a real land mask (Natural Earth 110m in 3°
// cells). None of that reaches the client, only the resulting SVG.
//
// The ~1700 dots are a single <path> of zero-length segments with round
// linecaps, not <circle> elements: one DOM node instead of thousands.
//
// To regenerate the mask at another resolution: scripts/rasterize-land.mjs

interface Props {
  /* Visible window in degrees. Defaults to the whole map. */
  lonMin?: number
  lonMax?: number
  latMin?: number
  latMax?: number
}

const COLS = 120
const STEP_DEG = 3
const LAT_MAX = 84

// One cell = UNIT viewBox units; the dot sits at its centre.
const UNIT = 10

const land = [
  "...............................########.....#########...................................................................",
  "............................#######...################..........##.#.......................##...........................",
  "...................##..#..#.######...################.............................#...........###.......................",
  "...................##...#.#####.##.......############.........................#........#############.#.....#............",
  "......####............####..#.#######.....#########.................##............##.############################.......",
  "#....############################.#.###...#######................#########..########.###################################",
  "......###########################.####.....###.......##.........###.###################################################.",
  ".....########################.....##........##................####.#############################################.#.###..",
  "........#.....###############.....###.#...................#...#.##..#######################################......#......",
  "................###############...######..................#.....#..######################################.......##......",
  ".................################.#######................#.#################################################....#.......",
  "...................###################.....................#################################################............",
  "...................###################.....................###########.#.####.############################.#............",
  "...................##################....................#.###.######....###.############################..#............",
  "...................################......................###.....###..#######.######################.##.................",
  "...................################......................###....#..#.########.#######################.#...#.............",
  "....................##############........................#####.........############################....##..............",
  ".....................############........................########..##...#############################..#................",
  ".......................#####....#.......................###############.####.########################...................",
  "........................####...........................######################...####################....................",
  ".........................##......#.....................#################.#######...#######.#######......................",
  ".........................###..#.....#..................#################..#####.....####...####.#.......................",
  "...........................####.......................###################.####......###....#####....#...................",
  "..............................##......................######################.........##......###........................",
  "...............................#...###.#...............######################........##........#........................",
  "..................................######................#####################........................#..................",
  "..................................#########..............#....##############................#.....##....................",
  "..................................#########....................############..................##.###.....................",
  ".................................############..................###########....................#..##.#...#...............",
  ".................................##############.................#########.....................#..........###............",
  ".................................###############................#########.......................##........###...........",
  "..................................##############................#########...............................................",
  "...................................############.................##########..#..........................##..#............",
  "....................................###########.................#########..##........................#####.##...........",
  ".....................................##########.................########...#........................#########...........",
  ".....................................#########...................#######..##......................############..........",
  "....................................########.....................######...........................#############.........",
  "....................................########.....................######...........................#############.........",
  "....................................#######.......................####.............................############.........",
  "....................................######........................#................................#......####..........",
  "...................................######..................................................................###........#.",
  "...................................####...............................................................................#.",
  "....................................##...............................................................................#..",
  "...................................###..............................................................................#...",
  "...................................##...................................................................................",
  "...................................##...................................................................................",
  "........................................................................................................................",
]

const ROWS = land.length
const width = COLS * UNIT
const LAT_MIN = LAT_MAX - ROWS * STEP_DEG

const {
  lonMin = -180,
  lonMax = 180,
  latMin = LAT_MIN,
  latMax = LAT_MAX,
} = Astro.props

const project = ({ lat, lon }: { lat: number; lon: number }) => ({
  x: ((lon + 180) / 360) * width,
  y: ((LAT_MAX - lat) / STEP_DEG) * UNIT,
})

// viewBox window derived from the crop in degrees.
const topLeft = project({ lat: latMax, lon: lonMin })
const bottomRight = project({ lat: latMin, lon: lonMax })
const viewBox = [
  topLeft.x,
  topLeft.y,
  bottomRight.x - topLeft.x,
  bottomRight.y - topLeft.y,
]
  .map((n) => Math.round(n * 10) / 10)
  .join(" ")

// "M x y h.1" per dot: the .1 stops an engine discarding a zero-length segment
// before applying the round linecap. Only dots inside the window are emitted.
let dotsPath = ""
land.forEach((row, r) => {
  const lat = LAT_MAX - (r + 0.5) * STEP_DEG
  if (lat < latMin || lat > latMax) return
  for (let c = 0; c < COLS; c++) {
    if (row[c] !== "#") continue
    const lon = -180 + (c + 0.5) * STEP_DEG
    if (lon < lonMin || lon > lonMax) continue
    dotsPath += `M${c * UNIT + UNIT / 2} ${r * UNIT + UNIT / 2}h.1`
  }
})

// Activity markers in real lat/lon. Edit here.
const places = [
  { name: "Quito", lat: -0.18, lon: -78.47 },
  { name: "Lima", lat: -12.05, lon: -77.04 },
  { name: "Mexico City", lat: 19.43, lon: -99.13 },
  { name: "Miami", lat: 25.76, lon: -80.19 },
  { name: "New York", lat: 40.71, lon: -74.01 },
  { name: "Madrid", lat: 40.42, lon: -3.7 },
  { name: "Paris", lat: 48.86, lon: 2.35 },
]

const pins = places
  .filter((p) => p.lon >= lonMin && p.lon <= lonMax && p.lat >= latMin && p.lat <= latMax)
  .map((p) => ({ ...p, ...project(p) }))
---

<svg
  class="world-map"
  viewBox={viewBox}
  fill="none"
  aria-hidden="true"
  preserveAspectRatio="xMidYMid meet"
>
  <path class="world-map__dots" d={dotsPath} />
  {
    pins.map((p) => (
      <g data-place={p.name}>
        <circle cx={p.x} cy={p.y} r="14" class="world-map__glow" />
        <circle cx={p.x} cy={p.y} r="4.2" class="world-map__pin" />
      </g>
    ))
  }
</svg>

<style>
  .world-map {
    width: 100%;
    height: 100%;
  }

  /* Stroke width is the dot diameter; the linecap makes it round. */
  .world-map__dots {
    stroke: rgba(139, 126, 210, 0.32); /* variante clara del fondo, no gris */
    stroke-width: 4.2;
    stroke-linecap: round;
  }

  .world-map__glow {
    fill: rgba(139, 92, 246, 0.22);
  }

  .world-map__pin {
    fill: #a78bfa;
  }
</style>
