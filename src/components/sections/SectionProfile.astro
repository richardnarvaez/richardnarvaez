---
import BlueprintSection from "../layout/BlueprintSection.astro"
import BlueprintDivider from "../layout/BlueprintDivider.astro"
import WorldDotMap from "./WorldDotMap.astro"
import BrandMark from "../icons/BrandMark.astro"
import LaurelAward from "../icons/LaurelAward.astro"
import { siteName, socialLinks } from "../../site.config"

// Los seis logos vienen de IconsBusiness.tsx (rama v1), no son redibujos.
const certifications = ["google", "aws", "harvard", "hackerrank", "cisco", "linkedin"] as const

const awards = [
  { title: "Hackathon", detail: "1st place, AI Challenge", scope: "National" },
  { title: "Code Challenge", detail: "1st place, 2023", scope: "Regional" },
  { title: "UISEK Hackathon", detail: "Finalists, 2022", scope: "National" },
]
---

<BlueprintSection id="profile" class="profile" label="01 — profile">
  {/* Solo Américas + Europa/África por ahora: sin Asia hasta que haya viaje. */}
  <div class="profile__map" aria-hidden="true">
    <WorldDotMap lonMin={-125} lonMax={40} latMin={-56} latMax={75} />
  </div>

  <div class="profile__content">
    <div class="profile__avatar">
      <span class="profile__avatar-sheet profile__avatar-sheet--back" aria-hidden="true"></span>
      <span class="profile__avatar-sheet profile__avatar-sheet--mid" aria-hidden="true"></span>
      <img
        src="/images/avatars/richard.jpg"
        width="250"
        height="250"
        loading="lazy"
        decoding="async"
        alt={siteName}
      />
    </div>

    <h2 class="profile__name">{siteName}</h2>

    <ul class="profile__meta font-jetbrains">
      <li>
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <rect x="2" y="4" width="20" height="13" rx="2"></rect>
          <path d="M2 20h20"></path>
        </svg>
        Product Engineer
      </li>
      <li>
        <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        EU / LATAM / CA <span class="profile__meta-note">(Work Permit)</span>
      </li>
    </ul>

    <p class="profile__bio">
      Software Engineer with 5+ years of professional experience and 12+ years
      programming. Passionate about traveling and naturally curious. Currently,
      I am focused on becoming a great leader and continuing to share.
    </p>

    <h3 class="profile__eyebrow">Certifications &amp; rewards</h3>

    <ul class="profile__certs">
      {
        certifications.map((name) => (
          <li class="profile__cert">
            <BrandMark name={name} class="profile__cert-mark" />
          </li>
        ))
      }
    </ul>

    <div class="profile__actions">
      <a class="btn btn--solid" href={socialLinks.linkedin} target="_blank" rel="noreferrer noopener">
        See on Linkedin
      </a>
      <a class="btn btn--ghost" href={socialLinks.github} target="_blank" rel="noreferrer noopener">
        Github
      </a>
    </div>
  </div>

  <div class="profile__divider">
    <BlueprintDivider />
  </div>

  <ul class="profile__awards">
    {
      awards.map((award) => (
        <li class="award">
          <LaurelAward>
            <p class="award__title">{award.title}</p>
            <p class="award__detail">{award.detail}</p>
            <span class="award__scope font-jetbrains">{award.scope}</span>
          </LaurelAward>
        </li>
      ))
    }
  </ul>
</BlueprintSection>

<style>
  /*
    Sin overflow en la sección a propósito: un `hidden` la convertiría en
    contenedor de scroll y rompería la view-timeline del nombre. El mapa ya
    va enmascarado y el desborde horizontal lo recorta body (global.css).
  */

  /*
    Mapa anclado a la esquina superior derecha, arrancando justo en la unión
    con el hero. Se desvanece hacia la izquierda y hacia abajo para que no
    compita con el texto.
  */
  .profile__map {
    position: absolute;
    top: 0;
    right: 0; /* al ras del riel, no del gutter: evita un segundo borde vertical */
    z-index: 0;
    width: min(44%, 30rem);
    aspect-ratio: 165 / 131; /* grados de la ventana pasada a WorldDotMap */
    opacity: 0.85;
    mask-image:
      linear-gradient(to left, black 60%, transparent 100%),
      linear-gradient(to top, transparent 0%, black 30%);
    mask-composite: intersect;
    pointer-events: none;
  }

  /* En móvil queda detrás del texto: más tenue para no competir con él. */
  @media (max-width: 640px) {
    .profile__map {
      width: 90%;
      opacity: 0.4;
    }
  }

  .profile__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-block: clamp(3.5rem, 9vh, 6rem) 0;
  }

  /* Avatar como pila de fotos ligeramente giradas. */
  .profile__avatar {
    position: relative;
    width: 6rem;
    height: 6rem;
  }

  .profile__avatar img,
  .profile__avatar-sheet {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 1.1rem;
    border: 3px solid #fff;
    background: #fff;
    object-fit: cover;
  }

  .profile__avatar-sheet--back {
    transform: rotate(-9deg) translate(-6px, 2px);
    opacity: 0.35;
  }

  .profile__avatar-sheet--mid {
    transform: rotate(-4deg) translate(-3px, 1px);
    opacity: 0.6;
  }

  .profile__avatar img {
    transform: rotate(2deg);
    box-shadow: 0 18px 40px rgba(2, 6, 23, 0.45);
  }

  /*
    Publica su posición como --profile-name (la consume StickyName) y, al
    salir por arriba, se encoge y se apaga: la barra fija recoge el relevo.
  */
  .profile__name {
    margin: 1.6rem 0 0;
    font-family: var(--font-bellota);
    font-size: clamp(1.5rem, 3.4vw, 2rem);
    font-weight: 700;
    color: #fff;
    view-timeline: --profile-name block;
    transform-origin: top center;
    animation: profileNameOut linear both;
    animation-timeline: view();
    /*
      Se apaga mientras atraviesa la zona de la barra fija (5.5rem de alto):
      empieza cuando su borde superior toca el borde inferior de la barra y
      ha desaparecido un poco antes de llegar arriba.
    */
    animation-range: exit -5.5rem exit -0.75rem;
  }

  @keyframes profileNameOut {
    from {
      scale: 1;
      opacity: 1;
    }
    to {
      scale: 0.5;
      opacity: 0;
    }
  }

  @supports not (animation-timeline: view()) {
    .profile__name {
      animation: none;
    }
  }

  .profile__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem 1.4rem;
    margin: 0.7rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.72rem;
    color: rgb(var(--text-rgb) / 0.62);
  }

  .profile__meta li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* Aclaración en tono más bajo: permiso de trabajo en las tres regiones. */
  .profile__meta-note {
    color: rgb(var(--text-rgb) / 0.4);
  }

  .profile__bio {
    max-width: 40rem;
    margin: 1.9rem 0 0;
    font-size: 1.02rem;
    line-height: 1.65;
    color: rgb(var(--text-rgb) / 0.78);
  }

  .profile__eyebrow {
    margin: 2.9rem 0 0;
    font-family: var(--font-bellota);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--text-rgb) / 0.72);
  }

  .profile__certs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 1.4rem 2.6rem;
    margin: 1.9rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* --brand-mark-size lo consume BrandMark; el color baja por currentColor. */
  .profile__cert {
    --brand-mark-size: 2.2rem;
    display: flex;
    color: rgba(255, 255, 255, 0.82);
    transition:
      color 200ms ease,
      transform 200ms ease;
  }

  .profile__cert:hover {
    color: #fff;
    transform: translateY(-2px);
  }

  .profile__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 2.1rem;
  }

  .profile__divider {
    position: relative;
    z-index: 1;
    margin-top: clamp(3.5rem, 9vh, 6rem);
  }

  .profile__awards {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem 3.2rem;
    margin: 0;
    padding: clamp(2.5rem, 6vh, 4rem) 0 clamp(3rem, 8vh, 5rem);
    list-style: none;
  }

  .award {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .award__laurel {
    width: 1.9rem;
    height: 3.5rem;
    flex: none;
    color: rgba(255, 255, 255, 0.75);
  }

  .award__laurel--flip {
    transform: scaleX(-1);
  }

  .award__body {
    text-align: center;
  }

  .award__title {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .award__detail {
    margin: 0.15rem 0 0;
    font-size: 0.82rem;
    color: rgb(var(--text-rgb) / 0.7);
  }

  .award__scope {
    display: inline-block;
    margin-top: 0.35rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    padding: 0.12rem 0.5rem;
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    color: rgb(var(--text-rgb) / 0.62);
  }

  @media (max-width: 640px) {
    .profile__awards {
      gap: 1.6rem;
    }

    .award__laurel {
      width: 1.5rem;
      height: 2.8rem;
    }
  }
</style>
