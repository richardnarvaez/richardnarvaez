---
// Lab showcase: six entries, the featured ones plus the most recent. Each card
// opens its MDX in a drawer; the full list is a page at /lab.
import BlueprintSection from "../layout/BlueprintSection.astro"
import SectionHeader from "../layout/SectionHeader.astro"
import WorkDrawer from "../work/WorkDrawer.astro"
import LabCard from "../lab/LabCard.astro"
import LabEntry from "../lab/LabEntry.astro"
import CaseStudy from "../case/CaseStudy.astro"
import { caseOf, hrefOf, labEntries, pickFeatured } from "../lab/lab"

const entries = await labEntries()
const featured = pickFeatured(entries, 6)
// Prototypes that are a Work case read from that case: one MDX, not two.
const studies = new Map(
  await Promise.all(featured.map(async (entry) => [entry.id, await caseOf(entry)] as const)),
)
---

<BlueprintSection id="lab" class="lab" label="04 — lab" ariaLabelledby="lab-title">
  <div class="lab__body">
    <SectionHeader
      claim="Teaching is learning twice."
      badge="In development"
      context="Prototypes built for real, and behind them the system design and the interview exercises, solved step by step in my own words."
      titleId="lab-title"
    />

    {
      featured.length > 0 ? (
        <div class="lab__grid">{featured.map((entry) => <LabCard entry={entry} drawer />)}</div>
      ) : (
        <p class="lab__empty">The first entries are being written.</p>
      )
    }

    {
      entries.length > 0 && (
        <div class="lab__actions">
          <a class="btn btn--ghost" href="/lab">
            See all <span class="lab__count num">{entries.length}</span>
          </a>
        </div>
      )
    }

    {/* Drawers: one per highlight, fixed full screen. */}
    {
      featured.map((entry) => {
        const study = studies.get(entry.id)
        return (
          <WorkDrawer id={`drawer-lab-${entry.id}`} labelledby={`lab-${entry.id}-title`}>
            {study ? (
              <CaseStudy entry={study} headingLevel="h2" titleId={`lab-${entry.id}-title`} />
            ) : (
              <LabEntry entry={entry} headingLevel="h2" titleId={`lab-${entry.id}-title`} />
            )}
            <p class="lab__fullpage">
              <a class="btn btn--ghost btn--sm" href={study ? `/work/${study.id}` : hrefOf(entry)}>
                Open as a page
              </a>
            </p>
          </WorkDrawer>
        )
      })
    }
  </div>
</BlueprintSection>

<script>
  import { initDrawers } from "../../scripts/drawers"

  const root = document.querySelector<HTMLElement>("#lab")

  if (root) {
    const drawers = initDrawers(root, {
      onClose: () => {
        if (location.hash.startsWith("#lab/")) history.replaceState(null, "", "#lab")
      },
    })

    const openEntry = (slug: string, from?: HTMLElement | null) => {
      const drawer = root.querySelector<HTMLElement>(`#drawer-lab-${slug}`)
      if (!drawer) return false
      drawers.open(drawer, from)
      history.replaceState(null, "", `#lab/${slug}`)
      return true
    }

    // Cards open the drawer; without JS they follow their href.
    root.addEventListener("click", (event) => {
      const card = (event.target as HTMLElement).closest<HTMLElement>('[data-open^="lab:"]')
      if (!card) return
      const slug = card.dataset.open!.slice(4)
      if (openEntry(slug, card)) event.preventDefault()
    })

    // Deep link: /#lab/slug opens the entry, on load or on hash change.
    const openFromHash = () => {
      const match = location.hash.match(/^#lab\/([\w-]+)$/)
      if (!match) return
      root.scrollIntoView({ block: "start" })
      openEntry(match[1], null)
    }
    requestAnimationFrame(openFromHash)
    window.addEventListener("hashchange", openFromHash)
  }
</script>

<style>
  .lab__body {
    padding: clamp(2.5rem, 6vh, 4rem) var(--bp-gutter) clamp(3rem, 7vh, 4.5rem);
  }

  .lab__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .lab__empty {
    margin: 0;
    text-align: center;
    color: rgb(var(--text-rgb) / 0.5);
  }

  .lab__actions {
    display: flex;
    justify-content: center;
    margin-top: 2.25rem;
  }

  .lab__count {
    margin-left: 0.35rem;
    color: rgb(var(--text-rgb) / 0.55);
  }

  .lab__fullpage {
    margin: 2.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px dashed var(--bp-line);
  }

  @media (max-width: 900px) {
    .lab__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .lab__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
