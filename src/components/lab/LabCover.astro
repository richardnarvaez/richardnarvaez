---
// 4:3 cover for a Lab entry, in the blueprint language of the rest of the page.
// Composed from the frontmatter when the entry brings no image.
import { getEntry } from "astro:content"
import GradualBlur from "../ui/GradualBlur.astro"
import { isUnsolved, KIND_LABEL, type LabEntry } from "./lab"

interface Props {
  entry: LabEntry
  class?: string
  /* No hover blur or expand: for long lists, where they would cost. */
  fade?: boolean
}

const { entry, class: className, fade = true } = Astro.props
const { data } = entry
// Prototype that is the same app as a Work case: shares icon and colour.
const app = data.app ? await getEntry("work", data.app) : undefined
const icon = data.icon ?? app?.data.icon
const tint = app?.data.tint
const boxes = (data.tags.length >= 3 ? data.tags.slice(0, 3) : ["Client", "Service", "Store"]).map((t) => t.slice(0, 12))
const device = data.shots[0]?.frame === "phone" ? "phone" : "web"
// Exercise cells: an indexed row with one marked in orange.
const cells = 7
const hot = 4
---

<div class:list={["cover", `cover--${data.kind}`, className]} aria-hidden="true">
  <span class="cover__mark cover__mark--tl"></span>
  <span class="cover__mark cover__mark--tr"></span>
  <span class="cover__mark cover__mark--bl"></span>
  <span class="cover__mark cover__mark--br"></span>

  {
    data.cover ? (
      <img class="cover__img" src={data.cover} alt="" loading="lazy" decoding="async" />
    ) : (
      <>
        <span class="cover__kind label">
          {KIND_LABEL[data.kind]}
          {data.difficulty && <span class="cover__level">· {data.difficulty}</span>}
          {isUnsolved(entry) && <span class="cover__todo">· to solve</span>}
        </span>

        {data.kind === "exercise" && (
          <>
            <svg class="cover__figure" viewBox="0 0 320 96" fill="none">
              {Array.from({ length: cells }, (_, i) => (
                <>
                  <rect x={8 + i * 44} y="30" width="36" height="36" rx="2" stroke={i === hot ? "var(--page-accent)" : "var(--ink)"} stroke-width={i === hot ? 1.5 : 1} fill={i === hot ? "rgb(var(--accent-rgb) / 0.12)" : "none"} />
                  <text x={26 + i * 44} y="20" text-anchor="middle" fill="var(--ink-text)" font-size="9" font-family="var(--font-mono)">
                    {i}
                  </text>
                </>
              ))}
              <path d={`M${26 + hot * 44} 66 V84 H${26}`} stroke="var(--page-accent)" stroke-width="1" stroke-dasharray="3 3" />
              <path d="M26 84 V70" stroke="var(--page-accent)" stroke-width="1" marker-end="url(#lab-arrow)" />
              <defs>
                <marker id="lab-arrow" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="6" markerHeight="6" orient="auto">
                  <path d="M0 0 8 4 0 8" fill="var(--page-accent)" />
                </marker>
              </defs>
            </svg>
          </>
        )}

        {data.kind === "system" && (
          <>
            <svg class="cover__figure cover__figure--system" viewBox="0 0 320 110" fill="none">
              {boxes.map((label, i) => (
                <>
                  <rect x={10 + i * 108} y="30" width="90" height="48" rx="2" stroke={i === 1 ? "var(--page-accent)" : "var(--ink)"} stroke-width={i === 1 ? 1.5 : 1} fill={i === 1 ? "rgb(var(--accent-rgb) / 0.1)" : "none"} />
                  <text x={55 + i * 108} y="58" text-anchor="middle" fill="var(--ink-text)" font-size="11" font-family="var(--font-mono)">
                    {label}
                  </text>
                  {i < boxes.length - 1 && <path d={`M${100 + i * 108} 54 H${116 + i * 108}`} stroke="var(--ink)" stroke-width="1" stroke-dasharray="3 3" marker-end="url(#lab-arrow-s)" />}
                </>
              ))}
              <defs>
                <marker id="lab-arrow-s" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
                  <path d="M0 0 8 4 0 8" fill="var(--ink)" />
                </marker>
              </defs>
            </svg>
          </>
        )}

        {data.kind === "prototype" && (
          <>
            {icon ? (
              <span class="cover__app" style={tint ? `background: ${tint};` : undefined}>
                <img src={icon} alt="" loading="lazy" decoding="async" />
              </span>
            ) : data.figure ? (
              <svg class="cover__figure cover__figure--draw" viewBox="0 0 320 110" fill="none" stroke-linecap="round" stroke-linejoin="round">
                {data.figure === "brain" && (
                  <>
                    {/* Cards drift around the head: on an infinite canvas the layout is the thinking. */}
                    {[
                      { x: 30, y: 22, to: 108, hot: false },
                      { x: 26, y: 72, to: 120, hot: false },
                      { x: 260, y: 28, to: 212, hot: true },
                      { x: 264, y: 74, to: 200, hot: false },
                    ].map((c) => (
                      <>
                        <rect x={c.x} y={c.y} width="30" height="18" rx="2" stroke={c.hot ? "var(--page-accent)" : "var(--ink)"} fill={c.hot ? "rgb(var(--accent-rgb) / 0.12)" : "none"} />
                        <path d={`M${c.x < 160 ? c.x + 30 : c.x} ${c.y + 9} H${c.to}`} stroke="var(--ink)" stroke-dasharray="3 3" opacity="0.7" />
                      </>
                    ))}
                    <g stroke="var(--ink)">
                      <path d="M160 13 C150 9 138 15 136 23 C124 20 112 28 112 38 C100 42 96 56 104 64 C98 74 106 88 118 88 C122 98 138 102 148 96 C152 100 156 100 160 99" />
                      <path d="M160 13 C170 9 182 15 184 23 C196 20 208 28 208 38 C220 42 224 56 216 64 C222 74 214 88 202 88 C198 98 182 102 172 96 C168 100 164 100 160 99" />
                      <path d="M160 13 V99" />
                    </g>
                    <g stroke="var(--ink)" opacity="0.72">
                      <path d="M150 24 C134 30 128 42 132 52 C136 62 130 74 142 82" />
                      <path d="M138 40 C128 46 126 56 134 62" />
                      <path d="M148 66 C140 72 142 80 150 84" />
                      <path d="M170 24 C186 30 192 42 188 52 C184 62 190 74 178 82" />
                      <path d="M182 40 C192 46 194 56 186 62" />
                      <path d="M172 66 C180 72 178 80 170 84" />
                    </g>
                  </>
                )}

                {data.figure === "globe" && (
                  <>
                    {/* Two stamps flank the globe; the lit marker is the place you opened. */}
                    <g stroke="var(--ink)" opacity="0.85">
                      <g transform="rotate(-8 47 55)">
                        <rect x="26" y="34" width="42" height="42" rx="2" stroke-dasharray="1.5 4" />
                        <rect x="31" y="39" width="32" height="32" rx="1" opacity="0.5" />
                        <circle cx="38" cy="47" r="3.5" opacity="0.8" />
                        <path d="M34 65 L43 51 L51 65 M47 65 L54 56 L61 65" opacity="0.8" />
                      </g>
                      <g transform="rotate(7 273 57)">
                        <rect x="252" y="36" width="42" height="42" rx="2" stroke-dasharray="1.5 4" />
                        <rect x="257" y="41" width="32" height="32" rx="1" opacity="0.5" />
                        <circle cx="264" cy="49" r="3.5" opacity="0.8" />
                        <path d="M260 67 L269 53 L277 67 M273 67 L280 58 L287 67" opacity="0.8" />
                      </g>
                    </g>
                    <g stroke="var(--ink)">
                      <circle cx="160" cy="55" r="42" />
                      <ellipse cx="160" cy="55" rx="42" ry="14" />
                      <ellipse cx="160" cy="37" rx="30" ry="9" />
                      <ellipse cx="160" cy="73" rx="30" ry="9" />
                      <ellipse cx="160" cy="55" rx="14" ry="42" />
                      <ellipse cx="160" cy="55" rx="28" ry="42" />
                      <path d="M160 13 V97" />
                    </g>
                    <rect x="139" y="37" width="6" height="6" fill="var(--ink)" stroke="none" />
                    <rect x="147" y="75" width="6" height="6" fill="var(--ink)" stroke="none" />
                    <rect x="173" y="59" width="7" height="7" fill="var(--page-accent)" stroke="none" />
                    <path d="M176 59 V30" stroke="var(--page-accent)" stroke-dasharray="3 3" />
                    <circle cx="176" cy="27" r="3" fill="var(--page-accent)" stroke="none" />
                  </>
                )}

                {data.figure === "input" && (
                  <>
                    {/* The field waits, the spinner turns, and one event out of the burst survives. */}
                    <rect x="60" y="20" width="200" height="34" rx="3" stroke="var(--ink)" />
                    <path d="M76 29 V45" stroke="var(--page-accent)" />
                    <path d="M86 37 H154" stroke="var(--ink)" opacity="0.7" />
                    <path d="M238 28 A9 9 0 1 1 229 37" stroke="var(--page-accent)" stroke-width="1.5" />
                    <path d="M60 90 H260" stroke="var(--ink)" stroke-dasharray="3 3" opacity="0.7" />
                    <g stroke="var(--ink)">
                      {[70, 84, 92, 108, 114, 130, 150, 168].map((x) => <path d={`M${x} 76 V90`} />)}
                    </g>
                    <path d="M168 83 H206" stroke="var(--page-accent)" stroke-dasharray="3 3" opacity="0.8" />
                    <path d="M210 68 V90" stroke="var(--page-accent)" stroke-width="1.5" />
                  </>
                )}
              </svg>
            ) : (
              <div class:list={["cover__device", `cover__device--${device}`]}>
                <span class="cover__screen"></span>
              </div>
            )}
          </>
        )}

        {/* Footer: always the title; summary and chips rise over it on hover. */}
        {fade && <GradualBlur position="bottom" height="42%" strength={1.4} divCount={5} curve="ease-in" zIndex={1} class="cover__fade" />}
        <div class="cover__foot">
          <span class="cover__title">{data.title}</span>
          <div class:list={["cover__more", { "cover__more--static": !fade }]}>
            <div class="cover__more-inner">
              <span class="cover__summary">{data.summary}</span>
              {data.complexity && (
                <span class="cover__chips label">
                  <span>time {data.complexity.time}</span>
                  <span>space {data.complexity.space}</span>
                </span>
              )}
            </div>
          </div>
        </div>
      </>
    )
  }
</div>

<style>
  .cover {
    --ink: rgba(139, 126, 210, 0.55);
    --ink-text: rgb(var(--text-rgb) / 0.7);

    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 0.6rem;
    aspect-ratio: 4 / 3;
    /* Room at the bottom for the title, which sits in the absolute footer. */
    padding: 0.85rem 0.95rem 3rem;
    overflow: hidden;
    /* Square corners like the blueprint sections: markers need an angle, not a radius. */
    border: 1px dashed var(--line-tint);
    background: var(--surface-2);
    color: #fff;
  }

  /* Corner markers, same as the sections. */
  .cover__mark {
    position: absolute;
    width: 5px;
    height: 5px;
    background: var(--bp-marker);
    border: 1px solid var(--line-tint);
  }

  .cover__mark--tl {
    top: -1px;
    left: -1px;
  }
  .cover__mark--tr {
    top: -1px;
    right: -1px;
  }
  .cover__mark--bl {
    bottom: -1px;
    left: -1px;
  }
  .cover__mark--br {
    bottom: -1px;
    right: -1px;
  }

  .cover__img {
    grid-row: 1 / -1;
    width: 100%;
    height: 100%;
    margin: -0.85rem -0.95rem -0.95rem;
    object-fit: cover;
  }

  .cover__kind {
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--text-rgb) / 0.55);
  }

  .cover__level {
    color: var(--page-accent);
  }

  .cover__todo {
    color: rgb(var(--text-rgb) / 0.4);
  }

  .cover__figure {
    align-self: center;
    width: 100%;
    height: auto;
    max-height: 100%;
    min-height: 3.2rem;
  }

  /* Line drawings, not diagrams: hairline stroke and a little air at the sides. */
  .cover__figure--draw {
    width: 86%;
    justify-self: center;
    stroke-width: 1;
  }

  /* Bottom-edge blur, growing on hover by height rather than opacity. */
  .cover :global(.cover__fade) {
    transition: height 380ms var(--ease-out);
  }

  /* The component sets its height inline, so override the property, not the var. */
  .cover:hover :global(.cover__fade) {
    height: 92%;
  }

  .cover__foot {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: grid;
    gap: 0.45rem;
    padding: 0.6rem 0.95rem 0.85rem;
  }

  .cover__title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    font-family: var(--font-bellota);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.15;
    text-wrap: balance;
  }

  /*
    Extra content expands by height (0fr → 1fr) under the title. The clipping edge
    is softened with a mask so the text does not cut mid-line.
  */
  .cover__more {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 380ms var(--ease-out);
  }

  .cover:hover .cover__more {
    grid-template-rows: 1fr;
  }

  .cover__more--static {
    display: none;
  }

  .cover__more-inner {
    display: grid;
    gap: 0.5rem;
    min-height: 0;
    overflow: hidden;
    padding-top: 0.15rem;
    mask-image: linear-gradient(to bottom, transparent, #000 0.6rem);
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 0.6rem);
    opacity: 0;
    translate: 0 0.35rem;
    transition:
      opacity 240ms ease,
      translate 380ms var(--ease-out);
  }

  .cover:hover .cover__more-inner {
    opacity: 1;
    translate: 0 0;
    transition:
      opacity 260ms ease 90ms,
      translate 380ms var(--ease-out);
  }

  .cover__summary {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    font-size: 0.78rem;
    line-height: 1.45;
    color: rgb(var(--text-rgb) / 0.75);
  }

  .cover__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-size: 0.6rem;
    letter-spacing: 0.04em;
    color: rgb(var(--text-rgb) / 0.75);
  }

  .cover__chips span {
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    border: 1px solid var(--line-tint);
  }

  /* Prototype with an app: same icon, radius and shadow as the Work diagram. */
  .cover__app {
    align-self: center;
    justify-self: center;
    display: block;
    width: 34%;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 24%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: var(--surface-3);
    box-shadow:
      0 12px 28px -10px rgba(2, 6, 23, 0.7),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }

  .cover__app img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Prototype: device wireframe, stroke only. */
  .cover__device {
    align-self: center;
    justify-self: center;
    width: 70%;
    padding: 0.4rem 0.4rem 0.6rem;
    border-radius: 4px;
    border: 1px solid var(--ink);
  }

  .cover__device--phone {
    width: 34%;
    padding: 0.5rem 0.3rem;
    border-radius: 0.9rem;
  }

  .cover__screen {
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: 2px;
    border: 1px dashed var(--line-tint);
    background: rgb(var(--accent-rgb) / 0.06);
  }

  .cover__device--phone .cover__screen {
    aspect-ratio: 9 / 16;
    border-radius: 0.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .cover :global(.cover__fade),
    .cover__more,
    .cover__more-inner {
      transition: none;
    }
  }
</style>
