---
// Portada 4:3 de una entrada del Lab, en el lenguaje del plano técnico del
// resto de la página: superficie violeta lisa, borde discontinuo, esquinas
// rectas con marcadores, trazos en la tinta de los rieles y el
// naranja de la página solo como acento. Si la entrada trae `cover`, va la
// imagen; si no, se compone aquí desde el frontmatter, distinta por tipo:
// el ejercicio dibuja una estructura de celdas con su idea clave y la
// complejidad, el system design un esquema de cajas conectadas con sus
// etiquetas, el prototipo el alambre de un dispositivo. El título no va
// dentro: lo pone la tarjeta debajo, una sola vez. Todo son trazos:
// nada de rellenos de color.
import GradualBlur from "../ui/GradualBlur.astro"
import { isUnsolved, KIND_LABEL, type LabEntry } from "./lab"

interface Props {
  entry: LabEntry
  class?: string
  /** Sin desenfoque ni despliegue al pasar: para listas largas (el drawer), donde pesarían. */
  fade?: boolean
}

const { entry, class: className, fade = true } = Astro.props
const { data } = entry
const boxes = (data.tags.length >= 3 ? data.tags.slice(0, 3) : ["Client", "Service", "Store"]).map((t) => t.slice(0, 12))
const device = data.shots[0]?.frame === "phone" ? "phone" : "web"
// Celdas del ejercicio: una fila indexada, con una marcada en naranja.
const cells = 7
const hot = 4
---

<div class:list={["cover", `cover--${data.kind}`, className]} aria-hidden="true">
  <span class="cover__mark cover__mark--tl"></span>
  <span class="cover__mark cover__mark--tr"></span>
  <span class="cover__mark cover__mark--bl"></span>
  <span class="cover__mark cover__mark--br"></span>

  {
    data.cover ? (
      <img class="cover__img" src={data.cover} alt="" loading="lazy" decoding="async" />
    ) : (
      <>
        <span class="cover__kind font-jetbrains">
          {KIND_LABEL[data.kind]}
          {data.difficulty && <span class="cover__level">· {data.difficulty}</span>}
          {isUnsolved(entry) && <span class="cover__todo">· to solve</span>}
        </span>

        {data.kind === "exercise" && (
          <>
            <svg class="cover__figure" viewBox="0 0 320 96" fill="none">
              {Array.from({ length: cells }, (_, i) => (
                <>
                  <rect x={8 + i * 44} y="30" width="36" height="36" rx="2" stroke={i === hot ? "var(--page-accent)" : "var(--ink)"} stroke-width={i === hot ? 1.5 : 1} fill={i === hot ? "rgb(var(--accent-rgb) / 0.12)" : "none"} />
                  <text x={26 + i * 44} y="20" text-anchor="middle" fill="var(--ink-text)" font-size="9" font-family="var(--font-jetbrains)">
                    {i}
                  </text>
                </>
              ))}
              <path d={`M${26 + hot * 44} 66 V84 H${26}`} stroke="var(--page-accent)" stroke-width="1" stroke-dasharray="3 3" />
              <path d="M26 84 V70" stroke="var(--page-accent)" stroke-width="1" marker-end="url(#lab-arrow)" />
              <defs>
                <marker id="lab-arrow" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="6" markerHeight="6" orient="auto">
                  <path d="M0 0 8 4 0 8" fill="var(--page-accent)" />
                </marker>
              </defs>
            </svg>
          </>
        )}

        {data.kind === "system" && (
          <>
            <svg class="cover__figure cover__figure--system" viewBox="0 0 320 110" fill="none">
              {boxes.map((label, i) => (
                <>
                  <rect x={10 + i * 108} y="30" width="90" height="48" rx="2" stroke={i === 1 ? "var(--page-accent)" : "var(--ink)"} stroke-width={i === 1 ? 1.5 : 1} fill={i === 1 ? "rgb(var(--accent-rgb) / 0.1)" : "none"} />
                  <text x={55 + i * 108} y="58" text-anchor="middle" fill="var(--ink-text)" font-size="11" font-family="var(--font-jetbrains)">
                    {label}
                  </text>
                  {i < boxes.length - 1 && <path d={`M${100 + i * 108} 54 H${116 + i * 108}`} stroke="var(--ink)" stroke-width="1" stroke-dasharray="3 3" marker-end="url(#lab-arrow-s)" />}
                </>
              ))}
              <defs>
                <marker id="lab-arrow-s" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="6" markerHeight="6" orient="auto">
                  <path d="M0 0 8 4 0 8" fill="var(--ink)" />
                </marker>
              </defs>
            </svg>
          </>
        )}

        {data.kind === "prototype" && (
          <>
            <div class:list={["cover__device", `cover__device--${device}`]}>
              <span class="cover__screen"></span>
            </div>
          </>
        )}

        {/* Pie: el título siempre; al pasar suben el resumen y los chips sobre
            un desenfoque progresivo que crece desde abajo (solo blur). */}
        {fade && <GradualBlur position="bottom" height="42%" strength={1.4} divCount={5} curve="ease-in" zIndex={1} class="cover__fade" />}
        <div class="cover__foot">
          <span class="cover__title">{data.title}</span>
          <div class:list={["cover__more", { "cover__more--static": !fade }]}>
            <div class="cover__more-inner">
              <span class="cover__summary">{data.summary}</span>
              {data.complexity && (
                <span class="cover__chips font-jetbrains">
                  <span>time {data.complexity.time}</span>
                  <span>space {data.complexity.space}</span>
                </span>
              )}
            </div>
          </div>
        </div>
      </>
    )
  }
</div>

<style>
  .cover {
    --ink: rgba(139, 126, 210, 0.55);
    --ink-text: rgb(var(--text-rgb) / 0.7);

    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 0.6rem;
    aspect-ratio: 4 / 3;
    /* Abajo queda sitio para el título, que va en el pie absoluto. */
    padding: 0.85rem 0.95rem 3rem;
    overflow: hidden;
    /* Esquinas rectas, como las secciones del plano: los marcadores piden ángulo, no radio. */
    border: 1px dashed var(--line-tint);
    background: var(--surface-2);
    color: #fff;
  }

  /* Marcadores de esquina, como los de las secciones. */
  .cover__mark {
    position: absolute;
    width: 5px;
    height: 5px;
    background: var(--bp-marker);
    border: 1px solid var(--line-tint);
  }

  .cover__mark--tl {
    top: -1px;
    left: -1px;
  }
  .cover__mark--tr {
    top: -1px;
    right: -1px;
  }
  .cover__mark--bl {
    bottom: -1px;
    left: -1px;
  }
  .cover__mark--br {
    bottom: -1px;
    right: -1px;
  }

  .cover__img {
    grid-row: 1 / -1;
    width: 100%;
    height: 100%;
    margin: -0.85rem -0.95rem -0.95rem;
    object-fit: cover;
  }

  .cover__kind {
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgb(var(--text-rgb) / 0.55);
  }

  .cover__level {
    color: var(--page-accent);
  }

  .cover__todo {
    color: rgb(var(--text-rgb) / 0.4);
  }

  .cover__figure {
    align-self: center;
    width: 100%;
    height: auto;
    max-height: 100%;
    min-height: 3.2rem;
  }

  /* Desenfoque del borde inferior: crece al pasar el puntero (altura, no opacidad). */
  .cover :global(.cover__fade) {
    transition: height 380ms var(--ease-out);
  }

  /* El componente fija su alto con --gb-size en línea: aquí se pisa la propiedad, no la variable. */
  .cover:hover :global(.cover__fade) {
    height: 92%;
  }

  .cover__foot {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 2;
    display: grid;
    gap: 0.45rem;
    padding: 0.6rem 0.95rem 0.85rem;
  }

  .cover__title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    font-family: var(--font-bellota);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.15;
    text-wrap: balance;
  }

  /* Lo extra se despliega en alto (0fr → 1fr): sube desde debajo del título. */
  .cover__more {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 380ms var(--ease-out);
  }

  .cover:hover .cover__more {
    grid-template-rows: 1fr;
  }

  .cover__more--static {
    display: none;
  }

  .cover__more-inner {
    display: grid;
    gap: 0.5rem;
    min-height: 0;
    overflow: hidden;
  }

  .cover__summary {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    overflow: hidden;
    font-size: 0.78rem;
    line-height: 1.45;
    color: rgb(var(--text-rgb) / 0.75);
  }

  .cover__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    font-size: 0.6rem;
    letter-spacing: 0.04em;
    color: rgb(var(--text-rgb) / 0.75);
  }

  .cover__chips span {
    padding: 0.2rem 0.5rem;
    border-radius: 2px;
    border: 1px solid var(--line-tint);
  }

  /* Prototipo: alambre de dispositivo, solo trazo. */
  .cover__device {
    align-self: center;
    justify-self: center;
    width: 70%;
    padding: 0.4rem 0.4rem 0.6rem;
    border-radius: 4px;
    border: 1px solid var(--ink);
  }

  .cover__device--phone {
    width: 34%;
    padding: 0.5rem 0.3rem;
    border-radius: 0.9rem;
  }

  .cover__screen {
    display: block;
    aspect-ratio: 16 / 10;
    border-radius: 2px;
    border: 1px dashed var(--line-tint);
    background: rgb(var(--accent-rgb) / 0.06);
  }

  .cover__device--phone .cover__screen {
    aspect-ratio: 9 / 16;
    border-radius: 0.5rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .cover :global(.cover__fade),
    .cover__more {
      transition: none;
    }
  }
</style>
