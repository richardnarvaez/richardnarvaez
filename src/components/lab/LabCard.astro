---
// Showcase card: just the 4:3 cover, with kind, figure and title inside. The
// summary lives in the link's accessible name and on the page.
import LabCover from "./LabCover.astro"
import { hrefOf, type LabEntry } from "./lab"

interface Props {
  entry: LabEntry
  /* On the home page it opens in a drawer; the href is the no-JS fallback. */
  drawer?: boolean
}

const { entry, drawer = false } = Astro.props
const { data } = entry
---

<a class="lab-card" href={hrefOf(entry)} data-open={drawer ? `lab:${entry.id}` : undefined} aria-label={`${data.title}. ${data.summary}`}>
  <LabCover entry={entry} class="lab-card__cover" />
</a>

<style>
  .lab-card {
    display: block;
    text-decoration: none;
    color: inherit;
    outline-offset: 6px;
  }

  .lab-card :global(.lab-card__cover) {
    transition: border-color 220ms ease;
  }

  /* On hover the dashed border lights up in the page orange. */
  .lab-card:hover :global(.lab-card__cover) {
    border-color: var(--page-accent);
  }
</style>
