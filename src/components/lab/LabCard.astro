---
// Tarjeta de la vitrina: solo la portada 4:3, con tipo, figura y título
// dentro. El resumen va en el nombre accesible del enlace y en la página.
import LabCover from "./LabCover.astro"
import type { LabEntry } from "./lab"

interface Props {
  entry: LabEntry
}

const { entry } = Astro.props
const { data } = entry
---

<a class="lab-card" href={`/lab/${entry.id}`} aria-label={`${data.title}. ${data.summary}`}>
  <LabCover entry={entry} class="lab-card__cover" />
</a>

<style>
  .lab-card {
    display: block;
    text-decoration: none;
    color: inherit;
    outline-offset: 6px;
  }

  .lab-card :global(.lab-card__cover) {
    transition: border-color 220ms ease;
  }

  /* Al pasar, el borde discontinuo se enciende en el naranja de la página. */
  .lab-card:hover :global(.lab-card__cover) {
    border-color: var(--page-accent);
  }
</style>
