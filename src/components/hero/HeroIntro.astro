---
import ArrowFigma from "../icons/ArrowFigma.astro"
import GradualBlur from "../ui/GradualBlur.astro"
import { siteName, projectVersionLabel } from "../../site.config"

// Words cycling inside the selection. They stack in one grid cell, so the box
// always measures the widest and never resizes.
const words = ["thinking...", "building...", "drawing..."].map((word) => [...word])
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <img
      src="/images/home/bg-header.webp"
      width="2000"
      height="1445"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      alt=""
    />
  </div>

  {/*
    Hand sketches over the photo, same ratio so they line up pixel for pixel.
    At rest they are nearly invisible; an orange torch reveals them.
  */}
  <div class="hero__sketch" aria-hidden="true">
    <div class="hero__sketch-base"></div>
    <div class="hero__sketch-torch">
      <div class="hero__sketch-lit">
        <div class="hero__sketch-glow"><div class="hero__sketch-ink"></div></div>
        <div class="hero__sketch-ink hero__sketch-ink--core"></div>
      </div>
    </div>
  </div>

  {/*
    Progressive blur under the text: strongest at the left edge, gone by 45%,
    so photo and sketch read clean on the right.
  */}
  <GradualBlur
    class="hero__blur"
    position="left"
    height="45%"
    strength={1.5}
    divCount={5}
    curve="bezier"
    exponential
    zIndex={0}
  />

  {/*
    Bottom fade above every background layer, so the scene dissolves into the
    page colour before the edge and the cut never shows.
  */}
  <div class="hero__fade" aria-hidden="true"></div>

  {/* No rails or markers: the hero is full bleed; the frame starts at 01. */}
  <div class="bp-inner hero__inner">
    <p class="hero__eyebrow label">Portfolio — {projectVersionLabel}</p>

    <h1 id="hero-title" class="hero__title">
      <span class="sr-only">{siteName} — creative human thinking</span>

      <span class="hero__line hero__line--creative" aria-hidden="true">
        Creative
      </span>
      {/*
        Two layers with the same letters. The torch clips the normal one and reveals
        the "AI" layer: H, U, M dimmed, A intact, I over the N's first stem.
      */}
      <span class="hero__line hero__line--human" aria-hidden="true">
        <span class="hero__human hero__human--base">
          <span class="hero__letter">H</span><span class="hero__letter">U</span><span class="hero__letter">M</span><span class="hero__letter hero__letter--keep">A</span><span class="hero__letter hero__letter--swap"><span class="hero__glyph">N</span></span>
        </span>
        <span class="hero__human hero__human--ai">
          <span class="hero__letter">H</span><span class="hero__letter">U</span><span class="hero__letter">M</span><span class="hero__letter hero__letter--keep">A</span><span class="hero__letter hero__letter--swap" data-alt="I"><span class="hero__glyph">N</span></span>
        </span>
      </span>

      <span class="hero__selection" aria-hidden="true">
        <span class="hero__line hero__line--thinking">
          <span class="hero__slot">
            {words.map((chars, i) => (
              <span class:list={["hero__word", { "is-active": i === 0 }]}>
                {chars.map((char, n) => (
                  <span class="hero__char" style={`--i: ${n}`}>{char}</span>
                ))}
              </span>
            ))}
          </span>
        </span>

        <span class="hero__handle hero__handle--tl"></span>
        <span class="hero__handle hero__handle--tr"></span>
        <span class="hero__handle hero__handle--bl"></span>
        <span class="hero__handle hero__handle--br"></span>

        <span class="hero__cursor">
          <ArrowFigma class="hero__cursor-arrow" />
          <span class="hero__cursor-label">{siteName}</span>
        </span>
      </span>
    </h1>
  </div>
</section>

<script>
  // Word swap on the right: each drag cycle hits its target at 30% and the letters
  // cross-fade in place. Hooked to the CSS animation events, so it never drifts.
  const selection = document.querySelector<HTMLElement>(".hero__selection")
  const slotWords = [...document.querySelectorAll<HTMLElement>(".hero__word")]

  if (selection && slotWords.length > 1) {
    const SWAP_AT_MS = 2250 // 30% de 7.5s
    let index = 0

    const swap = () => {
      slotWords[index].classList.remove("is-active")
      index = (index + 1) % slotWords.length
      slotWords[index].classList.add("is-active")
    }

    const schedule = (event: AnimationEvent) => {
      if (event.animationName.includes("heroDrag")) setTimeout(swap, SWAP_AT_MS)
    }
    selection.addEventListener("animationstart", schedule)
    selection.addEventListener("animationiteration", schedule)
  }

  // The variables live on .hero: both the sketches and HUMAN read them.
  const hero = document.querySelector<HTMLElement>(".hero")
  const human = hero?.querySelector<HTMLElement>(".hero__line--human")
  const wantsMotion =
    matchMedia("(hover: hover)").matches && !matchMedia("(prefers-reduced-motion: reduce)").matches

  if (hero && human && wantsMotion) {
    // Three blobs with different inertias: the main one and two that lag behind.
    const blobs = [
      { ease: 0.14, x: 0, y: 0, vx: "--tx", vy: "--ty" },
      { ease: 0.06, x: 0, y: 0, vx: "--tx2", vy: "--ty2" },
      { ease: 0.036, x: 0, y: 0, vx: "--tx3", vy: "--ty3" },
      { ease: 0.022, x: 0, y: 0, vx: "--tx4", vy: "--ty4" },
    ]
    // Sketch parallax: shifts up to ±PARALLAX px depending on where the pointer sits.
    const PARALLAX = 14
    const parallax = { ease: 0.05, x: 0, y: 0, tx: 0, ty: 0 }
    let targetX = 0
    let targetY = 0
    let frame = 0

    const aim = (event: PointerEvent) => {
      const box = hero.getBoundingClientRect()
      targetX = event.clientX - box.left
      targetY = event.clientY - box.top
      parallax.tx = (targetX / box.width - 0.5) * 2 * PARALLAX
      parallax.ty = (targetY / box.height - 0.5) * 2 * PARALLAX
    }

    const tick = () => {
      let pending = 0
      for (const b of blobs) {
        b.x += (targetX - b.x) * b.ease
        b.y += (targetY - b.y) * b.ease
        hero.style.setProperty(b.vx, `${b.x.toFixed(1)}px`)
        hero.style.setProperty(b.vy, `${b.y.toFixed(1)}px`)
        pending += Math.abs(targetX - b.x) + Math.abs(targetY - b.y)
      }
      parallax.x += (parallax.tx - parallax.x) * parallax.ease
      parallax.y += (parallax.ty - parallax.y) * parallax.ease
      hero.style.setProperty("--px", `${parallax.x.toFixed(2)}px`)
      hero.style.setProperty("--py", `${parallax.y.toFixed(2)}px`)
      pending += Math.abs(parallax.tx - parallax.x) + Math.abs(parallax.ty - parallax.y)
      frame = pending < 0.5 ? 0 : requestAnimationFrame(tick)
    }

    const wake = () => {
      if (!frame) frame = requestAnimationFrame(tick)
    }

    // Where the word sits inside the hero, so its masks share the torch's
    // coordinate system.
    const locate = () => {
      const box = hero.getBoundingClientRect()
      const word = human.getBoundingClientRect()
      human.style.setProperty("--wx", `${(word.left - box.left).toFixed(1)}px`)
      human.style.setProperty("--wy", `${(word.top - box.top).toFixed(1)}px`)
    }

    hero.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "touch") return
      aim(event)
      locate()
      // Born right under the pointer, without sliding in from the last position.
      for (const b of blobs) {
        b.x = targetX
        b.y = targetY
      }
      hero.classList.add("is-lit")
      wake()
    })

    hero.addEventListener("pointermove", (event) => {
      if (event.pointerType === "touch") return
      aim(event)
      wake()
    })

    hero.addEventListener("pointerleave", () => {
      hero.classList.remove("is-lit")
    })
  }
</script>

<style>
  .hero {
    /*
      Torch: box (must fit the trail), blob diameter and the four positions,
      in container units so it scales with the hero.
    */
    --blob: url("/images/home/torch-blob.png");
    --torch-box: 64rem;
    --blob-1: 36rem;
    --blob-2: 28rem;
    --blob-3: 21rem;
    --blob-4: 15rem;
    --tx: 0px;
    --ty: 0px;
    --tx2: 0px;
    --ty2: 0px;
    --tx3: 0px;
    --ty3: 0px;
    --tx4: 0px;
    --ty4: 0px;
    /* Sketch parallax against the photo, written by the script. */
    --px: 0px;
    --py: 0px;

    position: relative;
    display: flex;
    font-family: var(--font-bellota);
    align-items: center;
    /*
      svh, never dvh: on iPhone the dynamic viewport grows as the URL bar
      collapses and the whole hero would resize mid-scroll. svh is the small
      viewport, the one with the bar showing, so it fills the first screen and
      then never moves.
    */
    min-height: 100svh;
    overflow: hidden;
    isolation: isolate;
    /*
      The page colour, not transparent: 100svh is fractional on most phones and
      the clip antialiased the last row of the photo and the blur layers into a
      hairline. Same fix the train scene carries.
    */
    background: var(--page-accent-surface);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.28;
    transform: scale(1.06);
    animation: heroBgSettle 1.6s var(--ease-out) forwards;
  }

  /* Fades the photo into the background, top and bottom, symmetrically. */
  .hero__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      var(--page-accent-surface) 0%,
      rgb(var(--surface-rgb) / 0.45) 22%,
      rgb(var(--surface-rgb) / 0.35) 55%,
      var(--page-accent-surface) 100%
    );
  }

  /*
    Fully opaque at the end: a plain linear gradient only reaches 100% at the
    very last pixel and left a visible seam.
  */
  .hero__fade {
    position: absolute;
    inset: auto 0 0;
    /* Of the hero, so it grew with it: 45% was 387px once the hero filled the screen. */
    height: 22.5%;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(
      to top,
      var(--page-accent-surface) 0%,
      var(--page-accent-surface) 14%,
      rgb(var(--surface-rgb) / 0.85) 38%,
      rgb(var(--surface-rgb) / 0.45) 66%,
      transparent 100%
    );
  }

  /*
    Sketch layer: the WebP is an ALPHA mask and CSS paints the colour.

    Two traps are baked in, both fixed by measurement: alpha and not luminance,
    because Safari ignores luminance masks on raster images; and the torch is a
    PNG rasterised at build, not an SVG filter, which the browser re-rasterised
    on every pointer move.

    `base` shows only on touch or reduced-motion; `torch` follows the pointer
    while the sketch inside shifts the opposite way, pinning it to the photo.
  */
  .hero__sketch {
    --sketch: url("/images/home/bg-header-lineas-mask.webp");
    /* The same sketch pre-blurred at build: neon halo with no runtime filter. */
    --sketch-glow: url("/images/home/bg-header-lineas-glow.webp");

    position: absolute;
    inset: 0;
    z-index: -1;
    container-type: size;
    pointer-events: none;
    /* Same settle as the background photo, so they do not drift apart on entry. */
    transform: scale(1.06);
    animation: heroSketchSettle 1.6s var(--ease-out) forwards;
  }

  .hero__sketch-base,
  .hero__sketch-ink {
    position: absolute;
    inset: 0;
    mask-image: var(--sketch);
    mask-size: cover;
    mask-position: center;
    mask-repeat: no-repeat;
  }

  /* Does not exist with a pointer: the sketch only shows under the torch. */
  .hero__sketch-base {
    display: none;
  }

  .hero__sketch-torch {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--torch-box);
    height: var(--torch-box);
    translate: calc(var(--tx) - var(--torch-box) / 2) calc(var(--ty) - var(--torch-box) / 2);
    scale: 0.6;
    opacity: 0;
    /* Fully off at rest, neither painted nor composited; returns on entry. */
    visibility: hidden;
    overflow: clip;
    contain: paint;
    /* Four liquid blobs: the main one centred, the rest trailing behind. */
    mask-image: var(--blob), var(--blob), var(--blob), var(--blob);
    mask-repeat: no-repeat;
    mask-size:
      var(--blob-1) var(--blob-1),
      var(--blob-2) var(--blob-2),
      var(--blob-3) var(--blob-3),
      var(--blob-4) var(--blob-4);
    mask-position:
      center,
      calc(50% + (var(--tx2) - var(--tx))) calc(50% + (var(--ty2) - var(--ty))),
      calc(50% + (var(--tx3) - var(--tx))) calc(50% + (var(--ty3) - var(--ty))),
      calc(50% + (var(--tx4) - var(--tx))) calc(50% + (var(--ty4) - var(--ty)));
    transition:
      opacity 480ms ease,
      scale 640ms var(--ease-out),
      visibility 0s linear 480ms;
    will-change: translate, opacity;
  }

  .hero.is-lit .hero__sketch-torch {
    opacity: 1;
    scale: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  /* Warm torch light over the photo itself. */
  .hero__sketch-torch::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle calc(var(--blob-1) / 2) at center, rgb(var(--accent-rgb) / 0.14), transparent 100%);
  }

  /* Hero size in container units, translated inverse to the torch. */
  .hero__sketch-lit {
    position: absolute;
    top: 0;
    left: 0;
    width: 100cqw;
    height: 100cqh;
    /* Translucent: reads as drawn over the photo without taking over. */
    opacity: 0.7;
    translate: calc(var(--torch-box) / 2 - var(--tx) + var(--px)) calc(var(--torch-box) / 2 - var(--ty) + var(--py));
    will-change: translate;
  }

  /*
    Halo: orange ink masked with the pre-blurred sketch, generated at build.
    No runtime filter, so it composes on the GPU.
  */
  .hero__sketch-glow {
    position: absolute;
    inset: 0;
    opacity: 0.9;
  }

  .hero__sketch-glow .hero__sketch-ink {
    mask-image: var(--sketch-glow);
    background: var(--page-accent);
  }

  /* Tube core: lighter than the halo, like real neon. */
  .hero__sketch-ink--core {
    background: #ffb59e;
  }

  @keyframes heroSketchSettle {
    to {
      transform: scale(1);
    }
  }

  /* No pointer or no motion: no torch, the sketch stays faint and still. */
  @media (hover: none), (prefers-reduced-motion: reduce) {
    .hero__sketch-torch {
      display: none;
    }

    .hero__sketch-base {
      display: block;
      background: rgba(255, 255, 255, 0.1);
    }

    .hero__sketch {
      animation: none;
      transform: none;
    }
  }

  /* Stretched to the hero's full height so the rails run edge to edge. */
  .hero__inner {
    border-inline-color: transparent; /* mismo ancho útil que el resto, sin línea */
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(4rem, 12vh, 8rem);
  }

  .hero__eyebrow {
    margin: 0 0 1.25rem;
    font-size: 0.65rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgb(var(--text-rgb) / 0.5);
    animation: heroRise 0.7s var(--ease-out) both;
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1em;
    margin: 0;
    font-weight: 400;
    line-height: 0.94;
  }

  .hero__line {
    display: block;
    animation: heroRise 0.9s var(--ease-out) both;
  }

  .hero__line--creative {
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    font-weight: 300;
    color: rgba(255, 255, 255, 0.92);
    animation-delay: 0.08s;
  }

  .hero__line--human {
    font-size: clamp(3.6rem, 12vw, 8rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #fff;
    animation-delay: 0.16s;
  }

  /*
    The "AI" inside HUMAN, revealed by the same torch that lights the sketches.
    Two identical layers: the base is clipped and the AI layer shows through.
    Masks are in hero coordinates so both stay in register.
  */
  @property --torch-scale {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  /* No longer text but a component: normal cursor, no selection. */
  .hero__line--human {
    /* How far the dimmed letters drop under the torch: the AI is what reads. */
    --hero-dim: 0.08;
    /*
      The light over the word is wider than over the sketches: the blobs have very
      soft edges and a letter needs more coverage to read as lit.
    */
    --word-light: 1.75;
    --wx: 0px;
    --wy: 0px;
    --torch-scale: 0;

    position: relative;
    cursor: default;
    user-select: none;
    transition: --torch-scale 480ms ease;
  }

  .hero.is-lit .hero__line--human {
    --torch-scale: 1;
  }

  .hero__human {
    display: block;
  }

  .hero__human--ai {
    position: absolute;
    inset: 0;
    display: none;
  }

  .hero__letter,
  .hero__glyph {
    display: inline-block;
  }

  .hero__letter--swap {
    position: relative;
  }

  /* "AI" layer: H, U, M dimmed; the N gives way to the I on its first stem. */
  .hero__human--ai .hero__letter {
    opacity: var(--hero-dim);
  }

  .hero__human--ai .hero__letter--keep,
  .hero__human--ai .hero__letter--swap {
    opacity: 1;
  }

  .hero__human--ai .hero__glyph {
    opacity: 0;
  }

  .hero__human--ai .hero__letter--swap::before {
    content: attr(data-alt);
    position: absolute;
    inset: 0;
    text-align: left;
    color: #fff;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .hero__human--ai {
      display: block;
    }

    /* The four blobs, scaled by --torch-scale and centred on each focus. */
    .hero__human--base,
    .hero__human--ai {
      --b1: calc(var(--blob-1) * var(--word-light) * var(--torch-scale));
      --b2: calc(var(--blob-2) * var(--word-light) * var(--torch-scale));
      --b3: calc(var(--blob-3) * var(--word-light) * var(--torch-scale));
      --b4: calc(var(--blob-4) * var(--word-light) * var(--torch-scale));
      --p1: calc(var(--tx) - var(--wx) - var(--b1) / 2) calc(var(--ty) - var(--wy) - var(--b1) / 2);
      --p2: calc(var(--tx2) - var(--wx) - var(--b2) / 2) calc(var(--ty2) - var(--wy) - var(--b2) / 2);
      --p3: calc(var(--tx3) - var(--wx) - var(--b3) / 2) calc(var(--ty3) - var(--wy) - var(--b3) / 2);
      --p4: calc(var(--tx4) - var(--wx) - var(--b4) / 2) calc(var(--ty4) - var(--wy) - var(--b4) / 2);

      mask-repeat: no-repeat;
      will-change: mask-position;
    }

    .hero__human--ai {
      mask-image: var(--blob), var(--blob), var(--blob), var(--blob);
      mask-size:
        var(--b1) var(--b1),
        var(--b2) var(--b2),
        var(--b3) var(--b3),
        var(--b4) var(--b4);
      mask-position: var(--p1), var(--p2), var(--p3), var(--p4);
    }

    /* Base: the whole text MINUS the union of the blobs (exclude = XOR). */
    .hero__human--base {
      mask-image: linear-gradient(#000, #000), var(--blob), var(--blob), var(--blob), var(--blob);
      mask-size:
        auto,
        var(--b1) var(--b1),
        var(--b2) var(--b2),
        var(--b3) var(--b3),
        var(--b4) var(--b4);
      mask-position: 0 0, var(--p1), var(--p2), var(--p3), var(--p4);
      mask-composite: exclude, add, add, add, add;
    }
  }

  .hero__line--thinking {
    font-size: clamp(2rem, 6vw, 4rem);
    font-weight: 300;
    color: var(--page-accent);
    animation-delay: 0.24s;
    white-space: nowrap;
  }

  /*
    Every word shares one grid cell, so the box measures the widest and never
    resizes. Each letter is its own span to cross-fade them in place.
  */
  .hero__slot {
    display: inline-grid;
  }

  .hero__word {
    grid-area: 1 / 1;
  }

  .hero__char {
    opacity: 0;
    transition: opacity 240ms ease calc(var(--i) * 35ms);
  }

  .hero__word.is-active .hero__char {
    opacity: 1;
    transition-delay: calc(var(--i) * 35ms + 140ms);
  }

  /* Figma-style selection: flat blue border and white handles. */
  .hero__selection {
    position: relative;
    margin-top: 0.35em;
    padding: 0.1em 0.5em 0.18em;
    border: 2px solid var(--figma-select);
    /*
      As if someone had rotated it on the canvas. It goes in `rotate`, not
      `transform`, so it does not clash with the drag animation.
    */
    transform-origin: left center;
    rotate: -10deg;
    /*
      Two animations on different properties: the entrance animates `transform`
      and the drag animates `translate`, so neither overwrites the other.
    */
    animation:
      heroSelect 0.5s var(--ease-out) 0.55s both,
      heroDrag 7.5s ease-in-out 1.6s infinite;
  }

  .hero__handle {
    position: absolute;
    width: 9px;
    height: 9px;
    background: #fff;
    border: 2px solid var(--figma-select);
  }

  .hero__handle--tl {
    left: -5px;
    top: -5px;
  }
  .hero__handle--tr {
    right: -5px;
    top: -5px;
  }
  .hero__handle--bl {
    left: -5px;
    bottom: -5px;
  }
  .hero__handle--br {
    right: -5px;
    bottom: -5px;
  }

  /*
    Anchored by the group's left edge (the arrow), not the right: the arrow stays
    on the handle while the label grows to the right.
  */
  .hero__cursor {
    position: absolute;
    left: calc(100% - 1.1rem);
    top: calc(100% - 1rem);
    display: flex;
    align-items: flex-start;
    /* Undoes the parent's rotation: in Figma the cursor and label do not rotate. */
    transform-origin: top left;
    rotate: 10deg;
    animation: heroCursorIn 0.6s var(--ease-out) 0.75s both;
  }

  .hero__cursor :global(.hero__cursor-arrow) {
    width: 1.9rem;
    height: 1.9rem;
    flex: none;
    filter: drop-shadow(0 4px 10px rgba(2, 6, 23, 0.45));
  }

  /*
    Figma-style collaborator label: hangs off the cursor tip, with a top
    highlight and a contact shadow.
  */
  .hero__cursor-label {
    margin: 1.45rem 0 0 -0.45rem;
