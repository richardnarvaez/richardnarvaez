---
import ArrowFigma from "../icons/ArrowFigma.astro"
import GradualBlur from "../ui/GradualBlur.astro"
import { siteName, projectVersionLabel } from "../../site.config"

// Palabras que rotan en la selección. Van apiladas en la misma celda de una
// rejilla, así que el marco mide siempre lo que la más ancha: nunca cambia de
// tamaño. Cada letra es un span para fundirlas de una en una, en su sitio.
const words = ["thinking...", "building...", "drawing..."].map((word) => [...word])
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <img
      src="/images/home/bg-header.webp"
      width="2000"
      height="1445"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      alt=""
    />
  </div>

  {/*
    Bocetos a mano sobre la foto (misma proporción que bg-header.webp, así que
    casan píxel a píxel). En reposo casi no se ven; un foco de neón naranja
    que sigue al puntero los revela. El script de abajo mueve el foco.
  */}
  <div class="hero__sketch" aria-hidden="true">
    <div class="hero__sketch-base"></div>
    <div class="hero__sketch-torch">
      <div class="hero__sketch-lit">
        <div class="hero__sketch-glow"><div class="hero__sketch-ink"></div></div>
        <div class="hero__sketch-ink hero__sketch-ink--core"></div>
      </div>
    </div>
  </div>

  {/*
    Desenfoque progresivo bajo el texto: máximo en el borde izquierdo y nulo
    hacia el 45% del ancho, así la foto y el boceto se leen limpios a la
    derecha. Va entre las capas de fondo (z negativo) y el contenido.
  */}
  <GradualBlur
    class="hero__blur"
    position="left"
    height="45%"
    strength={1.5}
    divCount={5}
    curve="bezier"
    exponential
    zIndex={0}
  />

  {/*
    Fundido inferior por encima de TODAS las capas de fondo (foto, boceto,
    desenfoque): la escena se disuelve en el color de la página antes del
    borde y el corte no se ve nunca, ni siquiera con la linterna encendida.
  */}
  <div class="hero__fade" aria-hidden="true"></div>

  {/* Sin rieles ni marcadores: el hero va a sangre; el marco arranca en 01 — profile. */}
  <div class="bp-inner hero__inner">
    <p class="hero__eyebrow font-jetbrains">Portfolio — {projectVersionLabel}</p>

    <h1 id="hero-title" class="hero__title">
      <span class="sr-only">{siteName} — creative human thinking</span>

      <span class="hero__line hero__line--creative" aria-hidden="true">
        Creative
      </span>
      {/*
        Dos capas con las mismas letras. La luz que sigue al puntero recorta
        la capa normal y revela la capa "AI" debajo: H, U, M atenuadas, la A
        intacta y una I sobre el primer trazo de la N.
      */}
      <span class="hero__line hero__line--human" aria-hidden="true">
        <span class="hero__human hero__human--base">
          <span class="hero__letter">H</span><span class="hero__letter">U</span><span class="hero__letter">M</span><span class="hero__letter hero__letter--keep">A</span><span class="hero__letter hero__letter--swap"><span class="hero__glyph">N</span></span>
        </span>
        <span class="hero__human hero__human--ai">
          <span class="hero__letter">H</span><span class="hero__letter">U</span><span class="hero__letter">M</span><span class="hero__letter hero__letter--keep">A</span><span class="hero__letter hero__letter--swap" data-alt="I"><span class="hero__glyph">N</span></span>
        </span>
      </span>

      <span class="hero__selection" aria-hidden="true">
        <span class="hero__line hero__line--thinking">
          <span class="hero__slot">
            {words.map((chars, i) => (
              <span class:list={["hero__word", { "is-active": i === 0 }]}>
                {chars.map((char, n) => (
                  <span class="hero__char" style={`--i: ${n}`}>{char}</span>
                ))}
              </span>
            ))}
          </span>
        </span>

        <span class="hero__handle hero__handle--tl"></span>
        <span class="hero__handle hero__handle--tr"></span>
        <span class="hero__handle hero__handle--bl"></span>
        <span class="hero__handle hero__handle--br"></span>

        <span class="hero__cursor">
          <ArrowFigma class="hero__cursor-arrow" />
          <span class="hero__cursor-label">{siteName}</span>
        </span>
      </span>
    </h1>
  </div>
</section>

<script>
  // Cambio de palabra al llegar a la derecha: cada ciclo del arrastre
  // (heroDrag, 7.5s), al 30% la selección llega a su destino y las letras de
  // la palabra se funden con las de la siguiente, de izquierda a derecha y
  // sin moverse. Se engancha a los eventos de la propia animación CSS, así
  // nunca se desfasa; con reduced-motion la animación no existe y la palabra
  // se queda quieta.
  const selection = document.querySelector<HTMLElement>(".hero__selection")
  const slotWords = [...document.querySelectorAll<HTMLElement>(".hero__word")]

  if (selection && slotWords.length > 1) {
    const SWAP_AT_MS = 2250 // 30% de 7.5s
    let index = 0

    const swap = () => {
      slotWords[index].classList.remove("is-active")
      index = (index + 1) % slotWords.length
      slotWords[index].classList.add("is-active")
    }

    const schedule = (event: AnimationEvent) => {
      if (event.animationName.includes("heroDrag")) setTimeout(swap, SWAP_AT_MS)
    }
    selection.addEventListener("animationstart", schedule)
    selection.addEventListener("animationiteration", schedule)
  }

  // Las variables viven en .hero: las leen tanto los bocetos como la palabra
  // HUMAN, cuyas máscaras usan las mismas manchas para revelar el "AI".
  const hero = document.querySelector<HTMLElement>(".hero")
  const human = hero?.querySelector<HTMLElement>(".hero__line--human")
  const wantsMotion =
    matchMedia("(hover: hover)").matches && !matchMedia("(prefers-reduced-motion: reduce)").matches

  if (hero && human && wantsMotion) {
    // Tres manchas con inercias distintas: la principal y dos que se rezagan.
    // Al moverse se separan como gotas; al parar se funden en una sola.
    const blobs = [
      { ease: 0.14, x: 0, y: 0, vx: "--tx", vy: "--ty" },
      { ease: 0.06, x: 0, y: 0, vx: "--tx2", vy: "--ty2" },
      { ease: 0.036, x: 0, y: 0, vx: "--tx3", vy: "--ty3" },
      { ease: 0.022, x: 0, y: 0, vx: "--tx4", vy: "--ty4" },
    ]
    // Paralaje del dibujo: se desplaza hasta ±PARALLAX px según dónde esté el
    // puntero respecto al centro del hero, con una inercia más lenta que la
    // linterna. Da la sensación de que el boceto flota sobre la foto.
    const PARALLAX = 14
    const parallax = { ease: 0.05, x: 0, y: 0, tx: 0, ty: 0 }
    let targetX = 0
    let targetY = 0
    let frame = 0

    const aim = (event: PointerEvent) => {
      const box = hero.getBoundingClientRect()
      targetX = event.clientX - box.left
      targetY = event.clientY - box.top
      parallax.tx = (targetX / box.width - 0.5) * 2 * PARALLAX
      parallax.ty = (targetY / box.height - 0.5) * 2 * PARALLAX
    }

    const tick = () => {
      let pending = 0
      for (const b of blobs) {
        b.x += (targetX - b.x) * b.ease
        b.y += (targetY - b.y) * b.ease
        hero.style.setProperty(b.vx, `${b.x.toFixed(1)}px`)
        hero.style.setProperty(b.vy, `${b.y.toFixed(1)}px`)
        pending += Math.abs(targetX - b.x) + Math.abs(targetY - b.y)
      }
      parallax.x += (parallax.tx - parallax.x) * parallax.ease
      parallax.y += (parallax.ty - parallax.y) * parallax.ease
      hero.style.setProperty("--px", `${parallax.x.toFixed(2)}px`)
      hero.style.setProperty("--py", `${parallax.y.toFixed(2)}px`)
      pending += Math.abs(parallax.tx - parallax.x) + Math.abs(parallax.ty - parallax.y)
      frame = pending < 0.5 ? 0 : requestAnimationFrame(tick)
    }

    const wake = () => {
      if (!frame) frame = requestAnimationFrame(tick)
    }

    // Dónde está la palabra dentro del hero, para que sus máscaras compartan
    // el sistema de coordenadas de la linterna. Se mide al entrar el puntero
    // (layout ya asentado) y no en cada frame.
    const locate = () => {
      const box = hero.getBoundingClientRect()
      const word = human.getBoundingClientRect()
      human.style.setProperty("--wx", `${(word.left - box.left).toFixed(1)}px`)
      human.style.setProperty("--wy", `${(word.top - box.top).toFixed(1)}px`)
    }

    hero.addEventListener("pointerenter", (event) => {
      if (event.pointerType === "touch") return
      aim(event)
      locate()
      // Nace justo bajo el puntero, sin deslizarse desde la última posición.
      for (const b of blobs) {
        b.x = targetX
        b.y = targetY
      }
      hero.classList.add("is-lit")
      wake()
    })

    hero.addEventListener("pointermove", (event) => {
      if (event.pointerType === "touch") return
      aim(event)
      wake()
    })

    hero.addEventListener("pointerleave", () => {
      hero.classList.remove("is-lit")
    })
  }
</script>

<style>
  .hero {
    /*
      Linterna: caja (debe dar cabida a la estela), diámetro de cada mancha y
      posición de las cuatro (--tx… las escribe el script, en px del hero).
      Están aquí y no en .hero__sketch porque HUMAN también las consume.
    */
    --blob: url("/images/home/torch-blob.png");
    --torch-box: 64rem;
    --blob-1: 36rem;
    --blob-2: 28rem;
    --blob-3: 21rem;
    --blob-4: 15rem;
    --tx: 0px;
    --ty: 0px;
    --tx2: 0px;
    --ty2: 0px;
    --tx3: 0px;
    --ty3: 0px;
    --tx4: 0px;
    --ty4: 0px;
    /* Paralaje del dibujo respecto a la foto (lo escribe el script). */
    --px: 0px;
    --py: 0px;

    position: relative;
    display: flex;
    font-family: var(--font-bellota);
    align-items: center;
    min-height: min(88svh, 46rem);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -2;
  }

  .hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.28;
    transform: scale(1.06);
    animation: heroBgSettle 1.6s var(--ease-out) forwards;
  }

  /* Funde la foto con el fondo por arriba y por abajo, simétrico. */
  .hero__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      var(--page-accent-surface) 0%,
      rgb(var(--surface-rgb) / 0.45) 22%,
      rgb(var(--surface-rgb) / 0.35) 55%,
      var(--page-accent-surface) 100%
    );
  }

  /*
    Opaco del todo en el último tramo: un degradado lineal a secas solo llega
    al 100% en el último píxel y el borde se lee como un corte.
  */
  .hero__fade {
    position: absolute;
    inset: auto 0 0;
    height: 45%;
    z-index: 0;
    pointer-events: none;
    background: linear-gradient(
      to top,
      var(--page-accent-surface) 0%,
      var(--page-accent-surface) 14%,
      rgb(var(--surface-rgb) / 0.85) 38%,
      rgb(var(--surface-rgb) / 0.45) 66%,
      transparent 100%
    );
  }

  /* ── Bocetos + foco ────────────────────────────────────────────────────
    El dibujo (trazo blanco sobre transparente, WebP con alfa) se usa como
    máscara ALFA y el color lo pone el CSS. Antes era por luminancia, más
    ligera, pero Safari la ignora con imágenes raster y pintaba la capa
    entera. Dos capas con la misma máscara:
      · base   → oculta con puntero (en reposo no se ve nada); solo aparece,
                 tenue y fija, en táctil o con reduced-motion, donde no hay foco.
      · torch  → caja que sigue al puntero (translate en GPU) y dentro el
                 boceto a tamaño del hero desplazado a la inversa, de modo
                 que el dibujo queda clavado a la foto y solo se mueve la
                 "linterna".
    La forma de la linterna es LÍQUIDA: la máscara es una gota (círculo con
    degradado radial ≈50% → 0, arrugado por ruido) rasterizada EN BUILD a un
    PNG con alfa (scripts en el historial: sharp + SVG con feTurbulence). En
    runtime es un bitmap: un SVG con filtros como mask-image obligaba al
    navegador a re-rasterizarlo al mover el foco y calentaba la GPU. Se
    repite cuatro veces en posiciones que el script rezaga con inercias
    distintas (--tx2…--tx4): el movimiento líquido lo da la estela de gotas. Solo cambia la máscara de la caja
    (alfa, se recompone en GPU); el contenido neón no se repinta.
    El neón son dos tintas: un halo (máscara pre-desenfocada) y un núcleo claro.
  */
  .hero__sketch {
    --sketch: url("/images/home/bg-header-lineas-mask.webp");
    /* Mismo dibujo pre-desenfocado en build: el halo del neón sin filtros en runtime. */
    --sketch-glow: url("/images/home/bg-header-lineas-glow.webp");

    position: absolute;
    inset: 0;
    z-index: -1;
    container-type: size;
    pointer-events: none;
    /* Mismo asentamiento que la foto de fondo, para no desalinearse en la entrada. */
    transform: scale(1.06);
    animation: heroSketchSettle 1.6s var(--ease-out) forwards;
  }

  .hero__sketch-base,
  .hero__sketch-ink {
    position: absolute;
    inset: 0;
    mask-image: var(--sketch);
    mask-size: cover;
    mask-position: center;
    mask-repeat: no-repeat;
  }

  /* Con puntero no existe: el dibujo solo se revela bajo el foco. */
  .hero__sketch-base {
    display: none;
  }

  .hero__sketch-torch {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--torch-box);
    height: var(--torch-box);
    translate: calc(var(--tx) - var(--torch-box) / 2) calc(var(--ty) - var(--torch-box) / 2);
    scale: 0.6;
    opacity: 0;
    /* Apagado del todo en reposo (no se pinta ni compone); vuelve al entrar. */
    visibility: hidden;
    overflow: clip;
    contain: paint;
    /* Cuatro manchas líquidas: la principal centrada, las otras rezagadas (la estela). */
    mask-image: var(--blob), var(--blob), var(--blob), var(--blob);
    mask-repeat: no-repeat;
    mask-size:
      var(--blob-1) var(--blob-1),
      var(--blob-2) var(--blob-2),
      var(--blob-3) var(--blob-3),
      var(--blob-4) var(--blob-4);
    mask-position:
      center,
      calc(50% + (var(--tx2) - var(--tx))) calc(50% + (var(--ty2) - var(--ty))),
      calc(50% + (var(--tx3) - var(--tx))) calc(50% + (var(--ty3) - var(--ty))),
      calc(50% + (var(--tx4) - var(--tx))) calc(50% + (var(--ty4) - var(--ty)));
    transition:
      opacity 480ms ease,
      scale 640ms var(--ease-out),
      visibility 0s linear 480ms;
    will-change: translate, opacity;
  }

  .hero.is-lit .hero__sketch-torch {
    opacity: 1;
    scale: 1;
    visibility: visible;
    transition-delay: 0s;
  }

  /* Luz cálida de la linterna sobre la propia foto. */
  .hero__sketch-torch::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(circle calc(var(--blob-1) / 2) at center, rgb(var(--accent-rgb) / 0.14), transparent 100%);
  }

  /* Tamaño del hero (unidades de contenedor) y traslación inversa al foco. */
  .hero__sketch-lit {
    position: absolute;
    top: 0;
    left: 0;
    width: 100cqw;
    height: 100cqh;
    /* Translúcido: se lee como dibujado encima de la foto, sin imponerse. */
    opacity: 0.7;
    translate: calc(var(--torch-box) / 2 - var(--tx) + var(--px)) calc(var(--torch-box) / 2 - var(--ty) + var(--py));
    will-change: translate;
  }

  /*
    Halo: tinta naranja enmascarada con la versión PRE-desenfocada del dibujo
    (generada en build). Sin `filter` ni `mix-blend-mode` en runtime: eso
    obligaba a la GPU a recalcular un desenfoque de pantalla completa en cada
    frame. Ahora es una máscara estática más.
  */
  .hero__sketch-glow {
    position: absolute;
    inset: 0;
    opacity: 0.9;
  }

  .hero__sketch-glow .hero__sketch-ink {
    mask-image: var(--sketch-glow);
    background: var(--page-accent);
  }

  /* Núcleo del tubo: más claro que el halo, como un neón real. */
  .hero__sketch-ink--core {
    background: #ffb59e;
  }

  @keyframes heroSketchSettle {
    to {
      transform: scale(1);
    }
  }

  /* Sin puntero o sin movimiento: nada de foco; el boceto queda tenue y fijo. */
  @media (hover: none), (prefers-reduced-motion: reduce) {
    .hero__sketch-torch {
      display: none;
    }

    .hero__sketch-base {
      display: block;
      background: rgba(255, 255, 255, 0.1);
    }

    .hero__sketch {
      animation: none;
      transform: none;
    }
  }

  /*
    Se estira a toda la altura del hero para que los rieles lleguen de tope
    a tope; el contenido se centra dentro.
  */
  .hero__inner {
    border-inline-color: transparent; /* mismo ancho útil que el resto, sin línea */
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(4rem, 12vh, 8rem);
  }

  .hero__eyebrow {
    margin: 0 0 1.25rem;
    font-size: 0.65rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgb(var(--text-rgb) / 0.5);
    animation: heroRise 0.7s var(--ease-out) both;
  }

  .hero__title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.1em;
    margin: 0;
    font-weight: 400;
    line-height: 0.94;
  }

  .hero__line {
    display: block;
    animation: heroRise 0.9s var(--ease-out) both;
  }

  .hero__line--creative {
    font-size: clamp(2.4rem, 7vw, 4.6rem);
    font-weight: 300;
    color: rgba(255, 255, 255, 0.92);
    animation-delay: 0.08s;
  }

  .hero__line--human {
    font-size: clamp(3.6rem, 12vw, 8rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #fff;
    animation-delay: 0.16s;
  }

  /*
    "AI" en HUMAN, revelado por la misma linterna que ilumina los bocetos.
    Dos capas idénticas: la base lleva las manchas como máscara INVERTIDA
    (agujero bajo la luz) y la capa "AI" las lleva en positivo, así que solo
    existe dentro del haz. Bajo la luz H, U y M se atenúan, la A sigue y la I
    se posa sobre el primer trazo de la N. Las manchas usan las mismas
    variables que la linterna, trasladadas al origen de la palabra (--wx/--wy,
    las mide el script). --torch-scale crece de 0 a 1 al entrar el puntero:
    el agujero nace bajo el cursor, como el propio foco.
  */
  @property --torch-scale {
    syntax: "<number>";
    inherits: true;
    initial-value: 0;
  }

  /* Ya no es texto sino un componente: puntero normal, sin selección. */
  .hero__line--human {
    /* Cuánto se atenúan las letras apagadas: HUMAN debe seguir leyéndose. */
    --hero-dim: 0.3;
    /*
      La luz sobre la palabra es más ancha que la de los bocetos: las manchas
      tienen el borde muy suave y a tamaño real solo "morderían" ~150px.
    */
    --word-light: 1.75;
    --wx: 0px;
    --wy: 0px;
    --torch-scale: 0;

    position: relative;
    cursor: default;
    user-select: none;
    transition: --torch-scale 480ms ease;
  }

  .hero.is-lit .hero__line--human {
    --torch-scale: 1;
  }

  .hero__human {
    display: block;
  }

  .hero__human--ai {
    position: absolute;
    inset: 0;
    display: none;
  }

  .hero__letter,
  .hero__glyph {
    display: inline-block;
  }

  .hero__letter--swap {
    position: relative;
  }

  /* Capa "AI": H, U, M apagadas; la N cede su sitio a la I, alineada a su primer trazo. */
  .hero__human--ai .hero__letter {
    opacity: var(--hero-dim);
  }

  .hero__human--ai .hero__letter--keep,
  .hero__human--ai .hero__letter--swap {
    opacity: 1;
  }

  .hero__human--ai .hero__glyph {
    opacity: 0;
  }

  .hero__human--ai .hero__letter--swap::before {
    content: attr(data-alt);
    position: absolute;
    inset: 0;
    text-align: left;
    color: #fff;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .hero__human--ai {
      display: block;
    }

    /* Las cuatro manchas, escaladas por --torch-scale y centradas en cada foco. */
    .hero__human--base,
    .hero__human--ai {
      --b1: calc(var(--blob-1) * var(--word-light) * var(--torch-scale));
      --b2: calc(var(--blob-2) * var(--word-light) * var(--torch-scale));
      --b3: calc(var(--blob-3) * var(--word-light) * var(--torch-scale));
      --b4: calc(var(--blob-4) * var(--word-light) * var(--torch-scale));
      --p1: calc(var(--tx) - var(--wx) - var(--b1) / 2) calc(var(--ty) - var(--wy) - var(--b1) / 2);
      --p2: calc(var(--tx2) - var(--wx) - var(--b2) / 2) calc(var(--ty2) - var(--wy) - var(--b2) / 2);
      --p3: calc(var(--tx3) - var(--wx) - var(--b3) / 2) calc(var(--ty3) - var(--wy) - var(--b3) / 2);
      --p4: calc(var(--tx4) - var(--wx) - var(--b4) / 2) calc(var(--ty4) - var(--wy) - var(--b4) / 2);

      mask-repeat: no-repeat;
      will-change: mask-position;
    }

    .hero__human--ai {
      mask-image: var(--blob), var(--blob), var(--blob), var(--blob);
      mask-size:
        var(--b1) var(--b1),
        var(--b2) var(--b2),
        var(--b3) var(--b3),
        var(--b4) var(--b4);
      mask-position: var(--p1), var(--p2), var(--p3), var(--p4);
    }

