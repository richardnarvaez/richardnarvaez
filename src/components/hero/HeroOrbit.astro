          <span
            data-title-piece
            class="text-[4.1rem] leading-none text-[#FF512F] sm:text-[4.6rem] md:text-[3.4rem]"
            style="opacity: 0"
          >
            -
          </span>
        </div>
      </div>
    </div>

    <!--
      Sin aria-hidden estático: GSAP gestiona autoAlpha (visibility), que ya
      retira la escena del árbol de accesibilidad mientras está oculta. Un
      aria-hidden fijo dejaría los botones interactivos invisibles para AT
      incluso cuando la escena es visible.
    -->
