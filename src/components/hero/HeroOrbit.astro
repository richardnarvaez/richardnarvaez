                  stroke="white"
                  stroke-opacity="0.04"></path>
                <path
                  d="M244.5 730.5C226 660 231.5 630.338 272.353 625.726C313.206 621.113 338.5 624 344 581C349.501 538.001 373 490 383.001 475.501"
                  stroke="url(#paint0_linear_hero)"
                  stroke-opacity="0.32"></path>
                <path
                  d="M865.677 312.15C923.684 356.815 937.421 383.742 907.43 412.424C877.44 441.106 855.357 454.303 877.256 491.823C899.155 529.344 909.658 581.859 910.5 599.5"
                  stroke="url(#paint1_linear_hero)"
                  stroke-opacity="0.32"></path>
                <path
                  d="M1069 867.999C1036.5 928.295 1011.43 946.924 980.663 928.294C949.9 909.664 927.324 887.958 894 915.5C860.677 943.041 826.238 970.579 809.501 975.5"
                  stroke="url(#paint2_linear_hero)"
                  stroke-opacity="0.32"></path>
                <path
                  d="M475.949 142.65C541.625 123.198 572.513 127.85 580.985 162.803C589.457 197.756 585.975 225.279 629 229.5C672.025 233.721 721.712 238.597 737.001 247"
                  stroke="url(#paint3_linear_hero)"
                  stroke-opacity="0.32"></path>
                <defs>
                  <linearGradient
                    id="paint0_linear_hero"
                    x1="308"
                    y1="553"
                    x2="255.414"
                    y2="714.876"
                    gradientUnits="userSpaceOnUse"
                  >
                    <stop stop-color="white" stop-opacity="0"></stop>
                    <stop offset="0.5" stop-color="white" stop-opacity="1"
                    ></stop>
                    <stop offset="1" stop-color="white" stop-opacity="0"></stop>
                  </linearGradient>
                  <linearGradient
                    id="paint1_linear_hero"
                    x1="923.309"
                    y1="492.016"
                    x2="866.452"
                    y2="331.251"
                    gradientUnits="userSpaceOnUse"
                  >
                    <stop stop-color="white" stop-opacity="0"></stop>
                    <stop offset="0.5" stop-color="white" stop-opacity="1"
                    ></stop>
                    <stop offset="1" stop-color="white" stop-opacity="0"></stop>
                  </linearGradient>
                  <linearGradient
                    id="paint2_linear_hero"
                    x1="906.513"
                    y1="960.753"
                    x2="1053.49"
                    y2="874.153"
                    gradientUnits="userSpaceOnUse"
                  >
                    <stop stop-color="white" stop-opacity="0"></stop>
                    <stop offset="0.5" stop-color="white" stop-opacity="1"
                    ></stop>
                    <stop offset="1" stop-color="white" stop-opacity="0"></stop>
                  </linearGradient>
                  <linearGradient
                    id="paint3_linear_hero"
                    x1="656.279"
                    y1="192.517"
                    x2="491.251"
                    y2="149.317"
                    gradientUnits="userSpaceOnUse"
                  >
                    <stop stop-color="white" stop-opacity="0"></stop>
                    <stop offset="0.5" stop-color="white" stop-opacity="1"
                    ></stop>
                    <stop offset="1" stop-color="white" stop-opacity="0"></stop>
                  </linearGradient>
                </defs>
              </svg>
            </div>
          </div>

          {
            heroOrbitOriginNodes.map((node, nodeIndex) => {
              const brandCycleMotion = getStableBrandCycleMotion(node.key, nodeIndex);

              return (
                <div
                  data-orbit-origin-node
                  class="hero-orbit-node"
                  style={`left:${node.origin.left}%;top:${node.origin.top}%;`}
                >
                  <div class="hero-orbit-node__inner">
                    {node.originNode.kind === "icon" && node.originNode.assets[0] && (
                      <div class="icon-bubble">
                        {node.originNode.assets[0].src === "/images/vercel.svg" ? (
                          <span class="vercel-mark-bubble">
                            <VercelColorIcon
                              width="14"
                              height="14"
                              class="size-3.5"
                              aria-hidden="true"
                            />
                          </span>
                        ) : (
                          <img
                            src={node.originNode.assets[0].src}
                            alt={node.originNode.assets[0].alt}
                            class={
                              node.originNode.assets[0].className ??
                              "size-6 object-contain"
                            }
                          />
                        )}
                      </div>
                    )}

                    {node.originNode.kind === "cover" && node.originNode.assets[0] && (
                      <div class="cover-logo-bubble">
                        <img
                          src={node.originNode.assets[0].src}
                          alt={node.originNode.assets[0].alt}
                          class="size-full object-cover"
                        />
                      </div>
                    )}

                    {(node.originNode.kind === "brand-cycle" ||
                      node.originNode.kind === "brand-cycle-wide") &&
                      node.originNode.assets.length > 0 && (
                        <div
                          class:list={[
                            "brand-cycle-bubble",
                            node.originNode.kind === "brand-cycle-wide" &&
                              "brand-cycle-bubble--wide",
                          ]}
                          data-brand-cycle-bubble
                          data-brand-cycle-dwell={String(brandCycleMotion.dwellMs)}
                          data-brand-cycle-initial-delay={String(
                            brandCycleMotion.initialDelayMs,
                          )}
                          data-brand-cycle-transition-ms={String(
                            brandCycleMotion.transitionMs,
                          )}
                          style={brandCycleMotion.bubbleStyle}
                        >
                          {node.originNode.assets.map((asset, assetIndex) => (
                            <span
                              class="brand-cycle-item"
                              data-brand-cycle-item
                              data-brand-cycle-active={assetIndex === 0
                                ? "true"
                                : "false"}
                            >
                              <img
                                src={asset.src}
                                alt={asset.alt}
                                class={asset.className ?? "size-6 object-contain"}
                              />
                            </span>
                          ))}
                        </div>
                      )}
                  </div>
                </div>
              );
            })
          }

          {
            heroOrbitProfileNodes.map((node) => (
              <div
                data-orbit-profile-node
                class="hero-orbit-node"
                data-profile-angle={node.profilePlacement.angle}
                data-profile-radius-desktop={node.profilePlacement.radiusDesktop}
                data-profile-radius-mobile={node.profilePlacement.radiusMobile}
                data-profile-scale-desktop={node.profilePlacement.scaleDesktop ?? 1}
                data-profile-scale-mobile={node.profilePlacement.scaleMobile ?? node.profilePlacement.scaleDesktop ?? 1}
                data-interest-key={node.key}
                data-interest-label={node.clusterNode.label}
                style="left:50%;top:50%;"
              >
                <div class="hero-orbit-node__inner">
                  <button
                    type="button"
                    class="interest-bubble"
                    data-interest-trigger
                    aria-label={node.clusterNode.label}
                    title={node.clusterNode.label}
                  >
                    <span
                      class="interest-bubble__icon"
                      set:html={node.clusterNode.iconSvg}
                    />
                  </button>
                  </div>
              </div>
            ))
          }

          <div data-orbit-cluster-layer class="hero-cluster-layer">
            <div data-orbit-cluster class="hero-cluster-shell">
              <div data-orbit-avatar class="hero-cluster-avatar">
                <div
                  data-orbit-avatar-surface
                  class="hero-cluster-avatar__surface"
                >
                  <img
                    src="/images/avatars/richard.jpg"
                    alt="Richard Narvaez"
                    class="size-full object-cover"
                  />
                </div>
              </div>
              <div data-orbit-meta class="hero-cluster-meta">
                <p class="hero-cluster-meta__name">{siteName}</p>
                <p class="hero-cluster-meta__role mt-6">{siteRole}</p>
              </div>
            </div>
          </div>

          <div
            data-orbit-passport-layer
            data-passport-reserved
            class="hero-passport-layer"
            aria-hidden="true"
          >
            <div data-orbit-passport-globe class="hero-passport-globe-shell">
              <div
                data-passport-globe-frame
                class="hero-passport-globe-frame"
                data-passport-center-lng={String(globeCenter[0])}
                data-passport-center-lat={String(globeCenter[1])}
              >
                <canvas
                  data-passport-globe-canvas
                  class="hero-passport-globe-canvas"
                ></canvas>
                <div class="hero-passport-markers">
                  {
                    passportPlaces.map((place) => {
                      const gradient = getPlaceGradient(place);

                      return (
                        <button
                          type="button"
                          class="hero-passport-marker"
                          data-passport-marker
                          data-place-id={place.id}
                          data-lng={String(place.coordinates[0])}
                          data-lat={String(place.coordinates[1])}
                          data-place-name={place.name}
                          data-place-country={place.country}
                          data-place-code={place.code}
                          title={place.name}
                          aria-label={`${place.name}, ${place.country}`}
                          style={`--marker-start:${gradient.start};--marker-end:${gradient.end};`}
                        ></button>
                      );
                    })
                  }
                </div>
              </div>

              <div class="hero-passport-toolbar">
                {
                  passportCountries.map((country, index) => (
