---
import BaseLayout from "../layouts/BaseLayout.astro"
---

<BaseLayout title="Page not found | Richard Vinueza">
  <main class="flex min-h-screen flex-col items-center justify-center gap-6 px-6 text-center">
    <p
      class="font-jetbrains text-xs font-semibold uppercase tracking-[0.2em] text-neutral-400"
    >
      404
    </p>
    <h1
      class="font-display text-4xl font-bold text-white sm:text-5xl"
    >
      Page not found
    </h1>
    <a
      href="/"
      class="btn btn--ghost"
    >
      Back home
    </a>
  </main>
</BaseLayout>
