---
import BaseLayout from "../layouts/BaseLayout.astro"
import HeroIntro from "../components/hero/HeroIntro.astro"
import SectionProfile from "../components/sections/SectionProfile.astro"
import SectionBento from "../components/SectionBento.astro"
import SectionProjects from "../components/sections/SectionProjects.astro"
import SectionScenery from "../components/sections/SectionScenery.astro"
import SectionFrameworks from "../components/sections/SectionFrameworks.astro"
import SectionOpenSource from "../components/sections/SectionOpenSource.astro"
import SiteFooter from "../components/footer/SiteFooter.astro"
import { siteName } from "../site.config"
---

<BaseLayout title={`${siteName} | Product Engineer`}>
  <HeroIntro />
  <SectionProfile />
  <SectionBento />
  <SectionProjects />

  {/* A sangre: aquí se corta el marco de plano. */}
  <SectionScenery />

  <SectionFrameworks />
  <SectionOpenSource />
  <SiteFooter />
</BaseLayout>
