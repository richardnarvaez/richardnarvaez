---
import BaseLayout from "../layouts/BaseLayout.astro"
import HeroIntro from "../components/hero/HeroIntro.astro"
import SectionProfile from "../components/sections/SectionProfile.astro"
import SectionBento from "../components/SectionBento.astro"
import SectionWork from "../components/sections/SectionWork.astro"
import SectionLab from "../components/sections/SectionLab.astro"
import SectionScenery from "../components/sections/SectionScenery.astro"
import SectionOpenSource from "../components/sections/SectionOpenSource.astro"
import SectionGallery from "../components/sections/SectionGallery.astro"
import SiteFooter from "../components/footer/SiteFooter.astro"
import StickyName from "../components/header/StickyName.astro"
import { siteName } from "../site.config"
---

<BaseLayout title={`${siteName} | Product Engineer`}>
  <a class="skip-link" href="#content">Skip to content</a>

  {/* Sticky; lights up when the profile name leaves the viewport. */}
  <StickyName />

  <main id="content">
    <HeroIntro />
    <SectionProfile />
    <SectionBento />
    <SectionWork />
    <SectionLab />
    <SectionOpenSource />

    {/* The train is the hinge: it closes the work and opens what is not software. */}
    <SectionScenery />
    <SectionGallery />
  </main>

  <SiteFooter />
</BaseLayout>
